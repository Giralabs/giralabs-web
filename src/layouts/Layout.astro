---
import { getSwitchLanguagePath, hasEnglishAlternate } from '../lib/paths';
import { absoluteUrl, canonicalPath } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
	lang?: string;
}

const {
	title = "Giralabs — Estudio de Apps Móviles",
	description = "Giralabs es un estudio especializado en desarrollo de apps móviles, digitalización de empresas y experiencias digitales premium.",
	lang = "es"
} = Astro.props;

// Dynamically compute canonical and hreflang URLs without query parameters
const pathname = Astro.url.pathname;
const esUrlPath = getSwitchLanguagePath(pathname, 'es');
const enUrlPath = getSwitchLanguagePath(pathname, 'en');

const showEnglishAlternate = hasEnglishAlternate(pathname);

const canonicalUrl = absoluteUrl(canonicalPath(pathname));
const esHref = absoluteUrl(canonicalPath(esUrlPath));
const enHref = absoluteUrl(canonicalPath(enUrlPath));
const xDefaultHref = esHref;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- The site is light-only: tell the UA so form controls and scrollbars
		     never render dark on a dark-mode OS, and tint the mobile browser chrome
		     to match the page instead of flashing white around it. -->
		<meta name="color-scheme" content="light" />
		<meta name="theme-color" content="#F0EFEA" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- Both languages are indexable. The hreflang block below is what keeps a
		     Spanish searcher on the Spanish URL and an English one on /en/ -->
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalUrl} />
		
		<!-- Alternate hreflang configurations for multilingual search indexing.
		     The English link is omitted when no translation exists: pointing it at a
		     404 invalidates the whole annotation for the page. -->
		<link rel="alternate" hreflang="es" href={esHref} />
		{showEnglishAlternate && <link rel="alternate" hreflang="en" href={enHref} />}
		<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

		<!-- Open Graph / Facebook -->
		<!-- PNG, not AVIF: most social and search crawlers still cannot decode AVIF,
		     which left every shared link without a preview image -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="Giralabs" />
		<meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'es_ES'} />
		<meta property="og:image" content="https://www.giralabs.es/og-image.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content="Giralabs" />

		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://www.giralabs.es/og-image.png" />
		<meta name="twitter:image:alt" content="Giralabs" />

		<!-- Outfit is the fallback for locally installed Gilroy, which almost no
		     visitor has, so in practice it is the font that renders. Self-hosted as a
		     single variable woff2 covering 100-900: one same-origin request instead of
		     two cross-origin handshakes plus seven static weight files. -->
		<link rel="preload" as="font" type="font/woff2" href="/fonts/outfit-latin.woff2" crossorigin>
		<!-- JSON-LD Schema Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "ProfessionalService",
					"@id": "https://www.giralabs.es/#organization",
					"name": "Giralabs",
					"alternateName": ["Giralab", "Girlabs"],
					"url": "https://www.giralabs.es",
					"logo": "https://www.giralabs.es/logo.png",
					"image": "https://www.giralabs.es/og-image.png",
					"description": lang === 'en'
						? "Custom software and mobile app development company. We design and build native applications, high-performance websites, and premium digital solutions."
						: "Empresa de desarrollo de software a medida y creación de aplicaciones móviles. Diseñamos y desarrollamos apps nativas, páginas web y sistemas digitales premium.",
					"address": {
						"@type": "PostalAddress",
						"addressLocality": "Sevilla",
						"addressRegion": "Andalucía",
						"addressCountry": "ES"
					},
					"telephone": "+34 601 80 21 22",
					"email": "soporte@giralabs.es",
					"areaServed": [
						{ "@type": "City", "name": "Sevilla" },
						{ "@type": "AdministrativeArea", "name": "Andalucía" },
						{ "@type": "Country", "name": "España" }
					],
					"priceRange": "$$$",
					"sameAs": [
						"https://github.com/giralabs",
						"https://linkedin.com/company/giralabs"
					]
				},
				{
					"@type": "WebSite",
					"@id": "https://www.giralabs.es/#website",
					"url": "https://www.giralabs.es",
					"name": "Giralabs",
					"publisher": {
						"@id": "https://www.giralabs.es/#organization"
					}
				}
			]
		})} />
		<!-- Inline script: sets navbar state before first paint to avoid flash on mid-scroll reload -->
		<script is:inline>
			if (window.scrollY > 80) {
				document.documentElement.setAttribute('data-scrolled', '');
			}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">{lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
		<slot />
		<script>
			import { idleOffscreenAnimations } from '../lib/idle-offscreen';
			import { liquidGlassLight } from '../lib/liquid-glass';

			// Every page has its own <main>, but only some carry an id. The skip link
			// needs one target on all of them, and it must take focus so the next Tab
			// continues from the content rather than from the top of the page.
			function wireSkipTarget() {
				const main = document.getElementById('main-content') ?? document.querySelector('main');
				if (!main) return;
				if (!main.id) main.id = 'main-content';
				if (!main.hasAttribute('tabindex')) main.setAttribute('tabindex', '-1');
			}

			wireSkipTarget();
			idleOffscreenAnimations();
			liquidGlassLight();
			document.addEventListener('astro:page-load', () => {
				wireSkipTarget();
				idleOffscreenAnimations();
			});
		</script>
	</body>
</html>

<style is:global>
	/* Self-hosted Outfit variable font. `font-weight: 100 900` means a single file
	   serves every weight the site uses (300-900), and unicode-range keeps the
	   latin-ext file from downloading unless a page actually needs those glyphs. */
	@font-face {
		font-family: 'Outfit';
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
		src: url('/fonts/outfit-latin.woff2') format('woff2');
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
	}
	@font-face {
		font-family: 'Outfit';
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
		src: url('/fonts/outfit-latin-ext.woff2') format('woff2');
		unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
	}

	/* Register Gilroy font if installed locally, and fallback to Outfit */
	@font-face {
		font-family: 'Gilroy';
		src: local('Gilroy-ExtraBold'), local('Gilroy ExtraBold'), local('Gilroy-Bold'), local('Gilroy Bold'), local('Gilroy-Heavy'), local('Gilroy Heavy'), local('Gilroy-Black'), local('Gilroy Black');
		font-weight: 800;
		font-style: normal;
	}
	@font-face {
		font-family: 'Gilroy';
		src: local('Gilroy-Heavy'), local('Gilroy Heavy'), local('Gilroy-Black'), local('Gilroy Black'), local('Gilroy-ExtraBold'), local('Gilroy ExtraBold');
		font-weight: 900;
		font-style: normal;
	}
	@font-face {
		font-family: 'Gilroy';
		src: local('Gilroy-SemiBold'), local('Gilroy SemiBold'), local('Gilroy-Medium'), local('Gilroy Medium');
		font-weight: 600;
		font-style: normal;
	}
	@font-face {
		font-family: 'Gilroy';
		src: local('Gilroy-Regular'), local('Gilroy Regular'), local('Gilroy-Medium'), local('Gilroy Medium');
		font-weight: 400;
		font-style: normal;
	}

	*, *::before, *::after {
		box-sizing: border-box;
	}

	/* =============================================
	   DESIGN TOKENS
	   Monochrome palette on the warm paper background. The muted greys are
	   picked to clear WCAG AA (4.5:1) against #F0EFEA — the old #777/#888/#bbb
	   text sat between 1.7:1 and 3.9:1.
	============================================= */
	:root {
		--paper: #F0EFEA;
		--ink: #000;
		--ink-2: #2b2b2b;
		--ink-muted: #565656;   /* 6.3:1 on paper */
		--ink-subtle: #6a6a6a;  /* 4.7:1 on paper */
		--hairline: rgba(0, 0, 0, 0.08);

		--ease-out: cubic-bezier(0.25, 1, 0.5, 1);
		--ease-spring: cubic-bezier(0.34, 1.45, 0.64, 1);

		--focus-ring: 0 0 0 2px var(--paper), 0 0 0 4px var(--ink);

		/* Liquid Glass material (light) */
		--lg-tint-top: rgba(255, 255, 255, 0.58);
		--lg-tint-bottom: rgba(255, 255, 255, 0.26);
		--lg-blur: 22px;
		--lg-saturate: 190%;
		--lg-rim: rgba(255, 255, 255, 0.95);
		--lg-shadow:
			0 1px 2px rgba(0, 0, 0, 0.05),
			0 8px 20px -6px rgba(0, 0, 0, 0.12),
			0 24px 48px -16px rgba(0, 0, 0, 0.18);
		/* Glass thickness: a bright top bevel, a darker lower lip, a bounce
		   light along the bottom and an inner glow — together they read as a
		   rounded slab of glass bending the light at its edge */
		--lg-bevel:
			inset 0 1.5px 0.5px rgba(255, 255, 255, 1),
			inset 0 -1.5px 1px rgba(0, 0, 0, 0.06),
			inset 0 -6px 10px -6px rgba(255, 255, 255, 0.7),
			inset 2px 2px 2px -1px rgba(255, 255, 255, 0.85),
			inset -2px -2px 2px -1px rgba(255, 255, 255, 0.5),
			inset 0 0 24px rgba(255, 255, 255, 0.35),
			inset 0 0 0 0.5px rgba(0, 0, 0, 0.07);
	}

	/* =============================================
	   LIQUID GLASS
	   One reusable material for every floating surface: tinted, blurred and
	   over-saturated backdrop; a specular rim that is brightest on the lit
	   corners; a bevel that gives the pane thickness; and a soft highlight that
	   follows the pointer (driven by lib/liquid-glass.ts through --lg-x/--lg-y).
	   Both pseudo-elements sit at z-index -1 inside an isolated stacking context,
	   so they paint above the pane's own background but under its content.
	   Components that already use ::before/::after must not take this class.
	============================================= */
	/* Registered so the pointer light can fade in and out instead of popping */
	@property --lg-light {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	.lg {
		transition: --lg-light 0.35s ease;
		position: relative;
		isolation: isolate;
		background: linear-gradient(180deg, var(--lg-tint-top), var(--lg-tint-bottom));
		-webkit-backdrop-filter: blur(var(--lg-blur)) saturate(var(--lg-saturate)) brightness(1.03);
		backdrop-filter: blur(var(--lg-blur)) saturate(var(--lg-saturate)) brightness(1.03);
		box-shadow: var(--lg-bevel), var(--lg-shadow);
		border: none;
	}

	/* Refraction rim: a 1.5px ring cut out with a mask. White specular on the
	   lit corners, plus a faint prismatic split along the edges — the same
	   iridescence as the glass capsule in the Giralabs mark. */
	.lg::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		padding: 1.5px;
		background:
			linear-gradient(
				135deg,
				var(--lg-rim) 0%,
				rgba(255, 255, 255, 0.35) 22%,
				rgba(255, 255, 255, 0) 48%,
				rgba(255, 255, 255, 0.4) 76%,
				rgba(255, 255, 255, 0.95) 100%
			),
			conic-gradient(
				from 200deg,
				rgba(255, 170, 200, 0.55),
				rgba(170, 210, 255, 0.55),
				rgba(180, 255, 220, 0.5),
				rgba(255, 235, 170, 0.55),
				rgba(255, 170, 200, 0.55)
			);
		-webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
		pointer-events: none;
	}

	/* Gloss + pointer light. The upper sheen is always there (the curved top
	   of the pane catching the light); the radial spot follows the pointer and
	   fades in through --lg-light. */
	.lg::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		background:
			radial-gradient(
				var(--lg-light-size, 180px) circle at var(--lg-x, 50%) var(--lg-y, -20%),
				rgba(255, 255, 255, calc(0.75 * var(--lg-light, 0))),
				rgba(255, 255, 255, 0) 70%
			),
			linear-gradient(
				180deg,
				rgba(255, 255, 255, 0.55) 0%,
				rgba(255, 255, 255, 0.12) 38%,
				rgba(255, 255, 255, 0) 52%
			);
		pointer-events: none;
	}

	/* Interactive glass squishes under the finger like the iOS controls do */
	.lg-press {
		transition: transform 0.45s var(--ease-spring), box-shadow 0.3s ease, background 0.3s ease;
	}
	.lg-press:active {
		transform: scale(0.965);
		transition-duration: 0.12s;
	}

	/* Accessibility settings: no translucency, or more contrast */
	@media (prefers-reduced-transparency: reduce) {
		.lg {
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
			background: #FAFAF7;
		}
		.lg::after { display: none; }
	}
	@media (prefers-contrast: more) {
		.lg {
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
			background: #fff;
			box-shadow: inset 0 0 0 1.5px #000;
		}
		.lg::before,
		.lg::after { display: none; }
	}
	@media (forced-colors: active) {
		.lg { border: 1px solid CanvasText; }
	}

	/* =============================================
	   FOCUS + SKIP LINK
	   Several components removed the outline with nothing in its place, which
	   left keyboard users with no idea where they were. One visible ring for
	   keyboard focus only; mouse clicks don't show it.
	============================================= */
	:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
	}
	button:focus-visible,
	a:focus-visible,
	[role="button"]:focus-visible,
	summary:focus-visible {
		outline: 2px solid var(--ink) !important;
		outline-offset: 3px;
	}
	main:focus,
	main:focus-visible {
		outline: none;
	}

	.skip-link {
		position: fixed;
		top: 12px;
		left: 12px;
		z-index: 10000;
		padding: 0.7rem 1.2rem;
		border-radius: 100px;
		background: var(--ink);
		color: var(--paper);
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		transform: translateY(-150%);
		transition: transform 0.3s var(--ease-out);
	}
	.skip-link:focus,
	.skip-link:focus-visible {
		transform: translateY(0);
	}

	.sr-only {
		position: absolute !important;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	::selection {
		background: #000;
		color: var(--paper);
	}

	html {
		scroll-behavior: smooth;
		overflow-x: clip;
		/* Anchor jumps land below the fixed navbar instead of under it */
		scroll-padding-top: 88px;
		-webkit-text-size-adjust: 100%;
		text-size-adjust: 100%;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		background-color: #F0EFEA;
		color: #000000;
		font-family: 'Gilroy', 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		overflow-x: clip;
	}

	/* The home page paints two fixed ambient glows. Being position:fixed they
	   were re-rasterised on every scroll frame. Promoting them to their own
	   compositor layer rasterises each once and lets scrolling be a pure GPU
	   transform. */
	.ambient-top,
	.ambient-bottom {
		will-change: transform;
	}

	/* Sections that are off screen stop animating. Several loops here animate
	   properties that cannot be composited (background-position, border-color,
	   color, stroke-dashoffset), so they re-run style — and sometimes layout —
	   every frame for as long as they are alive, whether or not anyone can see
	   them. Only animations are paused; transitions, and therefore the scroll
	   reveal, are unaffected. */
	.anim-idle,
	.anim-idle *,
	.anim-idle *::before,
	.anim-idle *::after {
		animation-play-state: paused !important;
	}

	/* Honour the OS "reduce motion" setting: keep the layout and the final state
	   of every effect, drop the movement. */
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}

	/* Scroll reveal utility */
	.reveal {
		opacity: 0;
		transform: translateY(28px);
		transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1), transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
	}

	.reveal.visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Stagger children */
	.reveal-stagger > * {
		opacity: 0;
		transform: translateY(28px);
		transition: opacity 0.7s cubic-bezier(0.25, 1, 0.5, 1), transform 0.7s cubic-bezier(0.25, 1, 0.5, 1);
	}

	/* Every child becomes visible. Previously the reveal was bundled into the
	   per-child delay rules, which only went up to six, so any grid with more
	   items than that left the rest permanently at opacity 0. */
	.reveal-stagger.visible > * {
		opacity: 1;
		transform: translateY(0);
	}

	/* The delay is what staggers, and it only needs to cover the first screenful */
	.reveal-stagger.visible > *:nth-child(1) { transition-delay: 0s; }
	.reveal-stagger.visible > *:nth-child(2) { transition-delay: 0.1s; }
	.reveal-stagger.visible > *:nth-child(3) { transition-delay: 0.2s; }
	.reveal-stagger.visible > *:nth-child(4) { transition-delay: 0.3s; }
	.reveal-stagger.visible > *:nth-child(5) { transition-delay: 0.4s; }
	.reveal-stagger.visible > *:nth-child(6) { transition-delay: 0.5s; }
	.reveal-stagger.visible > *:nth-child(n + 7) { transition-delay: 0.6s; }
</style>