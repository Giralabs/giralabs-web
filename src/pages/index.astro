---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/home/Hero.astro';
import PhoneMockup from '../components/home/PhoneMockup.astro';
import Services from '../components/home/Services.astro';
import Edge from '../components/home/Edge.astro';
import NativeSpeed from '../components/home/NativeSpeed.astro';
import Faq from '../components/home/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import BipsyAnnounce from '../components/bipsy/BipsyAnnounce.astro';
import { translations } from '../i18n/translations';

export const prerender = true;
const lang = 'es';
const T = translations[lang];
---

<Layout
  title={T.meta_title}
  description={T.meta_description}
  lang={lang}
>
  <div class="ambient-top" aria-hidden="true"></div>
  <div class="ambient-bottom" aria-hidden="true"></div>

  <!-- ==================== NAVBAR (component) ==================== -->
  <Navbar lang={lang} />

  <!-- ==================== HOME SECTIONS (components) ==================== -->
  <main id="main-content" tabindex="-1">
  <Hero lang={lang} />
  <PhoneMockup lang={lang} />
  <Services lang={lang} />
  <Edge lang={lang} />
  <NativeSpeed lang={lang} />
  <Contact 
    lang={lang} 
    actionUrl="https://formspree.io/f/xvznwgob" 
    bookingActionUrl="https://formspree.io/f/xvznwgob" 
  />
  <Faq lang={lang} />
  </main>
  <Footer lang={lang} />

  <!-- ==================== BIPSY IN-DEVELOPMENT NOTICE ==================== -->
  <BipsyAnnounce lang={lang} />

</Layout>

<!-- ==================== INTERACTIONS ==================== -->
<script>
  // ---- Scroll reveal (general) ----
  const revealEls = document.querySelectorAll('.reveal, .reveal-stagger');
  // A ratio threshold measures a share of the target's own height, and these
  // reveal targets are whole sections that are often taller than the viewport,
  // so the share could never be met and the section stayed invisible. The
  // negative bottom rootMargin is what delays the reveal until it is properly
  // in view.
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, { threshold: 0, rootMargin: '0px 0px -40px 0px' });
  revealEls.forEach(el => observer.observe(el));
</script>

<style>
  /* ========================================
     GLOBAL
  ======================================== */

  .ambient-top {
    position: fixed;
    top: -200px;
    right: -200px;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(255, 210, 150, 0.15) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
    /* No filter: blur() here. The background is already a soft radial
       gradient, so the blur was costing a full-size gaussian every frame
       for a difference measured at 0.5/255 — and WebKit pays that on the
       CPU, which put mobile Safari at roughly one frame per second. */
  }

  .ambient-bottom {
    position: fixed;
    bottom: -200px;
    left: -200px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(255,255,255,0.35) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    /* No filter: blur() here. The background is already a soft radial
       gradient, so the blur was costing a full-size gaussian every frame
       for a difference measured at 0.5/255 — and WebKit pays that on the
       CPU, which put mobile Safari at roughly one frame per second. */
  }

  /* ========================================
     GLOBAL REVEAL ANIMATION
  ======================================== */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.25, 1, 0.5, 1),
                transform 0.7s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-stagger {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.25, 1, 0.5, 1) 0.1s,
                transform 0.7s cubic-bezier(0.25, 1, 0.5, 1) 0.1s;
  }

  .reveal-stagger.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ========================================
     GLOBAL CTA PRIMARIO (referenced across components)
  ======================================== */
  /* Smoked glass: a black pane with a lit top bevel and a darker lower lip,
     so it reads as the same material as the clear glass beside it */
  :global(.cta-primary) {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.7rem;
    background: linear-gradient(180deg, #2c2c2c 0%, #000 100%);
    color: #F7F6F2;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 100px;
    letter-spacing: -0.01em;
    box-shadow:
      inset 0 1px 0.5px rgba(255, 255, 255, 0.3),
      inset 0 -1px 1px rgba(0, 0, 0, 0.5),
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.08),
      0 6px 18px -6px rgba(0, 0, 0, 0.45);
    transition: transform 0.45s var(--ease-spring), box-shadow 0.3s ease, background 0.3s ease;
    white-space: nowrap;
  }

  :global(.cta-primary:hover) {
    background: linear-gradient(180deg, #3a3a3a 0%, #0a0a0a 100%);
    transform: translateY(-2px) scale(1.02);
    box-shadow:
      inset 0 1px 0.5px rgba(255, 255, 255, 0.35),
      inset 0 -1px 1px rgba(0, 0, 0, 0.5),
      0 12px 28px -8px rgba(0, 0, 0, 0.5);
  }

  :global(.cta-primary:active) {
    transform: scale(0.965);
  }
</style>
