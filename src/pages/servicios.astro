    --accent-rgb-1: var(--growth-rgb-1);
    --accent-color-2: var(--growth-color-2);
    --accent-rgb-2: var(--growth-rgb-2);
  }
  #service-block-5 {
    --accent-color-1: var(--ai-color-1);
