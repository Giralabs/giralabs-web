    --engineering-color-2: #9ca3af;
    --engineering-rgb-1: 0, 0, 0;
    --engineering-rgb-2: 156, 163, 175;

    --growth-color-1: #111111;
    --growth-color-2: #374151;
    --growth-rgb-1: 17, 17, 17;
    --growth-rgb-2: 55, 65, 81;

    --ai-color-1: #000000;
    --ai-color-2: #d1d5db;
    --ai-rgb-1: 0, 0, 0;
    --ai-rgb-2: 209, 213, 219;

    --team-color-1: #111111;
    --team-color-2: #4b5563;
    --team-rgb-1: 17, 17, 17;
    --team-rgb-2: 75, 85, 99;
  }


  /* Ambient flows in light space */

  /* ========================================
     HERO SEGMENT
  ======================================== */
  .services-hero {
    position: relative;
    padding: 10rem 2rem 4rem;
    z-index: 1;
    text-align: center;
  }

  .hero-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--ink-subtle);
    display: inline-block;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #000;
    margin: 0 0 1.2rem;
    line-height: 1.15;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 3.2vw, 1.15rem);
    color: rgba(0,0,0,0.6);
    line-height: 1.6;
    margin: 0;
  }

  /* ========================================
     SERVICES CONTENT & CARDS (Frosted Liquid Glass)
  ======================================== */
  .services-container {
    position: relative;
    z-index: 2;
    padding: 0 2rem 6rem;
  }

  .services-flow {
    max-width: 1050px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  .service-block {
    position: relative;
    width: 100%;
  }

  /* Accent Color Bindings for Services */
  #service-block-1 {
    --accent-color-1: var(--discovery-color-1);
    --accent-rgb-1: var(--discovery-rgb-1);
    --accent-color-2: var(--discovery-color-2);
    --accent-rgb-2: var(--discovery-rgb-2);
  }
  #service-block-2 {
    --accent-color-1: var(--design-color-1);
    --accent-rgb-1: var(--design-rgb-1);
    --accent-color-2: var(--design-color-2);
    --accent-rgb-2: var(--design-rgb-2);
  }
  #service-block-3 {
    --accent-color-1: var(--engineering-color-1);
    --accent-rgb-1: var(--engineering-rgb-1);
    --accent-color-2: var(--engineering-color-2);
    --accent-rgb-2: var(--engineering-rgb-2);
  }
  #service-block-4 {
