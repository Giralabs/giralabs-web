  <!-- ==================== INTERACTION SCRIPTS ==================== -->
  <script>
    import { initSpotlight } from '../lib/spotlight';
    // Pointer-following spotlight: rect cached on entry, one write per frame
    initSpotlight('.service-glass-card');

    // Handle hash scrolling on page load
    window.addEventListener('load', () => {
      if (window.location.hash) {
        const target = document.querySelector(window.location.hash);
        if (target) {
          setTimeout(() => {
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }, 300);
        }
      }
    });

    // Trigger visual scroll animations
    const revealEls = document.querySelectorAll('.reveal, .reveal-stagger');
    // A ratio threshold measures a share of the target's own height, and these
    // reveal targets are whole sections that are often taller than the viewport,
    // so the share could never be met and the section stayed invisible. The
    // negative bottom rootMargin is what delays the reveal until it is properly
    // in view.
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          // Add active class to cards inside stagger container to fire widget loops
          if (entry.target.classList.contains('reveal-stagger')) {
            entry.target.querySelectorAll('.service-block').forEach(block => {
              block.classList.add('is-active');
            });
          }
        }
      });
    }, { threshold: 0, rootMargin: '0px 0px -40px 0px' });
    revealEls.forEach(el => observer.observe(el));
  </script>

