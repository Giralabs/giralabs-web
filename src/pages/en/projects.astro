---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { translations } from '../../i18n/translations';
import CTAContact from '../../components/CTAContact.astro';
import Footer from '../../components/Footer.astro';
import BipsyFeaturedCard from '../../components/bipsy/BipsyFeaturedCard.astro';
import { getLocalizedPath } from '../../lib/paths';

export const prerender = true;
const lang = 'en';
const T = translations[lang];

const siteUrl = 'https://giralabs.es';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/en/` },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: `${siteUrl}/en/projects` },
  ],
};
---

<Layout
  title={`${T.meta_title} | ${T.projects_meta_title}`}
  description={T.projects_meta_description}
  lang={lang}
>
  <!-- Dot grid background -->
  <div class="grid-bg" aria-hidden="true"></div>
  <!-- Ambient blobs -->
  <div class="ambient-glow glow-top" aria-hidden="true"></div>
  <div class="ambient-glow glow-bottom" aria-hidden="true"></div>

  <Navbar lang={lang} />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- ==================== HERO ==================== -->
  <header class="projects-hero reveal">
    <div class="hero-inner">
      <span class="hero-eyebrow" data-i18n="projects_eyebrow">{T.projects_eyebrow}</span>
      <h1 class="hero-title">
        What we are<br /><em>building right now.</em>
      </h1>
      <p class="hero-sub" data-i18n="projects_sub">{T.projects_sub}</p>
    </div>
  </header>

  <!-- ==================== FEATURED PROJECT ==================== -->
  <main class="projects-main">
    <div class="projects-stage reveal">
      <BipsyFeaturedCard lang={lang} />
    </div>

    <!-- Why there is only one project on display -->
    <aside class="nda-note reveal" aria-label={T.projects_nda_title}>
      <span class="nda-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </span>
      <div class="nda-body">
        <h2 class="nda-title">{T.projects_nda_title}</h2>
        <p class="nda-text">{T.projects_nda_body}</p>
        <a href={getLocalizedPath('/servicios', lang)} class="nda-link">
          <span>{T.projects_nda_cta}</span>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </aside>
  </main>

  <CTAContact lang={lang} />
  <Footer lang={lang} />

  <script>
    const revealEls = document.querySelectorAll('.reveal, .reveal-stagger');
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) e.target.classList.add('visible');
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );
    revealEls.forEach((el) => obs.observe(el));
  </script>
</Layout>

<style>
  /* ---- BACKGROUND ---- */
  .grid-bg {
    position: fixed;
    inset: 0;
    background-image: radial-gradient(rgba(0, 0, 0, 0.05) 1.2px, transparent 1.2px);
    background-size: 32px 32px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.65;
  }

  .ambient-glow {
    position: fixed;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    z-index: 0;
  }

  /* Mint ambient: the page leads with Bipsy */
  .glow-top {
    top: -220px;
    right: -120px;
    background: radial-gradient(circle, rgba(192, 235, 209, 0.5) 0%, transparent 66%);
    opacity: 0.45;
  }

  .glow-bottom {
    bottom: -250px;
    left: -150px;
    background: radial-gradient(circle, rgba(192, 235, 209, 0.32) 0%, transparent 70%);
    opacity: 0.32;
  }

  /* ---- HERO ---- */
  .projects-hero {
    position: relative;
    z-index: 1;
    padding: 10rem 2rem 3rem;
    text-align: center;
  }

  .hero-inner {
    max-width: 780px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.38);
    margin-bottom: 1.4rem;
  }

  .hero-title {
    font-size: clamp(2.4rem, 6.5vw, 4.2rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1.1;
    color: #000;
    margin: 0 0 1.4rem;
  }

  .hero-title em {
    font-style: italic;
    font-weight: 300;
    color: rgba(0, 0, 0, 0.55);
  }

  .hero-sub {
    font-size: clamp(0.95rem, 2.2vw, 1.1rem);
    color: rgba(0, 0, 0, 0.55);
    line-height: 1.65;
    margin: 0 auto;
    max-width: 600px;
  }

  /* ---- MAIN ---- */
  .projects-main {
    position: relative;
    z-index: 1;
    padding: 0 2rem 8rem;
  }

  .projects-stage {
    max-width: 1160px;
    margin: 0 auto;
  }

  /* ---- NDA NOTE ---- */
  .nda-note {
    max-width: 1160px;
    margin: 1.6rem auto 0;
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
    padding: 2rem 2.2rem;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.42);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 6px 26px rgba(0, 0, 0, 0.025);
  }

  .nda-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 13px;
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.06);
    color: rgba(0, 0, 0, 0.5);
  }

  .nda-title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #000;
    margin: 0.35rem 0 0.5rem;
  }

  .nda-text {
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.55);
    margin: 0;
    max-width: 78ch;
  }

  .nda-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #000;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .nda-link svg { transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1); }
  .nda-link:hover { color: #3f8c66; }
  .nda-link:hover svg { transform: translateX(3px); }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 600px) {
    .projects-hero { padding: 8rem 1.5rem 2.5rem; }
    .projects-main { padding: 0 1.2rem 5rem; }
    .nda-note {
      flex-direction: column;
      gap: 0.9rem;
      padding: 1.6rem 1.4rem;
      border-radius: 20px;
    }
  }
</style>
