---
import Layout from '../../../layouts/Layout.astro';
import { SITE_ORIGIN } from '../../../lib/site';
import Navbar from '../../../components/Navbar.astro';
import BipsyProject from '../../../components/bipsy/BipsyProject.astro';
import CTAContact from '../../../components/CTAContact.astro';
import Footer from '../../../components/Footer.astro';

export const prerender = true;

const lang = 'en';
const siteUrl = SITE_ORIGIN;

const metaTitle = 'Bipsy | Booking app for barbershops, hair salons and beauty studios | Giralabs';
const metaDescription =
  'Bipsy is the booking ecosystem we are building at Giralabs: an app for clients and Bipsy Business for beauty and wellness venues. Our own product, currently in development.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/en/` },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: `${siteUrl}/en/projects` },
    { '@type': 'ListItem', position: 3, name: 'Bipsy', item: `${siteUrl}/en/project/bipsy` },
  ],
};

// Two unreleased apps: declared without offers or ratings on purpose
const appsSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteUrl}/en/project/bipsy#bipsy`,
      name: 'Bipsy',
      applicationCategory: 'LifestyleApplication',
      operatingSystem: 'iOS, Android',
      inLanguage: 'en',
      description:
        'Booking app for clients of barbershops, hair salons and beauty studios: discovery by category, real availability, reminders and appointment history.',
      author: { '@id': `${SITE_ORIGIN}/#organization` },
      publisher: { '@id': `${SITE_ORIGIN}/#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteUrl}/en/project/bipsy#bipsy-business`,
      name: 'Bipsy Business',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'iOS, Android',
      inLanguage: 'en',
      description:
        'Management app for barbershops, hair salons and beauty studios: daily agenda, appointment confirmation, services, team and client profiles.',
      author: { '@id': `${SITE_ORIGIN}/#organization` },
      publisher: { '@id': `${SITE_ORIGIN}/#organization` },
    },
  ],
};
---

<Layout title={metaTitle} description={metaDescription} lang={lang}>
  <!-- Dot grid background -->
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="ambient-glow glow-top" aria-hidden="true"></div>
  <div class="ambient-glow glow-bottom" aria-hidden="true"></div>

  <Navbar lang={lang} />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(appsSchema)} />

  <BipsyProject lang={lang} />

  <CTAContact lang={lang} />
  <Footer lang={lang} />

  <script>
    const revealEls = document.querySelectorAll('.reveal');
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) e.target.classList.add('visible');
        });
      },
      { threshold: 0.06, rootMargin: '0px 0px -30px 0px' }
    );
    revealEls.forEach((el) => obs.observe(el));
  </script>
</Layout>

<style>
  .grid-bg {
    position: fixed;
    inset: 0;
    background-image: radial-gradient(rgba(0, 0, 0, 0.05) 1.2px, transparent 1.2px);
    background-size: 32px 32px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.65;
  }

  .ambient-glow {
    position: fixed;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    z-index: 0;
  }

  /* Mint ambient: the page borrows the Bipsy palette */
  .glow-top {
    top: -220px;
    right: -120px;
    background: radial-gradient(circle, rgba(192, 235, 209, 0.55) 0%, transparent 66%);
    opacity: 0.5;
  }

  .glow-bottom {
    bottom: -260px;
    left: -160px;
    background: radial-gradient(circle, rgba(192, 235, 209, 0.35) 0%, transparent 70%);
    opacity: 0.35;
  }
</style>
