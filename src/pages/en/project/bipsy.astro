---
import Layout from '../../../layouts/Layout.astro';
import { SITE_ORIGIN } from '../../../lib/site';
import { BIPSY_STORE, BIPSY_WEB } from '../../../lib/bipsy-links';
import Navbar from '../../../components/Navbar.astro';
import BipsyProject from '../../../components/bipsy/BipsyProject.astro';
import CTAContact from '../../../components/CTAContact.astro';
import Footer from '../../../components/Footer.astro';

export const prerender = true;

const lang = 'en';
const siteUrl = SITE_ORIGIN;

const metaTitle = 'Bipsy | Booking app for barbershops, hair salons and beauty studios | Giralabs';
const metaDescription =
  'Bipsy is the booking ecosystem built at Giralabs: an app for clients and Bipsy Business for barbershops, hair salons and beauty studios. On the App Store now; Android in a few weeks.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/en/` },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: `${siteUrl}/en/projects` },
    { '@type': 'ListItem', position: 3, name: 'Bipsy', item: `${siteUrl}/en/project/bipsy` },
  ],
};

// Both apps are live on the App Store (Android in a few weeks). Declared
// without offers or ratings: we do not publish figures we cannot back up.
const appsSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteUrl}/en/project/bipsy#bipsy`,
      name: 'Bipsy',
      applicationCategory: 'LifestyleApplication',
      operatingSystem: 'iOS, iPadOS',
      downloadUrl: BIPSY_STORE.client.appStore,
      sameAs: [BIPSY_STORE.client.appStore, BIPSY_WEB.client],
      inLanguage: 'en',
      description:
        'Booking app for clients of barbershops, hair salons and beauty studios: discovery by category, real availability, reminders and appointment history.',
      author: { '@id': `${SITE_ORIGIN}/#organization` },
      publisher: { '@id': `${SITE_ORIGIN}/#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteUrl}/en/project/bipsy#bipsy-business`,
      name: 'Bipsy Business',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'iOS, iPadOS',
      downloadUrl: BIPSY_STORE.business.appStore,
      sameAs: [BIPSY_STORE.business.appStore, BIPSY_WEB.business],
      inLanguage: 'en',
      description:
        'Management app for barbershops, hair salons and beauty studios: daily agenda, appointment confirmation, services, team and client profiles.',
      author: { '@id': `${SITE_ORIGIN}/#organization` },
      publisher: { '@id': `${SITE_ORIGIN}/#organization` },
    },
  ],
};
---

<Layout title={metaTitle} description={metaDescription} lang={lang}>
  <!-- Dot grid background -->

  <Navbar lang={lang} />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(appsSchema)} />

  <BipsyProject lang={lang} />

  <CTAContact lang={lang} />
  <Footer lang={lang} />

  <script>
    const revealEls = document.querySelectorAll('.reveal');
    // A ratio threshold measures a share of the target's own height, and these
    // reveal targets are whole sections that are often taller than the viewport,
    // so the share could never be met and the section stayed invisible. The
    // negative bottom rootMargin is what delays the reveal until it is properly
    // in view.
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) e.target.classList.add('visible');
        });
      },
      { threshold: 0, rootMargin: '0px 0px -30px 0px' }
    );
    revealEls.forEach((el) => obs.observe(el));
  </script>
</Layout>

<style>


  /* Mint ambient: the page borrows the Bipsy palette */

</style>
