---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { translations } from '../../i18n/translations';

export const prerender = true;
const lang = 'en';
const T = translations[lang];
---

<Layout
  title={`${T.meta_title} | ${T.contact_meta_title}`}
  description={T.contact_meta_description}
  lang={lang}
>
  <!-- Global dot-grid background -->
  <div class="grid-bg" aria-hidden="true"></div>
  
  <!-- Ambient glowing blobs specific to contact page -->
  <div class="ambient-glow glow-top" aria-hidden="true"></div>
  <div class="ambient-glow glow-bottom" aria-hidden="true"></div>

  <!-- Navbar -->
  <Navbar lang={lang} />

  <!-- Contact Form section -->
  <main class="contact-page-container">
    <Contact 
      lang={lang} 
      actionUrl="https://formspree.io/f/xvznwgob" 
      bookingActionUrl="https://formspree.io/f/xvznwgob" 
      isPage={true}
    />
  </main>

  <!-- Footer -->
  <Footer lang={lang} />

</Layout>

<!-- ==================== INTERACTIONS ==================== -->
<script>
  // ---- Scroll reveal (general) ----
  const revealEls = document.querySelectorAll('.reveal, .reveal-stagger');
  // A ratio threshold measures a share of the target's own height, and these
  // reveal targets are whole sections that are often taller than the viewport,
  // so the share could never be met and the section stayed invisible. The
  // negative bottom rootMargin is what delays the reveal until it is properly
  // in view.
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, { threshold: 0, rootMargin: '0px 0px -40px 0px' });
  revealEls.forEach(el => observer.observe(el));
</script>

<style>
  /* ========================================
     GLOBAL & LAYOUT SPECIFICS FOR CONTACT PAGE
  ======================================== */
  .grid-bg {
    position: fixed;
    inset: 0;
    background-image: radial-gradient(rgba(0,0,0,0.05) 1.2px, transparent 1.2px);
    background-size: 32px 32px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.65;
  }

  /* Ambient flows in light space */
  .ambient-glow {
    position: fixed;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    z-index: 0;
    opacity: 0.08;
  }

  .glow-top {
    top: -200px;
    right: -100px;
    background: radial-gradient(circle, rgba(255, 210, 150, 0.12) 0%, transparent 65%);
  }

  .glow-bottom {
    bottom: -250px;
    left: -150px;
    background: radial-gradient(circle, rgba(0, 240, 255, 0.08) 0%, transparent 70%);
  }

  .contact-page-container {
    position: relative;
    z-index: 1;
    padding-top: 4rem; /* Safe spacing from Navbar */
  }

  /* ========================================
     GLOBAL REVEAL ANIMATION
  ======================================== */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.25, 1, 0.5, 1),
                transform 0.7s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
