---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CareersIndex from '../../components/careers/CareersIndex.astro';
import { careersCopy } from '../../data/careers';

export const prerender = true;
const lang = 'es';
const C = careersCopy[lang];
---

<Layout title={C.metaTitle} description={C.metaDescription} lang={lang}>
  <Navbar lang={lang} />
  <CareersIndex lang={lang} />
  <Footer lang={lang} />
</Layout>
