---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CTAContact from '../../components/CTAContact.astro';
import { translations } from '../../i18n/translations';

export const prerender = true;

export async function getStaticPaths() {
  const posts = import.meta.glob('../../data/blog/*.md', { eager: true });
  return Object.values(posts).map((post: any) => ({
    params: { slug: post.frontmatter.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = post;
const { title, description, date, tags, readingTime, image } = post.frontmatter;

// Get headings dynamically from markdown file for TOC
const headings = post.getHeadings ? post.getHeadings() : [];

const lang = 'es';
const T = translations[lang];

// Format date nicely
const formattedDate = new Date(date).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Resolve image metadata dynamically using Vite glob
const images = import.meta.glob('../../assets/blog/*');
const imageMetadata = image && images[image] ? (await images[image]() as any).default : null;

const schemaImageUrl = imageMetadata 
  ? `https://www.giralabs.es${imageMetadata.src}` 
  : "https://www.giralabs.es/logo-email.avif";

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": date,
  "dateModified": date,
  "author": {
    "@type": "Organization",
    "name": "Giralabs",
    "url": "https://www.giralabs.es"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Giralabs",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.giralabs.es/favicon.svg"
    }
  },
  "image": schemaImageUrl
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": lang === 'es' ? "Inicio" : "Home",
      "item": lang === 'es' ? "https://www.giralabs.es" : "https://www.giralabs.es/en"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": lang === 'es' ? "https://www.giralabs.es/blog" : "https://www.giralabs.es/en/blog"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": lang === 'es' ? `https://www.giralabs.es/blog/${post.frontmatter.slug}` : `https://www.giralabs.es/en/blog/${post.frontmatter.slug}`
    }
  ]
};

// Localized translation helper
const T_detail = {
  backToBlog: "Volver al blog",
  tableOfContents: "Índice de contenido",
  readingTime: "de lectura",
  share: "Compartir",
  copyLink: "Copiar enlace",
  copied: "¡Copiado!",
  ctaTitle: "¿Tienes un proyecto?",
  ctaText: "Diseñamos y desarrollamos aplicaciones móviles y software a medida de nivel premium.",
  ctaButton: "Hablemos",
  recommendedTitle: "Sigue leyendo",
  recommendedSub: "Casos de éxito y artículos seleccionados para ti",
  readMore: "Leer artículo",
  viewProject: "Ver caso",
};

// Eagerly glob all files to find images for recommendation cards
const blogImages = import.meta.glob('../../assets/blog/*', { eager: true });
const projectImages = import.meta.glob('../../assets/bipsy/assets_apps/*', { eager: true });

const allPosts = Object.values(import.meta.glob('../../data/blog/*.md', { eager: true })) as any[];
const otherPosts = allPosts
  .filter((p: any) => p.frontmatter.slug !== post.frontmatter.slug)
  .sort((a: any, b: any) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

const recommendations = [];

// Add other blog posts first
for (const p of otherPosts) {
  if (recommendations.length >= 2) break;
  const pImgPath = p.frontmatter.image;
  const pImgMetadata = blogImages[pImgPath] ? (blogImages[pImgPath] as any).default : null;
  
  recommendations.push({
    title: p.frontmatter.title,
    description: p.frontmatter.description,
    tags: p.frontmatter.tags || [],
    url: `/blog/${p.frontmatter.slug}`,
    imageSrc: pImgMetadata ? pImgMetadata.src : null,
    isProject: false,
    badgeText: 'Artículo'
  });
}

// Fallback project data if there aren't enough blog posts
const fallbackProjects = [
  {
    title: "Bipsy",
    description: "Nuestro ecosistema de reservas para barberías, peluquerías y centros de estética: una app para el cliente y Bipsy Business para el negocio. En desarrollo.",
    tags: ["Flutter", "Producto"],
    url: "/proyecto/bipsy",
    imageKey: "../../assets/bipsy/assets_apps/bipsy_light.webp",
    isProject: true,
    badgeText: 'Producto propio'
  }
];

// Fill the remaining recommendation slots with projects
for (const proj of fallbackProjects) {
  if (recommendations.length >= 2) break;
  const projImgMetadata = projectImages[proj.imageKey] ? (projectImages[proj.imageKey] as any).default : null;
  
  recommendations.push({
    title: proj.title,
    description: proj.description,
    tags: proj.tags,
    url: proj.url,
    imageSrc: projImgMetadata ? projImgMetadata.src : null,
    isProject: true,
    badgeText: proj.badgeText
  });
}
---

<Layout
  title={`${title.substring(0, 44)}... | Giralabs`}
  description={description}
  lang={lang}
>
  <!-- Global dot-grid background -->
  <div class="grid-bg" aria-hidden="true"></div>
  
  <!-- Ambient glowing blobs with drift animation -->
  <div class="ambient-glow glow-top" aria-hidden="true"></div>
  <div class="ambient-glow glow-middle" aria-hidden="true"></div>
  <div class="ambient-glow glow-bottom" aria-hidden="true"></div>

  <!-- Navbar -->
  <Navbar lang={lang} />

  <!-- Schema JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Floating Reader Header -->
  <div class="floating-read-header" id="floating-header" aria-hidden="true">
    <div class="floating-header-inner">
      <div class="floating-header-left">
        <a href="/blog" class="floating-back-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span class="desktop-only">{T_detail.backToBlog}</span>
        </a>
        <span class="floating-header-sep">|</span>
        <span class="floating-header-title">{title}</span>
      </div>
      <div class="floating-header-right">
        <div class="reading-progress-container">
          <span class="reading-progress-text"><span id="progress-percent">0</span>% leído</span>
          <div class="reading-progress-track">
            <div class="reading-progress-bar-fill" id="progress-bar-fill"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== ARTICLE HERO ==================== -->
  <header class="post-hero reveal">
    <div class="hero-inner">
      <nav class="post-breadcrumb" aria-label="Breadcrumb">
        <a href={lang === 'es' ? '/' : '/en'} class="breadcrumb-link">{lang === 'es' ? 'Inicio' : 'Home'}</a>
        <span class="breadcrumb-sep">&gt;</span>
        <a href={lang === 'es' ? '/blog' : '/en/blog'} class="breadcrumb-link">Blog</a>
        <span class="breadcrumb-sep">&gt;</span>
        <span class="breadcrumb-current">{title}</span>
      </nav>
      
      <h1 class="post-title">{title}</h1>
      
      <div class="post-meta">
        <time datetime={date} class="meta-item">{formattedDate}</time>
        <span class="meta-sep">•</span>
        <span class="meta-item">{readingTime} de lectura</span>
      </div>
    </div>
  </header>

  <!-- ==================== MAIN CONTENT ==================== -->
  <main class="post-container">
    <!-- Main content card -->
    <article class="post-glass-card reveal">
      <div class="card-border"></div>
      <div class="card-effects">
        <div class="card-spotlight"></div>
      </div>
      
      <div class="card-inner">
        <!-- Featured Image -->
        {imageMetadata && (
          <div class="post-featured-image-wrapper">
            <img src={imageMetadata.src} alt={title} class="post-featured-image" />
          </div>
        )}

        <!-- Inline Table of Contents (Mobile/Tablet only) -->
        {headings.length > 0 && (
          <div class="toc-inline-box mobile-toc-only">
            <h3 class="toc-inline-title">{T_detail.tableOfContents}</h3>
            <nav>
              <ul class="toc-inline-list">
                {headings.filter(h => h.depth === 2).map((h, idx) => (
                  <li class="toc-inline-item">
                    <a href={`#${h.slug}`} class="toc-inline-link">
                      <span class="toc-inline-num">0{idx + 1}.</span>
                      <span class="toc-inline-text">{h.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        )}

        <!-- Article Content -->
        <div class="post-content">
          <Content />
        </div>
      </div>
    </article>

    <!-- Sidebar (Desktop only) -->
    <aside class="post-sidebar">
      <div class="sidebar-sticky-wrapper">
        
        <!-- Table of Contents (Scrollspy) -->
        {headings.length > 0 && (
          <div class="sidebar-section toc-sidebar-card">
            <h3 class="sidebar-title">{T_detail.tableOfContents}</h3>
            <nav class="toc-sidebar-nav">
              <ul class="toc-sidebar-list">
                {headings.filter(h => h.depth === 2).map((h, idx) => (
                  <li class="toc-sidebar-item">
                    <a href={`#${h.slug}`} class="toc-sidebar-link" data-slug={h.slug}>
                      <span class="toc-sidebar-num">0{idx + 1}</span>
                      <span class="toc-sidebar-text">{h.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        )}

        <!-- Share Actions -->
        <div class="sidebar-section share-sidebar-card">
          <h3 class="sidebar-title">{T_detail.share}</h3>
          <div class="share-buttons">
            <button class="share-btn share-copy-btn" id="share-copy-btn">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
              <span>{T_detail.copyLink}</span>
            </button>
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent('https://www.giralabs.es/blog/' + post.frontmatter.slug)}`} target="_blank" rel="noopener noreferrer" class="share-btn share-social-btn" aria-label="Compartir en Twitter">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent('https://www.giralabs.es/blog/' + post.frontmatter.slug)}`} target="_blank" rel="noopener noreferrer" class="share-btn share-social-btn" aria-label="Compartir en LinkedIn">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
          </div>
          <div class="toast-copied" id="toast-copied">{T_detail.copied}</div>
        </div>

        <!-- Sidebar CTA -->
        <div class="sidebar-section cta-sidebar-card">
          <div class="cta-sidebar-inner">
            <h4 class="cta-sidebar-title">{T_detail.ctaTitle}</h4>
            <p class="cta-sidebar-text">{T_detail.ctaText}</p>
            <a href="/contacto" class="cta-sidebar-btn">
              {T_detail.ctaButton}
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </aside>
  </main>

  <!-- ==================== RECOMMENDATIONS SECTION ==================== -->
  <section class="recommendations-section reveal">
    <div class="recommendations-inner">
      <div class="recommendations-header">
        <h2 class="recommendations-title">{T_detail.recommendedTitle}</h2>
        <p class="recommendations-subtitle">{T_detail.recommendedSub}</p>
      </div>

      <div class="recommendations-grid">
        {recommendations.map(rec => (
          <article class="rec-card blog-glass-card">
            <div class="card-border"></div>
            <div class="card-effects">
              <div class="card-spotlight"></div>
            </div>
            
            <a href={rec.url} class="rec-card-link-overlay" aria-label={rec.title}></a>
            
            <div class="rec-card-inner">
              {rec.imageSrc && (
                <div class="rec-card-image-wrapper">
                  <img src={rec.imageSrc} alt={rec.title} class="rec-card-image" />
                </div>
              )}
              <div class="rec-card-content">
                <div class="rec-card-meta">
                  <span class="rec-card-badge">{rec.badgeText}</span>
                  <span class="rec-card-sep">•</span>
                  <span class="rec-card-tags">{rec.tags.slice(0, 2).join(' / ')}</span>
                </div>
                <h3 class="rec-card-title">{rec.title}</h3>
                <p class="rec-card-desc">{rec.description}</p>
                <div class="rec-card-footer">
                  <span class="rec-card-more">{rec.isProject ? T_detail.viewProject : T_detail.readMore}</span>
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTAContact lang={lang} />

  <Footer lang={lang} />

  <script>
    import { initSpotlight } from '../../lib/spotlight';
    // Pointer-following spotlight: rect cached on entry, one write per frame
    initSpotlight('.blog-glass-card');

    // Trigger visual scroll animations
    const revealEls = document.querySelectorAll('.reveal');
    // A ratio threshold measures a share of the target's own height, and these
    // reveal targets are whole sections that are often taller than the viewport,
    // so the share could never be met and the section stayed invisible. The
    // negative bottom rootMargin is what delays the reveal until it is properly
    // in view.
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0, rootMargin: '0px 0px -20px 0px' });
    revealEls.forEach(el => observer.observe(el));

    // Scroll progress, floating header and Scrollspy TOC
    const floatingHeader = document.getElementById('floating-header');
    const progressBarFill = document.getElementById('progress-bar-fill');
    const progressPercent = document.getElementById('progress-percent');
    const tocLinks = document.querySelectorAll('.toc-sidebar-link');
    
    // Select headers from text for spy
    const headings = Array.from(document.querySelectorAll('.post-content h2'));

    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = Math.min(Math.max(Math.round((winScroll / height) * 100), 0), 100);

      // Update progress elements
      if (progressBarFill) progressBarFill.style.width = scrolled + '%';
      if (progressPercent) progressPercent.innerText = String(scrolled);

      // Show/hide floating reader header
      if (floatingHeader) {
        if (winScroll > 320) {
          floatingHeader.classList.add('visible');
        } else {
          floatingHeader.classList.remove('visible');
        }
      }

      // Scrollspy active heading detection
      let currentActiveId = '';
      const scrollPosition = winScroll + 180; // trigger offset

      for (const heading of headings) {
        const headingTop = (heading as HTMLElement).offsetTop;
        if (scrollPosition >= headingTop) {
          currentActiveId = heading.id;
        } else {
          break;
        }
      }

      tocLinks.forEach(link => {
        const href = link.getAttribute('href');
        if (href === `#${currentActiveId}`) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });
    }, { passive: true });

    // Copy Link Action
    const copyBtn = document.getElementById('share-copy-btn');
    const toast = document.getElementById('toast-copied');
    if (copyBtn && toast) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href)
          .then(() => {
            toast.classList.add('show');
            setTimeout(() => {
              toast.classList.remove('show');
            }, 2000);
          })
          .catch(err => {
            console.error('Failed to copy: ', err);
          });
      });
    }
  </script>
</Layout>

<style>
  /* ========================================
     BACKGROUNDS & FLOATING BLOBS
     ======================================== */
  .grid-bg {
    position: fixed;
    inset: 0;
    background-image: radial-gradient(rgba(0,0,0,0.04) 1.2px, transparent 1.2px);
    background-size: 32px 32px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.65;
  }

  .ambient-glow {
    position: fixed;
    border-radius: 50%;
    /* No filter: blur() here. The background is already a soft radial
       gradient, so the blur was costing a full-size gaussian every frame
       for a difference measured at 0.5/255 — and WebKit pays that on the
       CPU, which put mobile Safari at roughly one frame per second. */
    pointer-events: none;
    z-index: 0;
    opacity: 0.08;
    animation: drift 25s infinite alternate ease-in-out;
  }

  .glow-top {
    width: 600px;
    height: 600px;
    top: -200px;
    right: -100px;
    background: radial-gradient(circle, rgba(255, 180, 100, 0.22) 0%, transparent 65%);
    animation-duration: 20s;
  }

  .glow-middle {
    width: 500px;
    height: 500px;
    top: 40%;
    left: -200px;
    background: radial-gradient(circle, rgba(255, 125, 84, 0.18) 0%, transparent 65%);
    animation-duration: 28s;
    animation-delay: -5s;
  }

  .glow-bottom {
    width: 700px;
    height: 700px;
    bottom: -200px;
    right: -150px;
    background: radial-gradient(circle, rgba(0, 180, 255, 0.15) 0%, transparent 70%);
    animation-duration: 24s;
    animation-delay: -10s;
  }

  @keyframes drift {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(60px, -50px) scale(1.08); }
    100% { transform: translate(-40px, 40px) scale(0.95); }
  }

  /* ========================================
     FLOATING HEADER BAR
     ======================================== */
  .floating-read-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 72px;
    background: rgba(240, 239, 234, 0.85);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    z-index: 100;
    transform: translateY(-100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 30px rgba(0,0,0,0.02);
  }

  .floating-read-header.visible {
    transform: translateY(0);
  }

  .floating-header-inner {
    max-width: 1300px;
    height: 100%;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .floating-header-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .floating-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(0, 0, 0, 0.6);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: color 0.2s ease;
    flex-shrink: 0;
  }

  .floating-back-link:hover {
    color: #ff7d54;
  }

  .floating-header-sep {
    color: rgba(0, 0, 0, 0.15);
    font-weight: 300;
  }

  .floating-header-title {
    font-weight: 700;
    color: #000;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .floating-header-right {
    flex-shrink: 0;
  }

  .reading-progress-container {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .reading-progress-text {
    font-size: 0.8rem;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.5);
    white-space: nowrap;
  }

  .reading-progress-track {
    width: 100px;
    height: 6px;
    background: rgba(0, 0, 0, 0.06);
    border-radius: 3px;
    overflow: hidden;
  }

  .reading-progress-bar-fill {
    width: 0%;
    height: 100%;
    background: linear-gradient(to right, #ffb464, #ff7d54);
    border-radius: 3px;
    transition: width 0.1s ease-out;
  }

  /* ========================================
     ARTICLE HERO SEGMENT
     ======================================== */
  .post-hero {
    position: relative;
    padding: 10rem 2rem 4rem;
    z-index: 1;
  }

  .hero-inner {
    max-width: 1300px;
    margin: 0 auto;
    text-align: left;
  }

  .post-breadcrumb {
    font-size: 0.85rem;
    color: rgba(0, 0, 0, 0.45);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb-link {
    color: rgba(0, 0, 0, 0.55);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb-link:hover {
    color: #ff7d54;
  }

  .breadcrumb-sep {
    color: rgba(0, 0, 0, 0.25);
  }

  .breadcrumb-current {
    font-weight: 600;
    color: #000;
  }

  .post-title {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    color: #000;
    line-height: 1.15;
    margin-bottom: 1.8rem;
