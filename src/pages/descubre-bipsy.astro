---
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';
import { BIPSY_STORE, BIPSY_WEB } from '../lib/bipsy-links';

// Bip, all poses on the same 2000 px square and the same framing, so they can
// cross-fade in one place: that is what makes him turn, look and walk.
import bipFront from '../assets/bipsy/bip_assets/bip_front.webp';
import bipBack from '../assets/bipsy/bip_assets/bip_back.webp';
import bipLeft from '../assets/bipsy/bip_assets/bip_left.webp';
import bipRight from '../assets/bipsy/bip_assets/bip_right.webp';
import bipHello from '../assets/bipsy/bip_assets/bip_hello.webp';
import bipLaughing from '../assets/bipsy/bip_assets/bip_laughing.webp';
import bipRecool from '../assets/bipsy/bip_assets/bip_recool.webp';
import bipPockets from '../assets/bipsy/bip_assets/big_pockets.webp';
// Waving for real: 48 frames, used raw so they survive the build
import bipWave from '../assets/bipsy/bip_assets/bip_hello_animated.webp';

import shotExplore from '../assets/bipsy/screens/pagina-principal-cliente.webp';
import shotMap from '../assets/bipsy/screens/cliente-mapa.webp';
import shotWho from '../assets/bipsy/screens/cliente-selecciona-profesional.webp';
import shotWhen from '../assets/bipsy/screens/cliente-reserva-hora.webp';
import shotMine from '../assets/bipsy/screens/cliente-mis-citas.webp';
import shotAgenda from '../assets/bipsy/screens/business-agenda-hoy.webp';
import shotServices from '../assets/bipsy/screens/business-servicios.webp';
import shotClient from '../assets/bipsy/screens/business-cliente-detail.webp';
import shotChat from '../assets/bipsy/screens/business-chat.webp';
import shotTeam from '../assets/bipsy/screens/business-equipo.webp';
import shotReviews from '../assets/bipsy/screens/business-resenas.webp';

import keyClient from '../assets/bipsy/keyvisuals/bipsy-app-2026-11.webp';
import keyBusiness from '../assets/bipsy/keyvisuals/bipsy-business-app-2026-11.webp';
import webClient from '../assets/bipsy/webs/bipsy-es.webp';
import webBusiness from '../assets/bipsy/webs/business-bipsy-es.webp';
import iconClient from '../assets/bipsy/icons/bipsy-icon.webp';
import iconBusiness from '../assets/bipsy/icons/bipsy-business-icon.webp';
import appStoreBadge from '../assets/bipsy/badges/app-store-badge.webp';

export const prerender = true;

const poseSources = {
  front: bipFront, back: bipBack, left: bipLeft, right: bipRight,
  hello: bipHello, laughing: bipLaughing, recool: bipRecool, pockets: bipPockets,
};
const poses = await Promise.all(
  Object.entries(poseSources).map(async ([name, src]) => ({ name, src: (await getImage({ src, width: 1200, format: 'webp' })).src })),
);

const shot = (src: ImageMetadata) => getImage({ src, width: 460, format: 'webp' }).then((i) => i.src);
const [sExplore, sMap, sWho, sWhen, sMine, sAgenda, sServices, sClient, sChat, sTeam, sReviews] = await Promise.all(
  [shotExplore, shotMap, shotWho, shotWhen, shotMine, shotAgenda, shotServices, shotClient, shotChat, shotTeam, shotReviews].map(shot),
);
const [kClient, kBusiness, wClient, wBusiness, icClient, icBusiness, badge] = await Promise.all([
  getImage({ src: keyClient, width: 900, format: 'webp' }),
  getImage({ src: keyBusiness, width: 900, format: 'webp' }),
  getImage({ src: webClient, width: 1100, format: 'webp' }),
  getImage({ src: webBusiness, width: 1100, format: 'webp' }),
  getImage({ src: iconClient, width: 112, format: 'webp' }),
  getImage({ src: iconBusiness, width: 112, format: 'webp' }),
  getImage({ src: appStoreBadge, width: 405, format: 'webp' }),
]);

const words = (text: string) => text.split(' ');
const challenge =
  'En la mayoría de barberías, peluquerías y centros de estética la agenda sigue viviendo en un cuaderno, en un WhatsApp a deshora o en una llamada que nadie coge mientras hay un cliente en la silla.';
const solution =
  'Bipsy lo cambia por dos apps que funcionan juntas: el cliente encuentra el sitio y reserva desde el móvil; el negocio ve el día entero en una pantalla y confirma con un gesto.';

const clientScreens = [
  { src: sExplore, title: 'Explorar', body: 'Categorías, tus sitios de siempre y negocios destacados.' },
  { src: sMap, title: 'Mapa', body: 'Los negocios de tu zona, con su valoración.' },
  { src: sWho, title: '¿Con quién?', body: 'Eliges profesional o el primero que tenga hueco.' },
  { src: sWhen, title: '¿A qué hora?', body: 'Solo huecos reales. Si ninguno encaja, te avisamos.' },
  { src: sMine, title: 'Mis citas', body: 'Próximas y pasadas, cada una con su estado.' },
];
const businessScreens = [
  { src: sAgenda, title: 'Tu agenda', body: 'Las citas de hoy, las pendientes y la lista de espera.' },
  { src: sServices, title: 'Servicios', body: 'Precio, duración y quién lo hace.' },
  { src: sClient, title: 'Ficha de cliente', body: 'Notas, citas, reseñas y pagos de cada cliente.' },
  { src: sChat, title: 'Mensajes', body: 'El chat con tus clientes, dentro de la app.' },
  { src: sTeam, title: 'Equipo', body: 'Trabajadores, ausencias e invitaciones.' },
  { src: sReviews, title: 'Reseñas', body: 'Lo que opinan tus clientes, y tus respuestas.' },
];

const steps = [
  { title: 'El negocio se da de alta', body: 'Descarga Bipsy Business y crea el salón desde el móvil: datos, equipo y horario.' },
  { title: 'Publica servicios y horarios', body: 'Cada servicio con su duración, su precio y los profesionales que lo realizan.' },
  { title: 'El cliente reserva', body: 'Encuentra el salón en Bipsy, ve los huecos reales y confirma su cita al instante.' },
  { title: 'Los dos ven lo mismo', body: 'La cita aparece en la agenda del negocio y en el móvil del cliente, sincronizada.' },
];

const apps = [
  {
    name: 'Bipsy', audience: 'Para quien reserva', icon: icClient.src, visual: kClient.src, store: BIPSY_STORE.client.appStore,
    desc: 'La app de cliente. Encuentra el sitio, elige servicio y profesional, y confirma la hora sin escribir a nadie.',
    features: ['Explora por categoría o en el mapa', 'Profesional y hora entre los huecos reales', 'Lista de espera: te avisa si se libera un hueco', 'Tus citas, próximas y pasadas', 'Chat con el negocio', 'Valoraciones de clientes que han ido'],
  },
  {
    name: 'Bipsy Business', audience: 'Para el negocio', icon: icBusiness.src, visual: kBusiness.src, store: BIPSY_STORE.business.appStore,
    desc: 'La app del salón. La agenda del día entera en una pantalla, con todo lo necesario para confirmar, mover o cerrar un hueco.',
    features: ['Agenda de hoy, pendientes y lista de espera', 'Confirmar, mover o cancelar una cita', 'Servicios con duración, precio y profesionales', 'Equipo, ausencias y fichaje', 'Ficha de cliente con notas, citas y pagos', 'Mensajes y reseñas en un solo sitio'],
  },
];

const traits = [
  { pose: 'Saludando', title: 'Hola, soy Bip.', body: 'La cara de Bipsy. Aparezco cuando la pantalla está vacía, cuando algo se rompe y cuando hay algo que celebrar.' },
  { pose: 'Pensando', title: 'Cercano, nunca infantil.', body: 'Acompaño sin estorbar: aparezco en los momentos en que dudas.' },
  { pose: 'Esperando', title: 'Un sistema, no un sticker.', body: 'Poses, expresiones y escenarios definidos para cubrir todo el producto.' },
  { pose: 'Riendo', title: 'El mismo en las dos apps.', body: 'Sudadera en Bipsy, traje en Business. Y siempre de buen humor.' },
];

const roadmap = [
  { phase: 'Descubrimiento', state: 'Hecho', body: 'Entrevistas con barberías y peluquerías para entender cómo llevan hoy su agenda.' },
  { phase: 'Identidad y diseño', state: 'Hecho', body: 'Marca, Bip, paleta y librería de componentes para las dos apps.' },
  { phase: 'Las dos apps', state: 'Hecho', body: 'Motor de reservas, agenda en tiempo real y las dos aplicaciones en Flutter.' },
  { phase: 'App Store', state: 'Noviembre 2026', body: 'Bipsy y Bipsy Business, publicadas para iPhone y iPad.' },
  { phase: 'Google Play', state: 'En unas semanas', body: 'Las dos apps, también para Android.' },
];

const webs = [
  { host: 'bipsy.es', href: BIPSY_WEB.client, img: wClient.src, title: 'Reservar desde el navegador', body: 'Buscar por servicio, zona y día, y pedir cita sin descargar la app.' },
  { host: 'business.bipsy.es', href: BIPSY_WEB.business, img: wBusiness.src, title: 'La web de Bipsy Business', body: 'Funcionalidades, precios y alta, para conocerla antes de empezar.' },
];
---

<Layout
  title="Descubre Bipsy | Giralabs"
  description="Bip te enseña Bipsy por dentro: la app para reservar en barberías, peluquerías y centros de estética, y Bipsy Business para gestionarlos. Un producto de Giralabs."
  lang="es"
  noindex
>
  <div class="xb" data-xb>
    <header class="xb-top">
      <a href="/proyectos" class="xb-chip">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 5 8 12 15 19"></polyline></svg>
        Proyectos
      </a>
      <a href="#xb-final" class="xb-chip">Saltar</a>
    </header>

    <!--
      Bip, the guide. Fixed on screen and driven by the scroll: every section
      tells him where to stand, how big to be and which pose to hold, and the
      script blends one into the next. Inside, three wrappers that never fight:
      the landing, the look towards the cursor, and the breathing or the walk.
    -->
    <div class="xb-actor" data-actor aria-hidden="true">
      <div class="xb-actor-land">
        <div class="xb-actor-look">
          <div class="xb-actor-body" data-body>
            <span class="xb-shadow"></span>
            {poses.map((p) => (
              <img src={p.src} alt="" class="xb-pose" data-pose={p.name} width="2000" height="2000" decoding="async" fetchpriority={p.name === 'back' || p.name === 'front' ? 'high' : 'auto'} />
            ))}
            <img src={bipWave.src} alt="" class="xb-pose xb-pose--wave" data-pose="wave" width="400" height="711" decoding="async" />
          </div>
        </div>
      </div>
    </div>

    <!-- ==================== 1. HERO ==================== -->
    <section class="xb-scene xb-hero" data-scene="hero">
      <div class="xb-pin">
        <h1 class="sr-only">Descubre Bipsy</h1>
        <p class="xb-giant" aria-hidden="true">
          <span class="xb-giant-line xb-giant-line--a"><span>Reservar,</span></span>
          <span class="xb-giant-line xb-giant-line--b"><span>en dos <br class="xb-br-m" />toques.</span></span>
        </p>
        <div class="xb-hero-copy">
          <p class="xb-eyebrow">Una app de Giralabs</p>
          <p class="xb-hero-lead">Reservar en tu barbería, peluquería o centro de estética debería costar dos toques. Gestionarlo, ninguno más.</p>
          <p class="xb-hero-hint"><i></i>Desliza y te lo enseño</p>
        </div>
        <ul class="xb-hero-get" role="list">
          <li><a href={BIPSY_STORE.client.appStore} target="_blank" rel="noopener"><img src={icClient.src} alt="" width="40" height="40" /><span><b>Bipsy</b><small>Para reservar cita</small></span></a></li>
          <li><a href={BIPSY_STORE.business.appStore} target="_blank" rel="noopener"><img src={icBusiness.src} alt="" width="40" height="40" /><span><b>Bipsy Business</b><small>Para tu negocio</small></span></a></li>
        </ul>
      </div>
    </section>

    <!-- ==================== 2. EL PUNTO DE PARTIDA ==================== -->
    <section class="xb-scene xb-why" data-scene="why">
      <div class="xb-pin">
        <div class="xb-why-block xb-why-block--a" style={`--n:${words(challenge).length}`}>
          <p class="xb-label">El punto de partida</p>
          <p class="xb-reveal">{words(challenge).map((w, i) => <span style={`--i:${i}`}>{w} </span>)}</p>
        </div>
        <div class="xb-why-block xb-why-block--b" style={`--n:${words(solution).length}`}>
          <p class="xb-label xb-label--mint">Nuestra apuesta</p>
          <p class="xb-reveal">{words(solution).map((w, i) => <span style={`--i:${i}`}>{w} </span>)}</p>
        </div>
      </div>
    </section>

    <!-- ==================== 3. POR DENTRO (horizontal) ==================== -->
    <section class="xb-scene xb-screens" data-scene="screens">
      <div class="xb-pin">
        <div class="xb-screens-night" aria-hidden="true"></div>
        <div class="xb-track" data-track>
          <div class="xb-track-intro">
            <p class="xb-eyebrow">Por dentro</p>
            <h2 class="xb-h2">Así es Bipsy<br />por dentro.</h2>
            <p class="xb-sub">Pantallas reales de las dos apps, tal y como se descargan hoy.</p>
          </div>
          {clientScreens.map((s) => (
            <figure class="xb-shot">
              <div class="xb-phone"><img src={s.src} alt={`Bipsy: ${s.title}`} width="900" height="1950" loading="lazy" decoding="async" /></div>
              <figcaption><b>{s.title}</b><span>{s.body}</span></figcaption>
            </figure>
          ))}
          <div class="xb-track-split" data-split>
            <p class="xb-eyebrow">Y al otro lado del mostrador</p>
            <p class="xb-h2">Bipsy<br />Business.</p>
          </div>
          {businessScreens.map((s) => (
            <figure class="xb-shot xb-shot--biz">
              <div class="xb-phone"><img src={s.src} alt={`Bipsy Business: ${s.title}`} width="900" height="1950" loading="lazy" decoding="async" /></div>
              <figcaption><b>{s.title}</b><span>{s.body}</span></figcaption>
            </figure>
          ))}
          <div class="xb-track-end" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <!-- ==================== 4. CÓMO FUNCIONA (la cita viaja) ==================== -->
    <section class="xb-scene xb-flow" data-scene="flow">
      <div class="xb-pin" data-flow data-step="0">
        <div class="xb-flow-head">
          <p class="xb-eyebrow">Cómo funciona</p>
          <h2 class="xb-h2">Del alta a la silla,<br />en cuatro pasos.</h2>
        </div>

        <figure class="xb-flow-phone xb-flow-phone--client" aria-hidden="true">
          <div class="xb-phone">
            <img src={sExplore} alt="" data-show="0 1" width="900" height="1950" loading="lazy" />
            <img src={sWhen} alt="" data-show="2 3" width="900" height="1950" loading="lazy" />
          </div>
          <figcaption>Bipsy</figcaption>
        </figure>
        <figure class="xb-flow-phone xb-flow-phone--biz" aria-hidden="true">
          <div class="xb-phone">
            <img src={sTeam} alt="" data-show="0" width="900" height="1950" loading="lazy" />
            <img src={sServices} alt="" data-show="1" width="900" height="1950" loading="lazy" />
            <img src={sAgenda} alt="" data-show="2 3" width="900" height="1950" loading="lazy" />
          </div>
          <figcaption>Bipsy Business</figcaption>
        </figure>

        <!-- The booking, on its way from one phone to the other -->
        <div class="xb-chip-booking" data-chip aria-hidden="true">
          <img src={icClient.src} alt="" width="28" height="28" />
          <span><b>Corte de pelo</b><small>Hoy, 10:30</small></span>
        </div>
        <div class="xb-flow-toast" aria-hidden="true">
          <img src={icBusiness.src} alt="" width="36" height="36" />
          <span><b>Nueva cita</b><small>Marina, corte de pelo, hoy a las 10:30</small></span>
        </div>

        <ol class="xb-steps">
          {steps.map((s, i) => (
            <li class="xb-step" data-i={i}>
              <span class="xb-step-n">{i + 1}/4</span>
              <b>{s.title}</b>
              <span>{s.body}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ==================== 5. LAS DOS APPS ==================== -->
    <section class="xb-scene xb-apps" data-scene="apps">
      <div class="xb-wrap">
        <p class="xb-eyebrow xb-in">El ecosistema</p>
        <h2 class="xb-h2 xb-in">Dos aplicaciones,<br />un mismo motor.</h2>
        <p class="xb-sub xb-in">Cada lado del mostrador tiene su app. Comparten catálogo, disponibilidad y estado de la cita en tiempo real.</p>
        <div class="xb-apps-grid">
          {apps.map((app) => (
            <article class="xb-app xb-in">
              <header class="xb-app-head">
                <img src={app.icon} alt="" width="52" height="52" />
                <span><b>{app.name}</b><small>{app.audience}</small></span>
              </header>
              <p class="xb-app-desc">{app.desc}</p>
              <img src={app.visual} alt="" class="xb-app-visual" width="900" height="688" loading="lazy" decoding="async" />
              <ul class="xb-app-list" role="list">
                {app.features.map((f) => (
                  <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="5 12.5 10 17 19 7"></polyline></svg>{f}</li>
                ))}
              </ul>
              <a href={app.store} class="xb-app-store" target="_blank" rel="noopener"><img src={badge.src} alt={`Descárgalo en el App Store: ${app.name}`} width="135" height="40" loading="lazy" /></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ==================== 6. CONOCE A BIP ==================== -->
    <section class="xb-scene xb-meet" data-scene="meet">
      <div class="xb-pin" data-meet data-step="0">
        <p class="xb-meet-title" aria-hidden="true">Bip</p>
        <div class="xb-meet-copy">
          <p class="xb-eyebrow">Identidad</p>
          <h2 class="xb-h2">Conoce a Bip.</h2>
          <div class="xb-traits">
            {traits.map((t, i) => (
              <div class="xb-trait" data-i={i}>
                <span class="xb-trait-pose">{t.pose}</span>
                <b>{t.title}</b>
                <p>{t.body}</p>
              </div>
            ))}
          </div>
        </div>
        <ol class="xb-meet-dots" aria-hidden="true">
          {traits.map((_, i) => <li data-i={i}></li>)}
        </ol>
      </div>
    </section>

    <!-- ==================== 7. EL CAMINO ==================== -->
    <section class="xb-scene xb-road" data-scene="road">
      <div class="xb-pin" data-road data-step="0">
        <div class="xb-road-head">
          <p class="xb-eyebrow">El camino</p>
          <h2 class="xb-h2">De la idea<br />al App Store.</h2>
        </div>
        <div class="xb-road-line" aria-hidden="true"><i></i></div>
        <ol class="xb-road-stops">
          {roadmap.map((r, i) => (
            <li class="xb-stop" data-i={i} style={`--x:${i / (roadmap.length - 1)}`}>
              <span class="xb-stop-dot"></span>
              <span class="xb-stop-state">{r.state}</span>
              <b>{r.phase}</b>
              <span class="xb-stop-body">{r.body}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ==================== 8. LAS WEBS ==================== -->
    <section class="xb-scene xb-webs" data-scene="webs">
      <div class="xb-wrap">
        <p class="xb-eyebrow xb-in">También en la web</p>
        <h2 class="xb-h2 xb-in">Y para quien no quiere<br />instalar nada.</h2>
        <div class="xb-webs-grid">
          {webs.map((w) => (
            <a href={w.href} class="xb-web xb-in" target="_blank" rel="noopener">
              <div class="xb-browser">
                <div class="xb-browser-bar"><i></i><i></i><i></i><span>{w.host}</span></div>
                <img src={w.img} alt={`Portada de ${w.host}`} width="1100" height="688" loading="lazy" decoding="async" />
              </div>
              <b>{w.title}</b>
              <span>{w.body}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ==================== 9. FINAL ==================== -->
    <section class="xb-scene xb-final" id="xb-final" data-scene="final">
      <div class="xb-final-inner">
        <h2 class="xb-final-title">Bipsy ya está<br />en tu iPhone.</h2>
        <p class="xb-final-sub">Bipsy para reservar y Bipsy Business para llevar tu negocio. En Android, en unas semanas.</p>
        <div class="xb-final-apps">
          <a href={BIPSY_STORE.client.appStore} class="xb-final-app" target="_blank" rel="noopener">
            <img src={icClient.src} alt="" width="44" height="44" />
            <span><b>Bipsy</b><small>Para reservar cita</small></span>
            <img src={badge.src} alt="Descárgalo en el App Store: Bipsy" class="xb-final-badge" width="135" height="40" loading="lazy" />
          </a>
          <a href={BIPSY_STORE.business.appStore} class="xb-final-app" target="_blank" rel="noopener">
            <img src={icBusiness.src} alt="" width="44" height="44" />
            <span><b>Bipsy Business</b><small>El primer mes, gratis</small></span>
            <img src={badge.src} alt="Descárgalo en el App Store: Bipsy Business" class="xb-final-badge" width="135" height="40" loading="lazy" />
          </a>
        </div>
        <div class="xb-final-links">
          <a href="/proyecto/bipsy" class="xb-btn">Ver la ficha del proyecto</a>
          <a href="/contacto" class="xb-btn xb-btn--mint">¿Quieres una app así? Hablemos</a>
        </div>
        <p class="xb-final-note">Bipsy es un producto de Giralabs: diseño, apps para iOS y Android, backend y publicación en las tiendas.</p>
      </div>
    </section>
  </div>
</Layout>

<script>
  type Pose = 'front' | 'back' | 'left' | 'right' | 'hello' | 'laughing' | 'recool' | 'pockets' | 'wave';
  /** Where Bip stands: feet at (x vw, y vh), at a scale of the base size. */
  interface State { x: number; y: number; s: number; pose: Pose; walk?: boolean }

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const smooth = (t: number) => t * t * (3 - 2 * t);
  const mix = (a: number, b: number, t: number) => a + (b - a) * t;

  function init() {
    const root = document.querySelector<HTMLElement>('[data-xb]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    const actor = root.querySelector<HTMLElement>('[data-actor]')!;
    const body = root.querySelector<HTMLElement>('[data-body]')!;
    const poseImgs = new Map(Array.from(body.querySelectorAll<HTMLImageElement>('[data-pose]')).map((img) => [img.dataset.pose as Pose, img]));
    const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-scene]'));
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const split = root.querySelector<HTMLElement>('[data-split]')!;
    const flow = root.querySelector<HTMLElement>('[data-flow]')!;
    const chip = root.querySelector<HTMLElement>('[data-chip]')!;
    const meet = root.querySelector<HTMLElement>('[data-meet]')!;
    const road = root.querySelector<HTMLElement>('[data-road]')!;
    const finalTitle = root.querySelector<HTMLElement>('.xb-final-title')!;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let vw = window.innerWidth;
    let vh = window.innerHeight;
    let mobile = vw < 760;
    let tops: number[] = [];
    let heights: number[] = [];
    let trackShift = 0;

    const measure = () => {
      vw = window.innerWidth;
      vh = window.innerHeight;
      mobile = vw < 760;
      tops = scenes.map((s) => s.getBoundingClientRect().top + window.scrollY);
      heights = scenes.map((s) => s.offsetHeight);
      trackShift = Math.max(0, track.scrollWidth - vw);
      const screensScene = root.querySelector<HTMLElement>('[data-scene="screens"]')!;
      screensScene.style.setProperty('--shift', `${trackShift}px`);
      // When the «Bipsy Business» card reaches the middle, night falls
      const splitAt = trackShift ? clamp((split.offsetLeft + split.offsetWidth / 2 - vw / 2) / trackShift) : 0.5;
      screensScene.style.setProperty('--split', splitAt.toFixed(3));
      actor.style.setProperty('--size', `${Math.min(vh * (mobile ? 0.62 : 0.86), vw * (mobile ? 1.1 : 0.7))}px`);
    };

    /** Progress through a scene: 0 when its top reaches the top, 1 when its end leaves the bottom. */
    const progressOf = (i: number, y: number) => {
      const span = heights[i] - vh;
      return span > 0 ? clamp((y - tops[i]) / span) : clamp((y - tops[i] + vh) / (heights[i] + vh));
    };

    // ---- Where Bip is in each scene --------------------------------------
    const S: Record<string, (p: number) => State> = {
      hero: (p) => ({ x: 50, y: mobile ? 98 : 99, s: mix(mobile ? 0.8 : 1, mobile ? 0.74 : 0.92, p), pose: 'front' }),
      why: (p) => (mobile
        ? { x: 80, y: 100, s: 0.5, pose: p < 0.5 ? 'recool' : 'hello' }
        : { x: 84, y: 98, s: 0.62, pose: p < 0.5 ? 'recool' : 'hello' }),
      screens: (p) => ({ x: mobile ? 14 : 9, y: 100, s: mobile ? 0.4 : 0.46, pose: p > 0.97 ? 'front' : 'right', walk: p > 0.01 && p < 0.97 }),
      flow: (p) => {
        const step = Math.min(3, Math.floor(p * 4));
        return { x: 50, y: 100, s: mobile ? 0.36 : 0.44, pose: step < 2 ? 'right' : step === 2 ? 'left' : 'laughing' };
      },
      apps: () => ({ x: mobile ? 104 : 97, y: 101, s: mobile ? 0.36 : 0.46, pose: 'left' }),
      meet: (p) => ({ x: mobile ? 50 : 62, y: mobile ? 98 : 99, s: mobile ? 0.86 : 1, pose: (['hello', 'recool', 'pockets', 'laughing'] as Pose[])[Math.min(3, Math.floor(p * 4))] }),
      road: (p) => {
        const walking = p > 0.02 && p < 0.98;
        return { x: mix(mobile ? 10 : 8, mobile ? 90 : 92, clamp((p - 0.02) / 0.96)), y: mobile ? 61 : 63, s: mobile ? 0.2 : 0.26, pose: walking ? 'right' : 'front', walk: walking };
      },
      webs: () => ({ x: mobile ? 104 : 97, y: 101, s: mobile ? 0.36 : 0.46, pose: 'left' }),
      // Standing on the closing title, wherever it ended up
      final: () => ({ x: 50, y: clamp((finalTitle.getBoundingClientRect().top + 6) / vh, 0.3, 0.9) * 100, s: mobile ? 0.44 : 0.42, pose: 'wave' }),
    };

    // ---- The intro: falls, lands, turns round and waves -------------------
    let introPose: Pose | null = still ? null : 'back';
    if (!still) {
      root.classList.add('is-landing');
      const at = (ms: number, pose: Pose | null) => window.setTimeout(() => { introPose = pose; kick(); }, ms);
      at(1150, 'right');
      at(1330, 'front');
      at(1520, 'wave');
      at(4300, null);
    }

    let current = window.scrollY;
    let target = current;
    let raf = 0;
    let shown: Pose | null = null;
    let walking = false;

    const setPose = (pose: Pose) => {
      if (pose === shown) return;
      poseImgs.forEach((img, name) => img.classList.toggle('is-on', name === pose));
      shown = pose;
    };

    const render = (y: number) => {
      // Scene progress, as a CSS variable on each scene
      const ps = scenes.map((s, i) => {
        const p = progressOf(i, y);
        s.style.setProperty('--p', p.toFixed(4));
        return p;
      });

      // Bip: the scene in charge, blended into the next one as it comes in
      let a = 0;
      for (let i = 0; i < scenes.length; i++) if (tops[i] <= y + 1) a = i;
      const nameA = scenes[a].dataset.scene!;
      let state = S[nameA](ps[a]);
      const b = a + 1;
      if (b < scenes.length) {
        const entering = clamp((y + vh - tops[b]) / vh);
        // Only once the scene in charge is done with Bip
        const free = heights[a] - vh <= 0 || ps[a] >= 0.999 || y + vh > tops[a] + heights[a];
        if (entering > 0 && free) {
          const t = smooth(entering);
          const next = S[scenes[b].dataset.scene!](0);
          state = { x: mix(state.x, next.x, t), y: mix(state.y, next.y, t), s: mix(state.s, next.s, t), pose: t < 0.5 ? state.pose : next.pose, walk: t < 0.5 ? state.walk : next.walk };
        }
      }
      if (introPose && nameA === 'hero' && ps[0] < 0.08) state = { ...state, pose: introPose };
      else if (introPose) introPose = null;

      actor.style.transform = `translate3d(${(state.x * vw) / 100}px, ${(state.y * vh) / 100}px, 0) scale(${state.s})`;
      setPose(state.pose);
      if (!!state.walk !== walking) {
        walking = !!state.walk;
        body.classList.toggle('is-walking', walking);
      }

      // ---- Scene details that are easier in JS -------------------------
      const pFlow = ps[scenes.findIndex((s) => s.dataset.scene === 'flow')];
      const step = Math.min(3, Math.floor(pFlow * 4));
      if (flow.dataset.step !== String(step)) flow.dataset.step = String(step);
      // The booking flies on an arc from the client phone to the business one
      const t = smooth(clamp((pFlow - 0.52) / 0.2));
      // Low arc, under the heading and the step text
      const from = { x: mobile ? 0.27 : 0.25, y: mobile ? 0.7 : 0.64 };
      const to = { x: mobile ? 0.73 : 0.75, y: mobile ? 0.6 : 0.5 };
      const cx = mix(from.x, to.x, t) * vw;
      const cy = mix(from.y, to.y, t) * vh - Math.sin(Math.PI * t) * vh * (mobile ? 0.06 : 0.1);
      chip.style.transform = `translate3d(${cx}px, ${cy}px, 0) translate(-50%, -50%) rotate(${Math.sin(Math.PI * t) * -8}deg) scale(${1 + Math.sin(Math.PI * t) * 0.15})`;
      chip.style.opacity = String(pFlow < 0.5 ? 0 : t >= 1 ? clamp(1 - (pFlow - 0.72) / 0.03) : clamp((pFlow - 0.5) / 0.02));

      const pMeet = ps[scenes.findIndex((s) => s.dataset.scene === 'meet')];
      const mStep = String(Math.min(3, Math.floor(pMeet * 4)));
      if (meet.dataset.step !== mStep) meet.dataset.step = mStep;

      const pRoad = ps[scenes.findIndex((s) => s.dataset.scene === 'road')];
      const rStep = String(Math.min(4, Math.floor(clamp((pRoad - 0.02) / 0.96) * 4 + 0.15)));
      if (road.dataset.step !== rStep) road.dataset.step = rStep;
    };

    const tick = () => {
      current += (target - current) * (still ? 1 : 0.13);
      if (Math.abs(target - current) < 0.4) current = target;
      render(current);
      raf = current === target ? 0 : requestAnimationFrame(tick);
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); else render(current); };

    window.addEventListener('scroll', () => { target = window.scrollY; kick(); }, { passive: true });
    window.addEventListener('resize', () => { measure(); target = window.scrollY; render(current); });

    // He looks towards the cursor
    window.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const actorX = new DOMMatrixReadOnly(getComputedStyle(actor).transform).m41;
      actor.style.setProperty('--look', clamp((e.clientX - actorX) / (vw * 0.5), -1, 1).toFixed(3));
    }, { passive: true });

    // Normal sections: things come in as they appear
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -12% 0px' });
    root.querySelectorAll('.xb-in').forEach((el) => io.observe(el));

    measure();
    render(current);
    // Images change the layout as they arrive
    window.addEventListener('load', () => { measure(); render(current); });
    requestAnimationFrame(() => root.classList.add('is-in'));
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>

<style>
  :global(html:has(.xb)),
  :global(body:has(.xb)) { background: #c9eed8; scroll-behavior: auto; }

  .xb {
    --ink: #0b0e10;
    --carbon: #23282e;
    --carbon-2: #2b3238;
    --mint: #c0ebd1;
    --mint-2: #8fdcb2;
    --mint-deep: #2f7552;
    --cloud: #f3f6f4;
    --p: 0;

    position: relative;
    color: var(--ink);
    font-family: 'Gilroy', 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ---------- Shared type ---------- */
  .xb-eyebrow {
    margin: 0 0 0.9rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mint-deep);
  }

  .xb-h2 {
    margin: 0;
    font-size: clamp(2.4rem, 5.4vw, 5.2rem);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .xb-sub {
    margin: 1.2rem 0 0;
    max-width: 46ch;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.55;
    color: rgba(11, 14, 16, 0.62);
  }

  /* Normal sections: rise in once */
  .xb-in { opacity: 0; transform: translateY(40px); transition: opacity 0.9s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .xb-in.is-visible { opacity: 1; transform: none; }

  /* ---------- Top bar ---------- */
  .xb-top { position: fixed; inset: 16px 16px auto; z-index: 60; display: flex; justify-content: space-between; pointer-events: none; }
  .xb-chip {
    pointer-events: auto;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 15px; border-radius: 100px;
    background: rgba(11, 14, 16, 0.6);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    color: #fff; font-size: 0.82rem; font-weight: 600; text-decoration: none;
    transition: background 0.2s ease;
  }
  .xb-chip:hover { background: rgba(11, 14, 16, 0.85); }

  /* ---------- Scenes ---------- */
  .xb-scene { position: relative; }
  .xb-pin { position: sticky; top: 0; height: 100svh; overflow: hidden; }

  /* ==================== BIP ==================== */
  .xb-actor {
    --size: 80vh;
    --look: 0;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) * -0.915) 0 0 calc(var(--size) * -0.5);
    transform-origin: 50% 91.5%;
    pointer-events: none;
    will-change: transform;
  }

  .xb-actor-land, .xb-actor-look, .xb-actor-body { position: absolute; inset: 0; transform-origin: 50% 91.5%; }

  .xb-actor-land { opacity: 0; }
  .xb.is-in .xb-actor-land { opacity: 1; }
  .xb.is-landing .xb-actor-land { animation: xbLand 1.25s both; }

  /* Falls with gravity, squashes on the ground, settles */
  @keyframes xbLand {
    0% { transform: translateY(-115vh) scale(0.96, 1.06); animation-timing-function: cubic-bezier(0.55, 0, 0.9, 0.5); }
    56% { transform: translateY(0) scale(0.96, 1.06); animation-timing-function: ease-out; }
    66% { transform: translateY(0) scale(1.12, 0.86); animation-timing-function: ease-in-out; }
    80% { transform: translateY(-5%) scale(0.97, 1.04); animation-timing-function: ease-in; }
    90% { transform: translateY(0) scale(1.03, 0.97); }
    100% { transform: none; }
  }

  .xb-actor-look {
    transform: rotate(calc(var(--look) * 3deg)) translateX(calc(var(--look) * 1.2%));
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Never quite still: he breathes and floats */
  .xb-actor-body { animation: xbIdle 3.8s ease-in-out infinite; }
  .xb-actor-body.is-walking { animation: xbWalk 0.52s ease-in-out infinite; }

  @keyframes xbIdle {
    0%, 100% { transform: translateY(0) scale(1, 1); }
    50% { transform: translateY(-1.6%) scale(1.01, 0.995); }
  }

  @keyframes xbWalk {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    25% { transform: translateY(-3.5%) rotate(0deg); }
    50% { transform: translateY(0) rotate(2deg); }
    75% { transform: translateY(-3.5%) rotate(0deg); }
  }

  .xb-pose {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    /* The old pose only leaves once the new one is fully in, on top of it,
       so a turn never shows Bip see-through */
    transition: opacity 0.12s linear 0.12s;
    filter: drop-shadow(0 30px 40px rgba(10, 40, 25, 0.18));
  }

  .xb-pose.is-on { opacity: 1; z-index: 1; transition-delay: 0s; }

  /* Its figure fills its frame: sized so the feet land where the others do */
  .xb-pose--wave { left: 50%; width: auto; height: 92.7%; inset: 0 auto auto 50%; transform: translateX(-50%); }

  .xb-shadow {
    position: absolute;
    left: 50%;
    top: 89%;
    width: 34%;
    height: 5%;
    border-radius: 50%;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(10, 30, 20, 0.28), transparent);
  }

  /* ==================== 1. HERO ==================== */
  .xb-hero { height: 170svh; background: linear-gradient(180deg, #dff5e8 0%, #c9eed8 55%, #b6e6ca 100%); }
  .xb-hero .xb-pin { background: radial-gradient(70vmax 60vmax at 50% 92%, rgba(255, 255, 255, 0.85), transparent 60%); }

  .xb-giant {
    position: absolute;
    inset: 9svh 0 auto;
    margin: 0;
    font-size: clamp(4rem, 15.5vw, 17rem);
    font-weight: 800;
    letter-spacing: -0.07em;
    line-height: 0.86;
    color: var(--carbon);
    pointer-events: none;
  }

  .xb-giant-line { display: block; overflow: hidden; padding: 0 3.5vw 0.08em; }
  .xb-br-m { display: none; }
  @media (max-width: 760px) { .xb-br-m { display: inline; } }
  .xb-giant-line > span { display: inline-block; transform: translateY(105%); transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1); }
  .xb-giant-line--b { text-align: right; color: var(--mint-deep); }
  .xb.is-in .xb-giant-line > span { transform: none; }
  .xb.is-in .xb-giant-line--b > span { transition-delay: 0.12s; }

  /* On scroll the two lines slide apart and Bip stays */
  .xb-giant-line--a { transform: translateX(calc(var(--p) * -28vw)); }
  .xb-giant-line--b { transform: translateX(calc(var(--p) * 28vw)); }
  .xb-hero .xb-giant { opacity: calc(1 - var(--p) * 1.4); }

  .xb-hero-copy {
    position: absolute;
    left: 3.5vw;
    bottom: 6svh;
    width: min(30vw, 420px);
    opacity: calc(1 - var(--p) * 3);
  }

  .xb-hero-lead { margin: 0; font-size: clamp(1rem, 1.3vw, 1.2rem); line-height: 1.55; font-weight: 600; color: rgba(11, 14, 16, 0.78); }

  .xb-hero-hint {
    display: flex; align-items: center; gap: 10px;
    margin: 1.4rem 0 0;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: rgba(11, 14, 16, 0.55);
  }

  .xb-hero-hint i { position: relative; width: 36px; height: 1px; overflow: hidden; background: rgba(11, 14, 16, 0.2); }
  .xb-hero-hint i::after { content: ''; position: absolute; inset: 0; background: var(--ink); transform: translateX(-100%); animation: xbLine 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
  @keyframes xbLine { to { transform: translateX(100%); } }

  .xb-hero-get {
    position: absolute;
    right: 3.5vw;
    bottom: 6svh;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    opacity: calc(1 - var(--p) * 3);
  }

  .xb-hero-get a {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 18px 10px 10px; border-radius: 18px;
    background: rgba(255, 255, 255, 0.7);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    color: var(--ink); text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .xb-hero-get a:hover { background: #fff; transform: translateY(-2px); }
  .xb-hero-get img { width: 40px; height: 40px; border-radius: 10px; }
  .xb-hero-get span { display: flex; flex-direction: column; line-height: 1.25; }
  .xb-hero-get b { font-size: 0.95rem; }
  .xb-hero-get small { font-size: 0.78rem; color: rgba(11, 14, 16, 0.55); }

  /* ==================== 2. WHY ==================== */
  .xb-why { height: 300svh; background: var(--carbon); color: #fff; }
  .xb-why .xb-pin { background: radial-gradient(60vmax 50vmax at 85% 100%, rgba(143, 220, 178, 0.14), transparent 60%), var(--carbon); }

  .xb-why-block {
    position: absolute;
    left: 6vw;
    top: 50%;
    width: min(64vw, 1000px);
    transform: translateY(-50%);
  }

  /* Each paragraph lights up word by word over its half of the scene */
  .xb-why-block--a { --q: clamp(0, calc((var(--p) - 0.04) / 0.38), 1); opacity: clamp(0, calc((0.52 - var(--p)) * 25), 1); }
  .xb-why-block--b { --q: clamp(0, calc((var(--p) - 0.54) / 0.38), 1); opacity: clamp(0, calc((var(--p) - 0.5) * 25), 1); }

  .xb-label { margin: 0 0 1.4rem; font-size: 0.82rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55); }
  .xb-label--mint { color: var(--mint-2); }

  .xb-reveal {
    margin: 0;
    font-size: clamp(1.7rem, 3.4vw, 3.3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.14;
  }

  .xb-reveal span { opacity: clamp(0.14, calc(var(--q) * (var(--n) + 3) - var(--i)), 1); }

  /* ==================== 3. SCREENS ==================== */
  .xb-screens { height: 620svh; }
  .xb-screens .xb-pin { background: linear-gradient(180deg, #d7f1e2, #c0ebd1); }

  .xb-screens-night {
    position: absolute;
    inset: 0;
    background: radial-gradient(70vmax 60vmax at 50% 100%, rgba(143, 220, 178, 0.12), transparent 60%), var(--carbon);
    opacity: clamp(0, calc((var(--p) - var(--split, 0.45) + 0.06) * 10), 1);
  }

  .xb-track {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 3.2vw;
    padding: 0 6vw 0 6vw;
    transform: translate3d(calc(var(--p) * var(--shift, 0px) * -1), 0, 0);
    will-change: transform;
  }

  .xb-track-intro { flex: 0 0 min(40vw, 560px); }
  .xb-track-split { flex: 0 0 min(36vw, 520px); color: #fff; padding-left: 2vw; }
  .xb-track-split .xb-eyebrow { color: var(--mint-2); }
  .xb-track-end { flex: 0 0 20vw; }

  .xb-shot { flex: 0 0 auto; margin: 0; display: flex; flex-direction: column; gap: 16px; width: calc(56svh * 900 / 1950 + 2.4svh); }
  .xb-shot figcaption { display: flex; flex-direction: column; gap: 4px; font-size: 0.92rem; line-height: 1.45; color: rgba(11, 14, 16, 0.62); }
  .xb-shot figcaption b { font-size: 1.05rem; color: var(--ink); }
  .xb-shot--biz figcaption { color: rgba(255, 255, 255, 0.6); }
  .xb-shot--biz figcaption b { color: #fff; }

  .xb-phone {
    position: relative;
    height: 56svh;
    aspect-ratio: 900 / 1950;
    padding: 1.1svh;
    border-radius: 4.6svh;
    background: #0d1012;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12), 0 40px 80px -30px rgba(10, 30, 20, 0.5);
  }

  .xb-phone img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 3.6svh; }

  /* ==================== 4. FLOW ==================== */
  .xb-flow { height: 420svh; }
  .xb-flow .xb-pin { background: linear-gradient(180deg, #f3f6f4, #e4efe8); }

  .xb-flow-head { position: absolute; left: 0; right: 0; top: 11svh; text-align: center; padding: 0 6vw; }

  .xb-flow-phone { position: absolute; top: 56%; margin: 0; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .xb-flow-phone--client { left: 25%; transform: translate(-50%, -50%) rotate(-4deg); }
  .xb-flow-phone--biz { left: 75%; transform: translate(-50%, -50%) rotate(4deg); }
  .xb-flow-phone .xb-phone { height: 50svh; }
  .xb-flow-phone .xb-phone img { position: absolute; inset: 1.1svh; width: calc(100% - 2.2svh); height: calc(100% - 2.2svh); opacity: 0; transition: opacity 0.4s ease; }
  .xb-flow-phone figcaption { font-size: 0.85rem; font-weight: 800; color: rgba(11, 14, 16, 0.5); }

  .xb-flow [data-step="0"] .xb-phone img[data-show~="0"],
  .xb-flow [data-step="1"] .xb-phone img[data-show~="1"],
  .xb-flow [data-step="2"] .xb-phone img[data-show~="2"],
  .xb-flow [data-step="3"] .xb-phone img[data-show~="3"] { opacity: 1; }

  /* The phone where things happen leans in */
  .xb-flow-phone { transition: filter 0.5s ease, opacity 0.5s ease; }
