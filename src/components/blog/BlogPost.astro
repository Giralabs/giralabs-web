---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import CTAContact from '../CTAContact.astro';

interface Props {
  post: any;
  posts: any[];
  lang: 'es' | 'en';
}

const { post, posts, lang } = Astro.props;
const { Content } = post;
const { title, description, date, tags = [], readingTime, image, slug } = post.frontmatter;
const headings = (post.getHeadings ? post.getHeadings() : []).filter((h: any) => h.depth === 2);

const L = {
  es: {
    locale: 'es-ES',
    home: 'Inicio',
    blogHref: '/blog',
    postHref: (s: string) => `/blog/${s}`,
    back: 'Blog',
    read: 'de lectura',
    contents: 'En este artículo',
    share: 'Compártelo',
    copy: 'Copiar enlace',
    copied: 'Enlace copiado',
    shareX: 'Compartir en X',
    shareIn: 'Compartir en LinkedIn',
    more: 'Sigue leyendo',
    progress: 'Progreso de lectura',
  },
  en: {
    locale: 'en-GB',
    home: 'Home',
    blogHref: '/en/blog',
    postHref: (s: string) => `/en/blog/${s}`,
    back: 'Blog',
    read: 'read',
    contents: 'In this article',
    share: 'Share it',
    copy: 'Copy link',
    copied: 'Link copied',
    shareX: 'Share on X',
    shareIn: 'Share on LinkedIn',
    more: 'Keep reading',
    progress: 'Reading progress',
  },
}[lang];

const fmt = (d: string) =>
  new Date(d).toLocaleDateString(L.locale, { year: 'numeric', month: 'long', day: 'numeric' });

const blogImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/blog/*', { eager: true });
const imageFor = (p: string | undefined) => {
  if (!p) return null;
  const key = '../../assets/blog/' + p.split('/').pop();
  return blogImages[key]?.default ?? null;
};
const cover = imageFor(image);

const url = `https://www.giralabs.es${L.postHref(slug)}`;

// The two most recent other posts, sharing a tag first when possible
const others = posts
  .filter((p) => p.frontmatter.slug !== slug)
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
const related = [
  ...others.filter((p) => (p.frontmatter.tags || []).some((t: string) => tags.includes(t))),
  ...others,
].filter((p, i, arr) => arr.indexOf(p) === i).slice(0, 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date,
  dateModified: date,
  inLanguage: lang,
  author: { '@type': 'Organization', name: 'Giralabs', url: 'https://www.giralabs.es' },
  publisher: {
    '@type': 'Organization',
    name: 'Giralabs',
    logo: { '@type': 'ImageObject', url: 'https://www.giralabs.es/favicon.svg' },
  },
  image: cover ? `https://www.giralabs.es${cover.src}` : 'https://www.giralabs.es/logo-email.avif',
  mainEntityOfPage: url,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: L.home, item: lang === 'es' ? 'https://www.giralabs.es' : 'https://www.giralabs.es/en' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `https://www.giralabs.es${L.blogHref}` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};
---

<Layout title={`${title.length > 48 ? title.slice(0, 47).trimEnd() + '…' : title} | Giralabs`} description={description} lang={lang}>
  <Navbar lang={lang} />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="bp-progress" role="progressbar" aria-label={L.progress} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <span class="bp-progress-bar"></span>
  </div>

  <main id="main-content" tabindex="-1" class="bp">
    <header class="bp-head">
      <a href={L.blogHref} class="bp-back lg lg-press">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        {L.back}
      </a>
      {tags[0] && <p class="bp-kicker">{tags[0]}</p>}
      <h1 class="bp-title">{title}</h1>
      <p class="bp-dek">{description}</p>
      <p class="bp-meta">
        <time datetime={date}>{fmt(date)}</time>, {readingTime} {L.read}
      </p>
    </header>

    {cover && (
      <figure class="bp-cover">
        <Image
          src={cover}
          alt=""
          widths={[640, 960, 1200]}
          sizes="(max-width: 1100px) calc(100vw - 32px), 1040px"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    )}

    <div class="bp-layout">
      {headings.length > 0 && (
        <nav class="bp-toc" aria-label={L.contents}>
          <details class="bp-toc-box lg" open>
            <summary>{L.contents}</summary>
            <ol>
              {headings.map((h: any) => (
                <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
              ))}
            </ol>
          </details>
        </nav>
      )}

      <article class="bp-body">
        <Content />

        <footer class="bp-share">
          <span class="bp-share-label">{L.share}</span>
          <div class="bp-share-actions">
            <button type="button" class="bp-chip lg lg-press" data-copy={url} data-copied={L.copied}>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" /><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /></svg>
              <span>{L.copy}</span>
            </button>
            <a class="bp-round lg lg-press" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer" aria-label={L.shareX}>
              <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" class="bp-fill"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
            </a>
            <a class="bp-round lg lg-press" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer" aria-label={L.shareIn}>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" /><path d="M2 9h4v12H2z" /><circle cx="4" cy="4" r="2" /></svg>
            </a>
          </div>
        </footer>
      </article>
    </div>

    {related.length > 0 && (
      <section class="bp-more" aria-labelledby="bp-more-title">
        <h2 id="bp-more-title" class="bp-more-title">{L.more}</h2>
        <div class="bp-more-grid">
          {related.map((p) => {
            const img = imageFor(p.frontmatter.image);
            return (
              <a href={L.postHref(p.frontmatter.slug)} class="bp-card lg lg-press">
                {img && <Image src={img} alt="" widths={[480, 720]} sizes="(max-width: 720px) 100vw, 500px" class="bp-card-img" />}
                <span class="bp-card-text">
                  <span class="bp-card-meta">{fmt(p.frontmatter.date)}</span>
                  <span class="bp-card-title">{p.frontmatter.title}</span>
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </main>

  <CTAContact lang={lang} />
  <Footer lang={lang} />
</Layout>

<script>
  // Reading progress: one transform write per frame
  const bar = document.querySelector<HTMLElement>('.bp-progress-bar');
  const meter = document.querySelector<HTMLElement>('.bp-progress');
  const body = document.querySelector<HTMLElement>('.bp-body');
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.bp-body h2[id]'));

  let frame = 0;
  const update = () => {
    frame = 0;
    if (!bar || !body) return;
    const r = body.getBoundingClientRect();
    const total = r.height - window.innerHeight * 0.6;
    const p = Math.min(Math.max(-r.top / Math.max(total, 1), 0), 1);
    bar.style.transform = `scaleX(${p})`;
    meter?.setAttribute('aria-valuenow', String(Math.round(p * 100)));
  };
  addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(update); }, { passive: true });
  addEventListener('resize', update, { passive: true });
  update();

  // Highlight the section being read in the contents list
  if (tocLinks.length && sections.length) {
    const spy = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        tocLinks.forEach((a) => {
          const on = a.dataset.toc === e.target.id;
          a.classList.toggle('is-current', on);
          if (on) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
        });
      }
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach((s) => spy.observe(s));
  }

  // On narrow screens the contents list starts collapsed
  const tocBox = document.querySelector<HTMLDetailsElement>('.bp-toc-box');
  if (tocBox && matchMedia('(max-width: 1179px)').matches) tocBox.open = false;

  // Copy link, with the confirmation announced in place of the label
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector('span');
    const original = label?.textContent ?? '';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy || location.href);
        if (label) label.textContent = btn.dataset.copied || original;
        btn.classList.add('is-done');
        setTimeout(() => {
          if (label) label.textContent = original;
          btn.classList.remove('is-done');
        }, 2000);
      } catch {}
    });
  });
</script>

<style>
  .bp-progress {
    position: fixed;
    inset: 0 0 auto;
    height: 3px;
    z-index: 1001;
    pointer-events: none;
  }
  .bp-progress-bar {
    display: block;
    height: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  .bp {
    position: relative;
    z-index: 1;
    padding: 7.5rem 16px 0;
  }

  /* ---------- Header ---------- */
  .bp-head {
    max-width: 720px;
    margin: 0 auto;
  }
  .bp-back {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 36px;
    padding: 0 0.95rem 0 0.7rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 2.4rem;
  }
  .bp-back svg,
  .bp-chip svg,
  .bp-round svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bp-round svg.bp-fill { fill: currentColor; stroke: none; }

  .bp-kicker {
    margin: 0 0 0.8rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #c2410c;
  }
  .bp-title {
    margin: 0;
    font-size: clamp(2rem, 4.6vw, 3.1rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--ink);
    text-wrap: balance;
  }
  .bp-dek {
    margin: 1.3rem 0 0;
    font-size: clamp(1.1rem, 1.8vw, 1.28rem);
    line-height: 1.5;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .bp-meta {
    margin: 1.4rem 0 0;
    font-size: 0.9rem;
    color: var(--ink-subtle);
  }

  /* ---------- Cover ---------- */
  .bp-cover {
    max-width: 1040px;
    margin: 3rem auto 0;
  }
  .bp-cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 28px;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6) inset, 0 24px 60px -24px rgba(0, 0, 0, 0.25);
  }

  /* ---------- Body + contents ---------- */
  .bp-layout {
    max-width: 720px;
    margin: 3.5rem auto 0;
  }

  .bp-toc { margin-bottom: 2.6rem; }
  .bp-toc-box {
    border-radius: 22px;
    padding: 0.2rem 1.2rem;
  }
  .bp-toc summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
  }
  .bp-toc summary::-webkit-details-marker { display: none; }
  .bp-toc summary::after {
    content: '';
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--ink-subtle);
    border-bottom: 2px solid var(--ink-subtle);
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.3s var(--ease-out);
  }
  .bp-toc details[open] summary::after { transform: rotate(-135deg) translateY(-2px); }
  .bp-toc ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .bp-toc a {
    display: block;
    padding: 0.42rem 0 0.42rem 0.9rem;
    border-left: 2px solid rgba(0, 0, 0, 0.08);
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .bp-toc a:hover { color: var(--ink); }
  .bp-toc a.is-current {
    color: var(--ink);
    font-weight: 600;
    border-left-color: var(--ink);
  }

  /* Wide screens: the contents list moves into the left margin and stays put */
  @media (min-width: 1180px) {
    .bp-layout {
      max-width: 1040px;
      display: grid;
      grid-template-columns: 220px minmax(0, 720px);
      justify-content: space-between;
      gap: 3rem;
    }
    .bp-toc { margin: 0; }
    .bp-toc-box {
      position: sticky;
      top: 104px;
      padding: 0;
      background: none;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .bp-toc-box::before,
    .bp-toc-box::after { display: none; }
    .bp-toc summary {
      pointer-events: none;
      min-height: 0;
      margin-bottom: 0.8rem;
      font-size: 0.86rem;
      color: var(--ink-subtle);
    }
    .bp-toc summary::after { display: none; }
  }

  /* ---------- Article typography ---------- */
  .bp-body {
    font-size: 1.125rem;
    line-height: 1.75;
    color: #1d1d1f;
  }
  .bp-body :global(p) { margin: 0 0 1.4em; text-wrap: pretty; }
  .bp-body :global(h2) {
    margin: 2.6em 0 0.7em;
    font-size: clamp(1.5rem, 2.6vw, 1.85rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: var(--ink);
    scroll-margin-top: 100px;
    text-wrap: balance;
  }
  .bp-body :global(h2:first-child) { margin-top: 0; }
  .bp-body :global(h3) {
    margin: 2em 0 0.5em;
    font-size: 1.22rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    font-weight: 650;
    color: var(--ink);
    scroll-margin-top: 100px;
  }
  .bp-body :global(strong) { font-weight: 650; color: var(--ink); }
  .bp-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: rgba(0, 0, 0, 0.25);
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1.5px;
  }
  .bp-body :global(a:hover) { text-decoration-color: currentColor; }
  .bp-body :global(ul),
  .bp-body :global(ol) {
    margin: 0 0 1.5em;
    padding-left: 1.4em;
  }
  .bp-body :global(li) { margin: 0.45em 0; padding-left: 0.2em; }
  .bp-body :global(ul li::marker) { color: var(--ink-subtle); }
  .bp-body :global(ol li::marker) { color: var(--ink-subtle); font-weight: 600; font-variant-numeric: tabular-nums; }

  /* ---------- Share ---------- */
  .bp-share {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.6rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  .bp-share-label { font-size: 0.95rem; font-weight: 600; color: var(--ink); }
  .bp-share-actions { display: flex; gap: 0.6rem; }
  .bp-chip,
  .bp-round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    height: 44px;
    border: 0;
    border-radius: 999px;
    color: var(--ink);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .bp-chip { padding: 0 1.1rem; }
  .bp-round { width: 44px; }
  .bp-chip.is-done { color: #1f7a44; }

  /* ---------- Keep reading ---------- */
  .bp-more {
    max-width: 1040px;
    margin: 6rem auto 5rem;
  }
  .bp-more-title {
    margin: 0 0 1.4rem;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .bp-more-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }
  .bp-card {
    display: flex;
    flex-direction: column;
    border-radius: 26px;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
  }
  .bp-card :global(.bp-card-img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .bp-card-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.1rem 1.3rem 1.4rem;
  }
  .bp-card-meta { font-size: 0.85rem; color: var(--ink-subtle); }
  .bp-card-title {
    font-size: 1.1rem;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  @media (max-width: 720px) {
    .bp { padding-top: 6.5rem; }
    .bp-cover { margin-top: 2.2rem; }
    .bp-cover :global(img) { border-radius: 20px; aspect-ratio: 3 / 2; }
    .bp-body { font-size: 1.06rem; }
    .bp-more-grid { grid-template-columns: 1fr; }
  }
</style>
