---
import { getImage } from 'astro:assets';
import { getLocalizedPath } from '../../lib/paths';
import { BIPSY_STORE } from '../../lib/bipsy-links';
import LaunchCarousel from '../bipsy/LaunchCarousel.astro';
import appStoreBadge from '../../assets/bipsy/badges/app-store-badge.webp';
import iconClient from '../../assets/bipsy/icons/bipsy-icon.webp';
import iconBusiness from '../../assets/bipsy/icons/bipsy-business-icon.webp';
// Symbol + name in mint, with the master's empty margins trimmed off
import bipsyMintWordmark from '../../assets/bipsy/derived/bipsy_combination_horizontal_mint_cropped.webp';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const isEs = lang !== 'en';

const [badge, icon1, icon2, wordmark] = await Promise.all([
  getImage({ src: appStoreBadge, width: 405, format: 'webp' }),
  getImage({ src: iconClient, width: 112, format: 'webp' }),
  getImage({ src: iconBusiness, width: 112, format: 'webp' }),
  getImage({ src: bipsyMintWordmark, width: 360, format: 'webp' }),
]);

const c = isEs
  ? {
      kicker: 'Nuestro nuevo proyecto',
      title: ['Bipsy ya está', 'en el App Store.'],
      sub: 'Nuestro propio producto, de la primera entrevista con un negocio a la publicación en la tienda.',
      lead: 'Dos apps que funcionan juntas: una para reservar cita en barberías, peluquerías y centros de estética, y otra para que el negocio lo gestione todo desde el móvil.',
      apps: [
        { key: 'client', name: 'Bipsy', audience: 'Para reservar cita', icon: icon1.src },
        { key: 'business', name: 'Bipsy Business', audience: 'Para gestionar tu negocio', icon: icon2.src },
      ],
      badgeAlt: 'Descárgalo en el App Store',
      android: 'En iPhone y iPad. Android llega a Google Play en unas semanas.',
      cta: 'Ver el proyecto',
    }
  : {
      kicker: 'Our new project',
      title: ['Bipsy is now', 'on the App Store.'],
      sub: 'Our own product, from the first interview with a venue to the store release.',
      lead: 'Two apps that work together: one to book at barbershops, hair salons and beauty studios, and one for the venue to run everything from the phone.',
      apps: [
        { key: 'client', name: 'Bipsy', audience: 'To book appointments', icon: icon1.src },
        { key: 'business', name: 'Bipsy Business', audience: 'To run your business', icon: icon2.src },
      ],
      badgeAlt: 'Download on the App Store',
      android: 'On iPhone and iPad. Android lands on Google Play in a few weeks.',
      cta: 'See the project',
    };
---

<!--
  "Our new project", right after the services. While it is on screen the whole
  page takes Bipsy's mint (a class on <html>, see the script); the headline
  rises in and the panel grows into place as they scroll in.
-->
<section class="bl" id="bipsy" aria-labelledby="bl-title" data-bipsy-launch>
  <header class="bl-head">
    <p class="bl-kicker">
      <img src={icon1.src} alt="" width="22" height="22" loading="lazy" decoding="async" />
      {c.kicker}
    </p>
    <h2 class="bl-title" id="bl-title">
      <span class="bl-line">{c.title[0]}</span>
      <span class="bl-line bl-line--accent">{c.title[1]}</span>
    </h2>
    <p class="bl-sub">{c.sub}</p>
  </header>

  <div class="bl-panel">
    <div class="bl-glow" aria-hidden="true"></div>

    <div class="bl-copy">
      <img src={wordmark.src} alt="Bipsy" class="bl-wordmark" width="180" height="50" loading="lazy" decoding="async" />
      <p class="bl-lead">{c.lead}</p>

      <ul class="bl-get" role="list">
        {c.apps.map((app) => (
          <li class="bl-get-row">
            <img src={app.icon} alt="" class="bl-get-icon" width="44" height="44" loading="lazy" decoding="async" />
            <span class="bl-get-app">
              <span class="bl-get-name">{app.name}</span>
              <span class="bl-get-audience">{app.audience}</span>
            </span>
            <a href={BIPSY_STORE[app.key as 'client' | 'business'].appStore} class="bl-store" target="_blank" rel="noopener">
              <img src={badge.src} alt={`${c.badgeAlt}: ${app.name}`} width="135" height="40" loading="lazy" decoding="async" />
            </a>
          </li>
        ))}
      </ul>
      <p class="bl-android">{c.android}</p>

      <a href={getLocalizedPath('/proyecto/bipsy', lang)} class="bl-cta">
        <span>{c.cta}</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <div class="bl-media">
      <LaunchCarousel lang={lang} instagram />
    </div>
  </div>
</section>

<script>
  // Bipsy's mint takes over the page while the launch is on screen, and the
  // carousel plays only then.
  function initBipsyLaunch() {
    const section = document.querySelector<HTMLElement>('[data-bipsy-launch]');
    if (!section || section.dataset.blReady === 'true' || !('IntersectionObserver' in window)) return;
    section.dataset.blReady = 'true';
    const carousel = section.querySelector<HTMLElement>('[data-launch-carousel]');

    new IntersectionObserver(
      ([entry]) => {
        const on = entry.isIntersecting;
        document.documentElement.classList.toggle('theme-bipsy', on);
        if (carousel) carousel.dataset.playing = on ? 'true' : 'false';
      },
      // "On screen" = its middle band is in view, so the tint does not flicker
      // at the edges of the section
      { rootMargin: '-30% 0px -30% 0px' }
    ).observe(section);
  }

  initBipsyLaunch();
  document.addEventListener('astro:after-swap', () => {
    document.documentElement.classList.remove('theme-bipsy');
    initBipsyLaunch();
  });
</script>

<style>
  /* ---------- The page in Bipsy's colours ---------- */
  :global(html body) {
    transition: background-color 0.9s ease;
  }

  :global(html.theme-bipsy body) {
    background-color: #d9eee1;
  }

  /* ---------- Section ---------- */
  .bl {
    --mint: #c0ebd1;
    --mint-deep: #2f7552;
    --carbon: #2e343b;

    position: relative;
    z-index: 1;
    padding: 6rem 1.5rem 8rem;
  }

  /* ---------- Headline above the panel ---------- */
  .bl-head {
    max-width: 1000px;
    margin: 0 auto 3.4rem;
    text-align: center;
  }

  .bl-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.4rem;
    padding: 0.4rem 0.95rem 0.4rem 0.45rem;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.7);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--carbon);
  }

  .bl-kicker img { width: 22px; height: 22px; border-radius: 6px; }

  .bl-title {
    margin: 0;
    font-size: clamp(2.8rem, 7.4vw, 6.4rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.98;
    color: #0d0d0f;
  }

  .bl-line { display: block; }
  .bl-line--accent { color: var(--mint-deep); }

  .bl-sub {
    max-width: 52ch;
    margin: 1.5rem auto 0;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.6);
  }

  /* ---------- Panel ---------- */
  .bl-panel {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 3.5rem;
    padding: 4.5rem 4.5rem 4.5rem 5rem;
    border-radius: 44px;
    background: var(--carbon);
    color: #fff;
    overflow: hidden;
    box-shadow: 0 50px 120px -40px rgba(20, 50, 35, 0.55);
  }

  .bl-glow {
    position: absolute;
    right: -10%;
    top: 50%;
    width: 820px;
    height: 820px;
    transform: translateY(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(192, 235, 209, 0.22) 0%, rgba(192, 235, 209, 0) 62%);
    pointer-events: none;
  }

  /* The headline rises line by line and the panel grows into place, tied to
     the scroll where scroll-driven animations exist */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bl-line {
        animation: blRise linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 30%;
      }
      .bl-line--accent { animation-range: entry 25% cover 38%; }

      .bl-panel {
        animation: blGrow linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 32%;
      }
    }
  }

  @keyframes blRise {
    from { transform: translateY(0.5em); opacity: 0; }
    to { transform: none; opacity: 1; }
  }

  @keyframes blGrow {
    from { transform: translateY(80px) scale(0.9); border-radius: 80px; }
    to { transform: none; border-radius: 44px; }
  }

  /* ---------- Copy ---------- */
  .bl-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .bl-wordmark { display: block; width: 150px; height: auto; }

  .bl-lead {
    margin: 1.6rem 0 0;
    max-width: 44ch;
    font-size: 1.08rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
  }

  .bl-get {
    list-style: none;
    width: 100%;
    max-width: 470px;
    margin: 2.2rem 0 0;
    padding: 0;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .bl-get-row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 0.9rem 0.85rem 0.85rem;
  }

  .bl-get-row + .bl-get-row { border-top: 1px solid rgba(255, 255, 255, 0.1); }

  .bl-get-icon {
    display: block;
    width: 44px;
    height: 44px;
    border-radius: 22.5%;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.14);
  }

  .bl-get-app { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .bl-get-name { font-size: 0.95rem; font-weight: 700; letter-spacing: -0.02em; }
  .bl-get-audience { font-size: 0.8rem; color: rgba(255, 255, 255, 0.55); }

  .bl-store { display: block; height: 40px; transition: opacity 0.2s ease; }
  .bl-store img { display: block; width: auto; height: 40px; border-radius: 8px; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.25); }
  .bl-store:hover { opacity: 0.85; }

  .bl-android { margin: 0.8rem 0 0; font-size: 0.82rem; color: rgba(255, 255, 255, 0.5); }

  .bl-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 2.2rem;
    padding: 0.9rem 1.6rem;
    border-radius: 100px;
    background: var(--mint);
    color: #16241c;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .bl-cta:hover { background: #d6f2e2; transform: translateY(-2px); }
  .bl-cta svg { transition: transform 0.25s ease; }
  .bl-cta:hover svg { transform: translateX(3px); }

  /* ---------- The Instagram post ---------- */
  .bl-media {
    position: relative;
    z-index: 1;
    width: min(100%, 430px);
    justify-self: center;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bl-media:hover { transform: translateY(-4px); }

  /* ---------- Responsive ---------- */
  @media (max-width: 980px) {
    .bl { padding: 4.5rem 1.2rem 6rem; }
    .bl-panel {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 3rem 2rem 3.4rem;
    }
    .bl-media { width: min(100%, 400px); }
  }

  @media (max-width: 560px) {
    .bl { padding: 3.5rem 0.8rem 5rem; }
    .bl-head { margin-bottom: 2.4rem; }
    .bl-panel { padding: 2.4rem 1.3rem 2.6rem; border-radius: 30px; }
    .bl-get-row { grid-template-columns: 40px minmax(0, 1fr); }
    .bl-get-icon { width: 40px; height: 40px; }
    .bl-get-row .bl-store { grid-column: 2; }
    .bl-cta { align-self: stretch; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bl-media, .bl-media:hover { transform: none; }
  }
</style>
