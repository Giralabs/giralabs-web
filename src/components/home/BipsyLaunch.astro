---
import { getImage } from 'astro:assets';
import { getLocalizedPath } from '../../lib/paths';
import { BIPSY_STORE } from '../../lib/bipsy-links';
import LaunchCarousel from '../bipsy/LaunchCarousel.astro';
import appStoreBadge from '../../assets/bipsy/badges/app-store-badge.webp';
import iconClient from '../../assets/bipsy/icons/bipsy-icon.webp';
import iconBusiness from '../../assets/bipsy/icons/bipsy-business-icon.webp';
import bipsyMintWordmark from '../../assets/bipsy/bipsy_brand/Combination Marks/combinationmark_mint_horizontal_nobackground.webp';
// Cut to its silhouette, so it can stand on the bottom edge of the panel
import bipHello from '../../assets/bipsy/poses/bip-hello.webp';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const isEs = lang !== 'en';

const [badge, icon1, icon2, wordmark, bip] = await Promise.all([
  getImage({ src: appStoreBadge, width: 405, format: 'webp' }),
  getImage({ src: iconClient, width: 112, format: 'webp' }),
  getImage({ src: iconBusiness, width: 112, format: 'webp' }),
  getImage({ src: bipsyMintWordmark, width: 360, format: 'webp' }),
  getImage({ src: bipHello, height: 420, format: 'webp' }),
]);

const c = isEs
  ? {
      kicker: 'Nuestro producto · Ya disponible',
      title: ['Bipsy ya está', 'en el App Store.'],
      lead: 'Dos apps que hemos diseñado y programado en Giralabs: una para reservar cita en barberías, peluquerías y centros de estética, y otra para que el negocio lo gestione todo desde el móvil.',
      apps: [
        { key: 'client', name: 'Bipsy', audience: 'Para reservar cita', icon: icon1.src },
        { key: 'business', name: 'Bipsy Business', audience: 'Para gestionar tu negocio', icon: icon2.src },
      ],
      badgeAlt: 'Descárgalo en el App Store',
      android: 'En iPhone y iPad. Android llega a Google Play en unas semanas.',
      cta: 'Ver el proyecto',
    }
  : {
      kicker: 'Our product · Out now',
      title: ['Bipsy is now', 'on the App Store.'],
      lead: 'Two apps we designed and built at Giralabs: one to book at barbershops, hair salons and beauty studios, and one for the venue to run everything from the phone.',
      apps: [
        { key: 'client', name: 'Bipsy', audience: 'To book appointments', icon: icon1.src },
        { key: 'business', name: 'Bipsy Business', audience: 'To run your business', icon: icon2.src },
      ],
      badgeAlt: 'Download on the App Store',
      android: 'On iPhone and iPad. Android lands on Google Play in a few weeks.',
      cta: 'See the project',
    };
---

<!--
  The App Store launch, right after the hero. While it is on screen the whole
  page takes Bipsy's mint (see the script: a class on <html>), and the panel
  grows into place as it scrolls in.
-->
<section class="bl" id="bipsy" aria-labelledby="bl-title" data-bipsy-launch>
  <div class="bl-panel">
    <div class="bl-glow" aria-hidden="true"></div>

    <div class="bl-copy">
      <img src={wordmark.src} alt="Bipsy" class="bl-wordmark" width="180" height="50" loading="lazy" decoding="async" />
      <p class="bl-kicker">{c.kicker}</p>
      <h2 class="bl-title" id="bl-title">
        <span>{c.title[0]}</span>
        <span class="bl-title-accent">{c.title[1]}</span>
      </h2>
      <p class="bl-lead">{c.lead}</p>

      <ul class="bl-get" role="list">
        {c.apps.map((app) => (
          <li class="bl-get-row">
            <img src={app.icon} alt="" class="bl-get-icon" width="44" height="44" loading="lazy" decoding="async" />
            <span class="bl-get-app">
              <span class="bl-get-name">{app.name}</span>
              <span class="bl-get-audience">{app.audience}</span>
            </span>
            <a href={BIPSY_STORE[app.key as 'client' | 'business'].appStore} class="bl-store" target="_blank" rel="noopener">
              <img src={badge.src} alt={`${c.badgeAlt}: ${app.name}`} width="135" height="40" loading="lazy" decoding="async" />
            </a>
          </li>
        ))}
      </ul>
      <p class="bl-android">{c.android}</p>

      <a href={getLocalizedPath('/proyecto/bipsy', lang)} class="bl-cta">
        <span>{c.cta}</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <div class="bl-media">
      <LaunchCarousel lang={lang} />
      <img src={bip.src} alt="" class="bl-bip" width={bip.attributes.width} height={bip.attributes.height} loading="lazy" decoding="async" aria-hidden="true" />
    </div>
  </div>
</section>

<script>
  // Bipsy's mint takes over the page while the launch is on screen, and the
  // carousel plays only then.
  function initBipsyLaunch() {
    const section = document.querySelector<HTMLElement>('[data-bipsy-launch]');
    if (!section || section.dataset.blReady === 'true' || !('IntersectionObserver' in window)) return;
    section.dataset.blReady = 'true';
    const carousel = section.querySelector<HTMLElement>('[data-launch-carousel]');

    new IntersectionObserver(
      ([entry]) => {
        const on = entry.isIntersecting;
        document.documentElement.classList.toggle('theme-bipsy', on);
        if (carousel) carousel.dataset.playing = on ? 'true' : 'false';
      },
      // "On screen" = its middle band is in view, so the tint does not flicker
      // at the edges of the section
      { rootMargin: '-35% 0px -35% 0px' }
    ).observe(section);
  }

  initBipsyLaunch();
  document.addEventListener('astro:after-swap', () => {
    document.documentElement.classList.remove('theme-bipsy');
    initBipsyLaunch();
  });
</script>

<style>
  /* ---------- The page in Bipsy's colours ---------- */
  :global(html body) {
    transition: background-color 0.9s ease;
  }

  :global(html.theme-bipsy body) {
    background-color: #dff0e6;
  }

  /* ---------- Section ---------- */
  .bl {
    position: relative;
    z-index: 1;
    padding: 2rem 1.5rem 7rem;
  }

  .bl-panel {
    --mint: #c0ebd1;
    --mint-ink: #a8e2c0;
    --carbon: #2e343b;

    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: 3rem;
    padding: 4.2rem 4rem 4.2rem 4.4rem;
    border-radius: 40px;
    background: var(--carbon);
    color: #fff;
    overflow: hidden;
    box-shadow: 0 40px 100px -30px rgba(25, 45, 35, 0.45);
  }

  /* Grows into place as it scrolls in (where scroll-driven animations exist) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bl-panel {
        animation: blGrow linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 35%;
      }
    }
  }

  @keyframes blGrow {
    from { transform: translateY(60px) scale(0.92); border-radius: 64px; opacity: 0.4; }
    to { transform: none; border-radius: 40px; opacity: 1; }
  }

  .bl-glow {
    position: absolute;
    top: -30%;
    right: -12%;
    width: 720px;
    height: 720px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(192, 235, 209, 0.16) 0%, rgba(192, 235, 209, 0) 65%);
    pointer-events: none;
  }

  /* ---------- Copy ---------- */
  .bl-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .bl-wordmark {
    display: block;
    width: 132px;
    height: auto;
  }

  .bl-kicker {
    margin: 1.8rem 0 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.55);
  }

  .bl-title {
    margin: 0;
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1.02;
  }

  .bl-title span { display: block; }
  .bl-title-accent { color: var(--mint); }

  .bl-lead {
    margin: 1.4rem 0 0;
    max-width: 46ch;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.68);
  }

  .bl-get {
    list-style: none;
    width: 100%;
    max-width: 460px;
    margin: 2rem 0 0;
    padding: 0;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .bl-get-row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 0.9rem 0.85rem 0.85rem;
  }

  .bl-get-row + .bl-get-row { border-top: 1px solid rgba(255, 255, 255, 0.1); }

  .bl-get-icon {
    display: block;
    width: 44px;
    height: 44px;
    border-radius: 22.5%;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.14);
  }

  .bl-get-app { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .bl-get-name { font-size: 0.95rem; font-weight: 700; letter-spacing: -0.02em; }
  .bl-get-audience { font-size: 0.8rem; color: rgba(255, 255, 255, 0.55); }

  .bl-store { display: block; height: 40px; transition: opacity 0.2s ease; }
  .bl-store img { display: block; width: auto; height: 40px; border-radius: 8px; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.25); }
  .bl-store:hover { opacity: 0.85; }

  .bl-android {
    margin: 0.8rem 0 0;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .bl-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 2rem;
    padding: 0.85rem 1.5rem;
    border-radius: 100px;
    background: var(--mint);
    color: #16241c;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .bl-cta:hover { background: #d6f2e2; transform: translateY(-2px); }
  .bl-cta svg { transition: transform 0.25s ease; }
  .bl-cta:hover svg { transform: translateX(3px); }

  /* ---------- Carousel + Bip ---------- */
  .bl-media {
    position: relative;
    z-index: 1;
    width: min(100%, 420px);
    justify-self: center;
  }

  /* The slides are carbon too: a thin rim keeps them apart from the panel */
  .bl-media :global(.lc-viewport) {
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.14),
      0 30px 70px rgba(0, 0, 0, 0.45);
  }

  /* Bip stands at the foot of the carousel, waving from the side */
  .bl-bip {
    position: absolute;
    left: -84px;
    bottom: -4.2rem;
    width: auto;
    height: 210px;
    filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.35));
    pointer-events: none;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 980px) {
    .bl-panel {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 3rem 2rem 4.5rem;
    }
    .bl-media { width: min(100%, 380px); }
    .bl-bip { left: -40px; height: 170px; bottom: -3.6rem; }
  }

  @media (max-width: 560px) {
    .bl { padding: 1rem 0.8rem 5rem; }
    .bl-panel { padding: 2.4rem 1.3rem 4rem; border-radius: 30px; }
    .bl-get-row { grid-template-columns: 40px minmax(0, 1fr); }
    .bl-get-icon { width: 40px; height: 40px; }
    .bl-get-row .bl-store { grid-column: 2; }
    .bl-cta { align-self: stretch; justify-content: center; }
    .bl-bip { left: -14px; height: 140px; bottom: -3rem; }
  }
</style>
