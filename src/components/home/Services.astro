---
import ServiceVisual from '../ServiceVisual.astro';
import { translations } from '../../i18n/translations';
import { getLocalizedPath } from '../../lib/paths';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const T = translations[lang];

const localizedPath = (path: string) => getLocalizedPath(path, lang);
---

<!-- ==================== SERVICES BENTO GRID ==================== -->
<section class="sd-section" id="services" aria-label="Services">
  <div class="sd-inner">

    <!-- Header -->
    <div class="sd-header reveal">
      <p class="sd-eyebrow" data-i18n="sd_eyebrow">{T.sd_eyebrow}</p>
      <h2 class="sd-title" data-i18n="sd_title" set:html={T.sd_title.replace('\n','<br>')}></h2>
    </div>

    <!-- Bento Grid (12 Columns) -->
    <div class="sd-grid reveal-stagger">

      <!-- CARD 01: Creación de aplicaciones móviles (Wide Left, Span 7) -->
      <a href={localizedPath("/servicio/aplicaciones-moviles")} class="sd-card sd-card--horiz" data-card="1">
        <div class="sd-card-border"></div>
        <div class="sd-card-content">
          <div class="sd-card-arrow">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </div>
          <div class="sd-card-text">
            <div class="sd-card-top">
              <span class="sd-tag" data-i18n="service_1_tag">{T.service_1_tag}</span>
            </div>
            <div class="sd-card-main">
              <h3 class="sd-card-title" data-i18n="service_1_title">{T.service_1_title}</h3>
              <p class="sd-card-desc" data-i18n="service_1_desc">{T.service_1_desc}</p>
            </div>
          </div>
          <div class="sd-card-visual visual-mobile-apps">
            <ServiceVisual kind="apps" lang={lang} theme="dark" />
          </div>
        </div>
      </a>

      <!-- CARD 02: Creación de páginas web (Narrow Right, Span 5) -->
      <a href={localizedPath("/servicio/paginas-web")} class="sd-card sd-card--vert" data-card="2">
        <div class="sd-card-border"></div>
        <div class="sd-card-content">
          <div class="sd-card-arrow">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </div>
          <div class="sd-card-visual visual-web-dev">
            <ServiceVisual kind="web" lang={lang} theme="dark" />
          </div>
          <div class="sd-card-text">
            <div class="sd-card-top">
              <span class="sd-tag" data-i18n="service_2_tag">{T.service_2_tag}</span>
            </div>
            <div class="sd-card-main">
              <h3 class="sd-card-title" data-i18n="service_2_title">{T.service_2_title}</h3>
              <p class="sd-card-desc" data-i18n="service_2_desc">{T.service_2_desc}</p>
            </div>
          </div>
        </div>
      </a>

      <!-- CARD 03: Digitalización de empresas y software a medida (Narrow Left, Span 5) -->
      <a href={localizedPath("/servicio/digitalizacion-empresas")} class="sd-card sd-card--vert" data-card="3">
        <div class="sd-card-border"></div>
        <div class="sd-card-content">
          <div class="sd-card-arrow">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </div>
          <div class="sd-card-visual visual-digitalization">
            <ServiceVisual kind="digital" lang={lang} theme="dark" />
          </div>
          <div class="sd-card-text">
            <div class="sd-card-top">
              <span class="sd-tag" data-i18n="service_3_tag">{T.service_3_tag}</span>
            </div>
            <div class="sd-card-main">
              <h3 class="sd-card-title" data-i18n="service_3_title">{T.service_3_title}</h3>
              <p class="sd-card-desc" data-i18n="service_3_desc">{T.service_3_desc}</p>
            </div>
          </div>
        </div>
      </a>

      <!-- CARD 04: Creación de tiendas online (Wide Right, Span 7) -->
      <a href={localizedPath("/servicio/tiendas-online")} class="sd-card sd-card--horiz" data-card="4">
        <div class="sd-card-border"></div>
        <div class="sd-card-content">
          <div class="sd-card-arrow">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </div>
          <div class="sd-card-text">
            <div class="sd-card-top">
              <span class="sd-tag" data-i18n="service_4_tag">{T.service_4_tag}</span>
            </div>
            <div class="sd-card-main">
              <h3 class="sd-card-title" data-i18n="service_4_title">{T.service_4_title}</h3>
              <p class="sd-card-desc" data-i18n="service_4_desc">{T.service_4_desc}</p>
            </div>
          </div>
          <div class="sd-card-visual visual-stores">
            <ServiceVisual kind="store" lang={lang} theme="dark" />
          </div>
        </div>
      </a>

      <!-- CARD 05: Creación de software personalizado (Equal Left, Span 6) -->
      <a href={localizedPath("/servicio/software-a-medida")} class="sd-card sd-card--vert" data-card="5">
        <div class="sd-card-border"></div>
        <div class="sd-card-content">
          <div class="sd-card-arrow">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </div>
          <div class="sd-card-visual visual-software">
            <ServiceVisual kind="software" lang={lang} theme="dark" />
          </div>
          <div class="sd-card-text">
            <div class="sd-card-top">
              <span class="sd-tag" data-i18n="service_5_tag">{T.service_5_tag}</span>
            </div>
            <div class="sd-card-main">
              <h3 class="sd-card-title" data-i18n="service_5_title">{T.service_5_title}</h3>
              <p class="sd-card-desc" data-i18n="service_5_desc">{T.service_5_desc}</p>
            </div>
          </div>
        </div>
      </a>

      <!-- CARD 06: Implementación de IA en las aplicaciones (Equal Right, Span 6) -->
      <a href={localizedPath("/servicio/integracion-ia")} class="sd-card sd-card--vert" data-card="6">
        <div class="sd-card-border"></div>
        <div class="sd-card-content">
          <div class="sd-card-arrow">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </div>
          <div class="sd-card-visual visual-ai">
            <ServiceVisual kind="ai" lang={lang} theme="dark" />
          </div>
          <div class="sd-card-text">
            <div class="sd-card-top">
              <span class="sd-tag" data-i18n="service_6_tag">{T.service_6_tag}</span>
            </div>
            <div class="sd-card-main">
              <h3 class="sd-card-title" data-i18n="service_6_title">{T.service_6_title}</h3>
              <p class="sd-card-desc" data-i18n="service_6_desc">{T.service_6_desc}</p>
            </div>
          </div>
        </div>
      </a>

    </div>

    <!-- Carousel hint: dot indicators + scroll arrows -->
    <div class="sd-carousel-controls" aria-hidden="true">
      <button class="sd-scroll-arrow sd-arrow-left" id="sd-arrow-left" aria-label="Anterior">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <div class="sd-dot-indicators" id="sd-dot-indicators">
        <button class="sd-dot active" data-index="0" aria-label="Servicio 1"></button>
        <button class="sd-dot" data-index="1" aria-label="Servicio 2"></button>
        <button class="sd-dot" data-index="2" aria-label="Servicio 3"></button>
        <button class="sd-dot" data-index="3" aria-label="Servicio 4"></button>
        <button class="sd-dot" data-index="4" aria-label="Servicio 5"></button>
        <button class="sd-dot" data-index="5" aria-label="Servicio 6"></button>
      </div>
      <button class="sd-scroll-arrow sd-arrow-right" id="sd-arrow-right" aria-label="Siguiente">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</section>

<!-- Scroll Reveal Activation, Spotlight tracking & Carousel Indicator -->
<script>
  function initScrollReveal() {
    const cards = document.querySelectorAll('.sd-card');

    // Spotlight mouse tracking. Skipped on touch devices, which never hover, and
    // batched into one write per frame: reading the rect straight after writing a
    // custom property forced a synchronous layout on every single mousemove.
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (finePointer) {
      let spotlightFrame = 0;
      let spotlightCard = null;
      let spotlightRect = null;
      let spotlightX = 0;
      let spotlightY = 0;

      const paintSpotlight = () => {
        spotlightFrame = 0;
        if (!spotlightCard || !spotlightRect) return;
        spotlightCard.style.setProperty('--mx', (spotlightX - spotlightRect.left) + 'px');
        spotlightCard.style.setProperty('--my', (spotlightY - spotlightRect.top) + 'px');
      };

      cards.forEach(card => {
        // Measured on entry rather than per move: the card cannot shift while the
        // pointer is travelling across it
        card.addEventListener('mouseenter', () => {
          spotlightCard = card;
          spotlightRect = card.getBoundingClientRect();
        }, { passive: true });

        card.addEventListener('mousemove', (e) => {
          spotlightX = e.clientX;
          spotlightY = e.clientY;
          if (spotlightCard !== card) {
            spotlightCard = card;
            spotlightRect = card.getBoundingClientRect();
          }
          if (!spotlightFrame) spotlightFrame = requestAnimationFrame(paintSpotlight);
        }, { passive: true });

        card.addEventListener('mouseleave', () => {
          if (spotlightCard === card) {
            spotlightCard = null;
            spotlightRect = null;
          }
        }, { passive: true });
      });
    }

    // IntersectionObserver to activate cards and sweep animations on scroll
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-active');
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -80px 0px'
    });

    cards.forEach(card => observer.observe(card));

    // Carousel dot indicators & arrow buttons
    const grid = document.querySelector('.sd-grid');
    const dots = document.querySelectorAll('.sd-dot');
    const arrowLeft = document.getElementById('sd-arrow-left');
    const arrowRight = document.getElementById('sd-arrow-right');

    // Same reasoning as above: cached instead of read per scroll event
    const carouselQuery = window.matchMedia('(max-width: 768px)');

    function getActiveDotIndex() {
      if (!grid) return 0;
      if (carouselQuery.matches) {
        // In mobile carousel mode: snap scroll, cards are visible one at a time
        const cardWidth = grid.scrollWidth / cards.length;
        return Math.round(grid.scrollLeft / cardWidth);
      } else {
        // Desktop bento grid: highlight based on which section is closest to
        // center-left. offsetLeft is a cached layout value, so this no longer
        // triggers a rect measurement per card on every scroll event.
        let closestIdx = 0;
        let closestDist = Infinity;
        cards.forEach((card, i) => {
          const dist = Math.abs(card.offsetLeft - grid.offsetLeft - grid.scrollLeft);
          if (dist < closestDist) { closestDist = dist; closestIdx = i; }
        });
        return closestIdx;
      }
    }

    let dotsFrame = 0;
    function updateDots() {
      dotsFrame = 0;
      const activeIdx = getActiveDotIndex();
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === activeIdx);
      });
    }

    // Scroll and resize both fire in bursts; one recalculation per frame is enough
    function scheduleUpdateDots() {
      if (dotsFrame) return;
      dotsFrame = requestAnimationFrame(updateDots);
    }

    function scrollToCard(index) {
      if (!grid) return;
      const isMobile = window.innerWidth <= 768;
      if (isMobile) {
        const cardWidth = grid.scrollWidth / cards.length;
        grid.scrollTo({ left: cardWidth * index, behavior: 'smooth' });
      }
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => scrollToCard(i));
    });

    if (arrowLeft && arrowRight && grid) {
      arrowLeft.addEventListener('click', () => {
        const isMobile = window.innerWidth <= 768;
        if (isMobile) {
          const cur = getActiveDotIndex();
          scrollToCard(Math.max(0, cur - 1));
        } else {
          grid.scrollBy({ left: -300, behavior: 'smooth' });
        }
      });
      arrowRight.addEventListener('click', () => {
        const isMobile = window.innerWidth <= 768;
        if (isMobile) {
          const cur = getActiveDotIndex();
          scrollToCard(Math.min(cards.length - 1, cur + 1));
        } else {
          grid.scrollBy({ left: 300, behavior: 'smooth' });
        }
      });
      grid.addEventListener('scroll', scheduleUpdateDots, { passive: true });
      window.addEventListener('resize', scheduleUpdateDots, { passive: true });
      updateDots();
    }
  }

  initScrollReveal();
  document.addEventListener('astro:after-swap', initScrollReveal);
</script>

<style>
  /* ========================================
     SERVICES SECTION GLOBAL & THEME SETUP
  ======================================== */
  .sd-section {
    position: relative;
    z-index: 2;
    background-color: #070709;
    padding: 8rem 2rem;
    margin-top: -2px;
    overflow: hidden;
  }

  /* Soft glowing radial gradient behind the section header */
  .sd-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.035) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .sd-inner {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .sd-header {
    margin-bottom: 4rem;
    text-align: left;
  }

  .sd-eyebrow {
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: rgba(255, 255, 255, 0.35);
    margin: 0 0 1.2rem;
  }

  .sd-title {
    font-size: clamp(1.8rem, 4.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.95);
    margin: 0;
    line-height: 1.25;
  }

  /* ========================================
     BENTO GRID SYSTEM (Desktop default)
  ======================================== */
  .sd-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 18px;
    width: 100%;
  }

  /* Layout columns for cards */
  .sd-card[data-card="1"] { grid-column: span 7; }
  .sd-card[data-card="2"] { grid-column: span 5; }
  .sd-card[data-card="3"] { grid-column: span 5; }
  .sd-card[data-card="4"] { grid-column: span 7; }
  .sd-card[data-card="5"] { grid-column: span 6; }
  .sd-card[data-card="6"] { grid-column: span 6; }

  /* ========================================
     CARD BASE STRUCTURE
  ======================================== */
  .sd-card {
    position: relative;
    background-color: #0c0c0e; /* Strong dark base */
    border-radius: 24px;
    overflow: hidden;
    transition: 
      background-color 0.4s ease, 
      transform 0.4s cubic-bezier(0.25, 1, 0.5, 1),
      box-shadow 0.4s ease;
    display: flex;
    text-decoration: none; /* Prevent underlines inside links */
    /* Dark glass edge: a lit top bevel, a faint full rim and a lower lip, the
       smoked counterpart of the clear Liquid Glass used on the light surfaces */
    box-shadow:
      inset 0 1px 0.5px rgba(255, 255, 255, 0.14),
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.08),
      inset 0 -1px 1px rgba(0, 0, 0, 0.6),
      0 10px 30px rgba(0, 0, 0, 0.5);
    --accent-color-1: #F0EFEA;
    --accent-rgb-1: 240, 239, 234;
    --accent-color-2: #8e8e93;
    --accent-rgb-2: 142, 142, 147;
  }

  .sd-card.is-active:hover {
    transform: translateY(-2px);
    background-color: #121215;
    box-shadow:
      inset 0 1px 0.5px rgba(255, 255, 255, 0.22),
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.12),
      inset 0 -1px 1px rgba(0, 0, 0, 0.6),
      0 15px 35px rgba(0, 0, 0, 0.6);
  }

  /* Minimalist Link Arrow */
  .sd-card-arrow {
    position: absolute;
    top: 1.8rem;
    right: 1.8rem;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    transition: 
      background-color 0.3s ease, 
      border-color 0.3s ease, 
      color 0.3s ease,
      transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .sd-card:hover .sd-card-arrow {
    background: rgba(var(--accent-rgb-1), 0.1);
    border-color: rgba(var(--accent-rgb-1), 0.3);
    color: var(--accent-color-1);
    transform: translate(2px, -2px) scale(1.05);
  }

  .sd-card--vert {
    flex-direction: column;
    min-height: 440px; /* Increased slightly to accommodate larger visuals */
  }

  .sd-card--horiz {
    flex-direction: row;
    min-height: 310px;
  }

  .sd-card-content {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: inherit;
    padding: 2.2rem;
    position: relative;
    z-index: 2;
  }

  .sd-card--vert .sd-card-content {
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
  }

  .sd-card--horiz .sd-card-content {
    flex-direction: row;
    align-items: center;
    gap: 2rem;
  }

  /* ----------------------------------------
     MINIMALIST BORDERS
  ---------------------------------------- */
  .sd-card-border {
    position: absolute;
    inset: 0;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    pointer-events: none;
    z-index: 3;
    transition: border-color 0.4s ease;
  }

  .sd-card:hover .sd-card-border {
    border-color: rgba(255, 255, 255, 0.15);
  }

  /* ========================================
     CARD DETAILS & TEXT
  ======================================== */
  .sd-card-text {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
  }

  .sd-card--horiz .sd-card-text {
    width: 55%;
    flex-shrink: 0;
  }

  .sd-card-top {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.5rem;
  }

  .sd-tag {
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.5);
  }

  .sd-card-main {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .sd-card-title {
    font-size: clamp(1.25rem, 2.5vw, 1.45rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0;
    line-height: 1.25;
  }

  .sd-card-desc {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
  }

  /* ========================================
     CARD VISUAL WRAPPERS (WIDGETS)
  ======================================== */
  .sd-card-visual {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sd-card--vert .sd-card-visual {
    width: 100%;
    margin-bottom: 2rem;
    height: 170px; /* Increased to 170px for extra visual height & breathing room */
  }

  .sd-card--horiz .sd-card-visual {
    width: 45%;
    height: 150px;
    justify-content: center;
  }

  /* Carousel Controls: dots + arrows */
  .sd-carousel-controls {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  .sd-dot-indicators {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sd-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.3s ease, width 0.3s ease;
    flex-shrink: 0;
    -webkit-appearance: none;
    appearance: none;
  }

  .sd-dot.active {
    background: rgba(255, 255, 255, 0.85);
    width: 22px;
    border-radius: 4px;
    transform: scale(1);
  }

  .sd-dot:hover:not(.active) {
    background: rgba(255, 255, 255, 0.4);
    transform: scale(1.2);
  }

  .sd-scroll-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
    -webkit-appearance: none;
    appearance: none;
    padding: 0;
  }

  .sd-scroll-arrow:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.85);
    transform: scale(1.08);
  }

  /* ========================================
     RESPONSIVE BREAKPOINTS
  ======================================== */
  @media (max-width: 960px) {
    .sd-grid {
      grid-template-columns: 1fr;
