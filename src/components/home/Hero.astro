---
import { Picture, getImage } from "astro:assets";
import { translations } from "../../i18n/translations";
// The combination mark is rebuilt from its parts so each one can move on its
// own: the capsule cut at its seam into two halves, plus the wordmark on top.
// Layout percentages below were measured against the original artwork.
import capsuleTop from "../../assets/brand_marks/derived/capsule_half_top.webp";
import capsuleBottom from "../../assets/brand_marks/derived/capsule_half_bottom.webp";
import capsuleWhole from "../../assets/brand_marks/derived/capsule.webp";
import wordmark from "../../assets/brand_marks/derived/wordmark_black.webp";
import { getLocalizedPath } from "../../lib/paths";

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;
const T = translations[lang];

// Helper to localize paths based on the current lang
const localizedPath = (path: string) => getLocalizedPath(path, lang);

// Silhouette for the glint, so the light only ever lands on the glass
const capsuleMask = await getImage({ src: capsuleWhole, width: 480, format: "webp" });
const capsuleSizes = "(max-width: 580px) 200px, (max-width: 920px) 34vw, 315px";
---

<!-- ==================== HERO ==================== -->
<section class="hero" id="hero" aria-label="Hero">
  <div class="hero-inner">
    <!-- Center: combination mark (vertical) animated -->
    <div class="hero-mark-wrap">
      <div class="hero-mark-glow" aria-hidden="true"></div>
      <div class="hero-mark-entrance">
        {/* LCP element: eager + high priority, and sized to the clamp() below so
            the browser stops fetching a 2000px master for a 315px slot. */}
        <div
          class="hero-mark"
          role="img"
          aria-label="Giralabs - Estudio de desarrollo de aplicaciones móviles y desarrollo de software a medida"
        >
          <div class="hm-capsule" style={`--hm-mask: url(${capsuleMask.src})`}>
            <Picture src={capsuleTop} formats={["avif", "webp"]} fallbackFormat="webp" widths={[200, 315, 630]} sizes={capsuleSizes} alt="" class="hm-half hm-half--top" loading="eager" fetchpriority="high" />
            <Picture src={capsuleBottom} formats={["avif", "webp"]} fallbackFormat="webp" widths={[200, 315, 630]} sizes={capsuleSizes} alt="" class="hm-half hm-half--bottom" loading="eager" fetchpriority="high" />
            <span class="hm-glint" aria-hidden="true"><i></i></span>
          </div>
          <Picture
            src={wordmark}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={[275, 435, 870]}
            sizes="(max-width: 580px) 275px, (max-width: 920px) 48vw, 435px"
            alt=""
            class="hm-word"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>

    <!-- Divider line -->
    <div class="hero-line" aria-hidden="true"></div>

    <!-- Tagline -->
    <h1
      class="hero-tagline"
      data-i18n="hero_tagline"
      set:html={T.hero_tagline}
    />

    <!-- Sub -->
    <p class="hero-sub" data-i18n="hero_sub">{T.hero_sub}</p>

    <!-- CTAs -->
    <div class="hero-ctas">
      <a
        href={localizedPath("/proyectos")}
        class="cta-primary lg-press"
        id="hero-cta-primary"
        data-i18n="hero_cta_primary">{T.hero_cta_primary}</a
      >
      <a
        href={localizedPath("/servicios")}
        class="cta-secondary lg lg-press"
        id="hero-cta-secondary"
        data-i18n="hero_cta_secondary">{T.hero_cta_secondary}</a
      >
    </div>

    <!-- Scroll hint -->
    <div class="scroll-hint" aria-hidden="true">
      <div class="scroll-dot"></div>
    </div>
  </div>
</section>

<style>
  /* ========================================
     HERO
  ======================================== */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
    padding: 6rem 2rem 4rem;
  }

  .hero-inner {
    max-width: 680px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Combination mark */
  .hero-mark-glow {
    position: absolute;
    width: 620px;
    height: 420px;
    background:
      radial-gradient(
        circle at 30% 30%,
        rgba(255, 200, 160, 0.4) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 70% 60%,
        rgba(255, 170, 130, 0.25) 0%,
        transparent 60%
      ),
      radial-gradient(
        circle at 50% 50%,
        rgba(255, 230, 200, 0.5) 0%,
        transparent 70%
      );
    filter: blur(40px);
    z-index: 1;
    opacity: 0.8;
    mix-blend-mode: plus-lighter;
    animation: liquidGlow 12s ease-in-out infinite alternate;
    pointer-events: none;
    /* Runs forever: keep the blurred gradient cached as a compositor texture
       instead of re-rasterising it each frame */
    will-change: transform;
  }

  .hero-mark-entrance {
    opacity: 0;
    animation: markEntrance 1.6s cubic-bezier(0.65, 0, 0.35, 1) 0.3s forwards;
    position: relative;
    z-index: 2;
    transform-style: preserve-3d;
  }

  /* <picture> must stay out of the box model so the clamp() below still sizes
     the image itself */
  .hero-mark-entrance picture {
    display: contents;
  }

  /* The mark keeps the original artwork's 1849x1384 frame; every layer is
     placed in percentages of it */
  .hero-mark {
    position: relative;
    width: clamp(290px, 50vw, 460px);
    aspect-ratio: 1849 / 1384;
  }

  .hm-capsule {
    position: absolute;
    left: 13.98%;
    top: -0.69%;
    width: 69.18%;
    height: 97.05%;
    transform: rotate(4.1deg);
  }

  .hero-mark :global(.hm-half) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mix-blend-mode: multiply;
    animation: hmTop 7s cubic-bezier(0.45, 0, 0.25, 1) 2.2s infinite;
  }

  .hero-mark :global(.hm-half--bottom) {
    animation-name: hmBottom;
  }

  /* A beam of light runs across the glass when the halves click shut. The mask
     is the capsule's own silhouette, so the light never spills onto the page */
  .hm-glint {
    position: absolute;
    inset: 0;
    overflow: hidden;
    -webkit-mask: var(--hm-mask) center / 100% 100% no-repeat;
    mask: var(--hm-mask) center / 100% 100% no-repeat;
    mix-blend-mode: plus-lighter;
    pointer-events: none;
  }

  .hm-glint i {
    position: absolute;
    top: -25%;
    bottom: -25%;
    left: 0;
    width: 28%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.75), transparent);
    transform: translateX(-130%) rotate(18deg);
    animation: hmGlint 7s ease-in-out 2.2s infinite;
  }

  .hero-mark :global(.hm-word) {
    position: absolute;
    left: 2.52%;
    top: 33.06%;
    width: 95.66%;
    height: auto;
  }

  /* The halves part along the capsule's axis (48 degrees in its own frame),
     hold for a beat, then snap back together with a small overshoot */
  @keyframes hmTop {
    0%, 52% { transform: none; }
    62%, 70% { transform: translate(-4.7px, -5.2px); }
    75% { transform: translate(0.8px, 0.9px); }
    80%, 100% { transform: none; }
  }

  @keyframes hmBottom {
    0%, 52% { transform: none; }
    62%, 70% { transform: translate(4.7px, 5.2px); }
    75% { transform: translate(-0.8px, -0.9px); }
    80%, 100% { transform: none; }
  }

  @keyframes hmGlint {
    0%, 74% { transform: translateX(-130%) rotate(18deg); }
    92%, 100% { transform: translateX(420%) rotate(18deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mark :global(.hm-half),
    .hm-glint i {
      animation: none;
    }
  }

  .hero-mark-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 3rem;
    transform-style: preserve-3d;
    perspective: 1000px;
  }

  /* Hero line */
  .hero-line {
    position: relative;
    width: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 0, 0, 0.12) 20%,
      rgba(0, 0, 0, 0.12) 80%,
      transparent
    );
    margin-bottom: 2.2rem;
    animation: expandLine 1.2s cubic-bezier(0.25, 1, 0.5, 1) 0.7s forwards;
    overflow: hidden;
  }

  /* Tagline */
  .hero-tagline {
    font-size: clamp(1.25rem, 2.8vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: #111;
    margin: 0 0 0.85rem;
    max-width: 520px;
    opacity: 0;
    animation: fadeInUp 1s cubic-bezier(0.25, 1, 0.5, 1) 0.9s forwards;
  }

  /* Sub */
  .hero-sub {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--ink-muted);
    max-width: 440px;
    margin: 0 0 2.5rem;
    opacity: 0;
    animation: fadeInUp 1s cubic-bezier(0.25, 1, 0.5, 1) 1.05s forwards;
    font-weight: 400;
  }

  /* CTAs */
  .hero-ctas {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    justify-content: center;
    opacity: 0;
    animation: fadeInUp 1s cubic-bezier(0.25, 1, 0.5, 1) 1.2s forwards;
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.7rem;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 100px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    cursor: pointer;
    color: #1a1a1a;

    /* Liquid Glass (.lg) supplies the material; the button only tunes it */
    --lg-light-size: 120px;
    transition:
      transform 0.45s var(--ease-spring),
      box-shadow 0.3s ease,
      color 0.2s ease;
  }

  .cta-secondary:hover {
    color: #000;
    transform: translateY(-2px) scale(1.02);
    --lg-tint-top: rgba(255, 255, 255, 0.75);
    --lg-tint-bottom: rgba(255, 255, 255, 0.4);
  }

  .cta-secondary:active {
    transform: scale(0.965);
  }

  /* Scroll hint */
  .scroll-hint {
    margin-top: 3.5rem;
    display: flex;
    justify-content: center;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 1.8s forwards;
  }

  .scroll-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #9a9a9a;
    animation: scrollBounce 2.2s ease-in-out infinite;
  }

  /* ========================================
     KEYFRAMES
  ======================================== */
  @keyframes markEntrance {
    0% {
      opacity: 0;
      filter: brightness(2.5) blur(6px);
      transform: scale(1.04);
    }
    25% {
      opacity: 1;
      filter: brightness(1.2) blur(0);
    }
    100% {
      opacity: 1;
      filter: brightness(1) blur(0);
      transform: scale(1);
    }
  }

  @keyframes markBreath {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.009);
    }
  }

  @keyframes markGlowPulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 0.85;
      transform: scale(1.08);
    }
  }

  @keyframes expandLine {
    to {
      width: 160px;
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  @keyframes scrollBounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(8px);
      opacity: 0.35;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 5rem 1.5rem 3rem;
    }
  }

  /* Accent words: one solid colour that passes AA on the paper background */
  :global(.gradient-text) {
    color: #c2410c;
    font-weight: 700;
  }

  /* Laser line shimmer */
  .hero-line::after {
    content: "";
    position: absolute;
    top: 0;
    /* Anchored at 0 so the keyframes below can express the whole travel as a
       transform; the offset now lives in translateX percentages of this box */
    left: 0;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 138, 101, 0.5),
      transparent
    );
    animation: lineShimmer 3s ease-in-out infinite;
    animation-delay: 2s;
  }

  /* Driven by transform rather than `left`. Animating an offset property runs
     layout on every frame for as long as the animation lives, and this one never
     ends, so the main thread never went idle on the homepage. The travel is the
     same: the element starts at left:0 and moves across its own 50%-wide box. */
  @keyframes lineShimmer {
    0% {
      transform: translateX(-200%);
    }
    100% {
      transform: translateX(300%);
    }
  }

  /* The blur radius used to be keyframed 40 -> 45 -> 35 -> 40px, which forced a
     fresh gaussian pass over the whole 620x420 glow on every frame, forever,
     right where the hero paints. The radius now stays at the 40px set on the
     element and only the transform animates, so the same motion runs entirely on
     the compositor. Under a gradient this soft the 5px wobble was not visible. */
  @keyframes liquidGlow {
    0% {
      transform: translate(0, 0) scale(1) rotate(0deg);
    }
    33% {
      transform: translate(15px, -10px) scale(1.05) rotate(120deg);
    }
    66% {
      transform: translate(-10px, 15px) scale(0.95) rotate(240deg);
    }
    100% {
      transform: translate(0, 0) scale(1) rotate(360deg);
    }
  }
</style>
