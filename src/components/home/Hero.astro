---
import { Picture } from "astro:assets";
import { translations } from "../../i18n/translations";
import combinationMark from "../../assets/combination_marks/combinationmark_apricot_vertical_nobackground.avif";
import { getLocalizedPath } from "../../lib/paths";

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;
const T = translations[lang];

// Helper to localize paths based on the current lang
const localizedPath = (path: string) => getLocalizedPath(path, lang);
---

<!-- ==================== HERO ==================== -->
<section class="hero" id="hero" aria-label="Hero">
  <div class="hero-inner">
    <!-- Center: combination mark (vertical) animated -->
    <div class="hero-mark-wrap">
      <div class="hero-mark-glow" aria-hidden="true"></div>
      <div class="hero-mark-entrance">
        {/* LCP element: eager + high priority, and sized to the clamp() below so
            the browser stops fetching a 1849px master for a 460px slot. */}
        <Picture
          src={combinationMark}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[290, 460, 580, 920]}
          sizes="(max-width: 580px) 290px, (max-width: 920px) 50vw, 460px"
          alt="Giralabs - Estudio de desarrollo de aplicaciones móviles y desarrollo de software a medida"
          class="hero-combination-mark"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </div>
    </div>

    <!-- Divider line -->
    <div class="hero-line" aria-hidden="true"></div>

    <!-- Tagline -->
    <h1
      class="hero-tagline"
      data-i18n="hero_tagline"
      set:html={T.hero_tagline}
    />

    <!-- Sub -->
    <p class="hero-sub" data-i18n="hero_sub">{T.hero_sub}</p>

    <!-- CTAs -->
    <div class="hero-ctas">
      <a
        href={localizedPath("/proyectos")}
        class="cta-primary"
        id="hero-cta-primary"
        data-i18n="hero_cta_primary">{T.hero_cta_primary}</a
      >
      <a
        href={localizedPath("/servicios")}
        class="cta-secondary"
        id="hero-cta-secondary"
        data-i18n="hero_cta_secondary">{T.hero_cta_secondary}</a
      >
    </div>

    <!-- Scroll hint -->
    <div class="scroll-hint" aria-hidden="true">
      <div class="scroll-dot"></div>
    </div>
  </div>
</section>

<style>
  /* ========================================
     HERO
  ======================================== */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
    padding: 6rem 2rem 4rem;
  }

  .hero-inner {
    max-width: 680px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Combination mark */
  .hero-mark-glow {
    position: absolute;
    width: 620px;
    height: 420px;
    background:
      radial-gradient(
        circle at 30% 30%,
        rgba(255, 200, 160, 0.4) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 70% 60%,
        rgba(255, 170, 130, 0.25) 0%,
        transparent 60%
      ),
      radial-gradient(
        circle at 50% 50%,
        rgba(255, 230, 200, 0.5) 0%,
        transparent 70%
      );
    filter: blur(40px);
    z-index: 1;
    opacity: 0.8;
    mix-blend-mode: plus-lighter;
    animation: liquidGlow 12s ease-in-out infinite alternate;
    pointer-events: none;
    transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    /* Runs forever: keep the blurred gradient cached as a compositor texture
       instead of re-rasterising it each frame */
    will-change: transform;
  }

  .hero-mark-entrance {
    opacity: 0;
    animation: markEntrance 1.6s cubic-bezier(0.65, 0, 0.35, 1) 0.3s forwards;
    position: relative;
    z-index: 2;
    transform-style: preserve-3d;
  }

  /* <picture> must stay out of the box model so the clamp() below still sizes
     the image itself */
  .hero-mark-entrance picture {
    display: contents;
  }

  .hero-combination-mark {
    width: clamp(290px, 50vw, 460px);
    height: auto;
    display: block;
    mix-blend-mode: multiply;
    transform-origin: center center;
    transform: translateZ(40px);
  }

  .hero-mark-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 3rem;
    transform-style: preserve-3d;
    perspective: 1000px;
    transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hero-mark-wrap::after {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgba(255, 255, 255, 0.22) 50%,
      transparent 70%
    );
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 3;
  }

  .hero-mark-wrap:hover::after {
    opacity: 1;
    animation: markShimmer 0.9s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Hero line */
  .hero-line {
    position: relative;
    width: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 0, 0, 0.12) 20%,
      rgba(0, 0, 0, 0.12) 80%,
      transparent
    );
    margin-bottom: 2.2rem;
    animation: expandLine 1.2s cubic-bezier(0.25, 1, 0.5, 1) 0.7s forwards;
    overflow: hidden;
  }

  /* Tagline */
  .hero-tagline {
    font-size: clamp(1.25rem, 2.8vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: #111;
    margin: 0 0 0.85rem;
    max-width: 520px;
    opacity: 0;
    animation: fadeInUp 1s cubic-bezier(0.25, 1, 0.5, 1) 0.9s forwards;
  }

  /* Sub */
  .hero-sub {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #777;
    max-width: 440px;
    margin: 0 0 2.5rem;
    opacity: 0;
    animation: fadeInUp 1s cubic-bezier(0.25, 1, 0.5, 1) 1.05s forwards;
    font-weight: 400;
  }

  /* CTAs */
  .hero-ctas {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    justify-content: center;
    opacity: 0;
    animation: fadeInUp 1s cubic-bezier(0.25, 1, 0.5, 1) 1.2s forwards;
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.7rem;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 100px;
    letter-spacing: -0.01em;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      color 0.22s ease,
      transform 0.2s ease,
      box-shadow 0.25s ease;
    white-space: nowrap;
    cursor: pointer;

    /* iOS-like Liquid Glassmorphism on light background */
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    color: #333;
    border: 1px solid rgba(0, 0, 0, 0.09);
    box-shadow:
      0 2px 12px rgba(0, 0, 0, 0.04),
      0 1px 0 rgba(255, 255, 255, 0.7) inset;
  }

  .cta-secondary:hover {
    background: rgba(255, 255, 255, 0.65);
    border-color: rgba(0, 0, 0, 0.16);
    color: #000;
    transform: translateY(-2px);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.08),
      0 1px 0 rgba(255, 255, 255, 0.9) inset;
  }

  /* Scroll hint */
  .scroll-hint {
    margin-top: 3.5rem;
    display: flex;
    justify-content: center;
    opacity: 0;
    animation: fadeIn 1.2s ease-out 1.8s forwards;
  }

  .scroll-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #c5c5c5;
    animation: scrollBounce 2.2s ease-in-out infinite;
  }

  /* ========================================
     KEYFRAMES
  ======================================== */
  @keyframes markEntrance {
    0% {
      opacity: 0;
      filter: brightness(2.5) blur(6px);
      transform: scale(1.04);
    }
    25% {
      opacity: 1;
      filter: brightness(1.2) blur(0);
    }
    100% {
      opacity: 1;
      filter: brightness(1) blur(0);
      transform: scale(1);
    }
  }

  @keyframes markBreath {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.009);
    }
  }

  @keyframes markGlowPulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 0.85;
      transform: scale(1.08);
    }
  }

  @keyframes markShimmer {
    0% {
      left: -100%;
    }
    100% {
      left: 150%;
    }
  }

  @keyframes expandLine {
    to {
      width: 160px;
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  @keyframes scrollBounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(8px);
      opacity: 0.35;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 5rem 1.5rem 3rem;
    }
  }

  /* Gradient text */
  :global(.gradient-text) {
    background: linear-gradient(135deg, #ff8a65 0%, #ffb74d 50%, #ff7043 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 700;
  }

  /* Laser line shimmer */
  .hero-line::after {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 138, 101, 0.5),
      transparent
    );
    animation: lineShimmer 3s ease-in-out infinite;
    animation-delay: 2s;
  }

  @keyframes lineShimmer {
    0% {
      left: -100%;
    }
    100% {
      left: 150%;
    }
  }

  /* The blur radius used to be keyframed 40 -> 45 -> 35 -> 40px, which forced a
     fresh gaussian pass over the whole 620x420 glow on every frame, forever,
     right where the hero paints. The radius now stays at the 40px set on the
     element and only the transform animates, so the same motion runs entirely on
     the compositor. Under a gradient this soft the 5px wobble was not visible. */
  @keyframes liquidGlow {
    0% {
      transform: translate(0, 0) scale(1) rotate(0deg);
    }
    33% {
      transform: translate(15px, -10px) scale(1.05) rotate(120deg);
    }
    66% {
      transform: translate(-10px, 15px) scale(0.95) rotate(240deg);
    }
    100% {
      transform: translate(0, 0) scale(1) rotate(360deg);
    }
  }
</style>

<!-- ==================== 3D INTERACTIVE SCRIPT ==================== -->
<script>
  const hero = document.getElementById("hero");
  const card = hero ? hero.querySelector(".hero-mark-wrap") : (null as any);
  const glow = hero ? hero.querySelector(".hero-mark-glow") : (null as any);

  // A coarse pointer never produces the hover this effect is built on, so phones
  // and tablets skip the listeners entirely.
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (hero && card && finePointer) {
    // Pointer position is sampled on every mousemove but written once per frame:
    // mousemove can fire faster than the display refreshes, and each write
    // followed by the next getBoundingClientRect() forced a synchronous layout.
    let pointerX = 0;
    let pointerY = 0;
    let rect: DOMRect | null = null;
    let frame = 0;

    const applyTransform = () => {
      frame = 0;
      if (!rect) return;

      const x = pointerX - rect.left - rect.width / 2;
      const y = pointerY - rect.top - rect.height / 2;

      // Calculate rotation angles (max 10 degrees)
      const rotateX = -(y / (rect.height / 2)) * 10;
      const rotateY = (x / (rect.width / 2)) * 10;

      // Apply 3D transform with smooth transition
      card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;

      if (glow) {
        // Shift the glow position slightly to match the 3D depth
        glow.style.transform = `translate3d(${x * 0.08}px, ${y * 0.08}px, 0) scale(1.05)`;
      }
    };

    hero.addEventListener(
      "mousemove",
      (e) => {
        pointerX = e.clientX;
        pointerY = e.clientY;
        // Measured once per pointer entry, then only on resize/scroll below
        if (!rect) rect = hero.getBoundingClientRect();
        if (!frame) frame = requestAnimationFrame(applyTransform);
      },
      { passive: true }
    );

    // The cached rect is only valid while the hero stays where it was measured
    const invalidateRect = () => {
      rect = null;
    };
    window.addEventListener("resize", invalidateRect, { passive: true });
    window.addEventListener("scroll", invalidateRect, { passive: true });

    hero.addEventListener("mouseleave", () => {
      if (frame) {
        cancelAnimationFrame(frame);
        frame = 0;
      }
      rect = null;
      // Smooth reset on mouse leave
      card.style.transform = "rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)";
      if (glow) {
        glow.style.transform = "translate3d(0, 0, 0) scale(1)";
      }
    });
  }
</script>
