---
import { careersBasePath, careersCopy, jobs, jobPath, type CareersLang } from '../../data/careers';

interface Props {
  lang: CareersLang;
}

const { lang } = Astro.props;
const C = careersCopy[lang];

// Open positions first; closed ones stay listed so shared links make sense
const listed = [...jobs].sort((a, b) => Number(b.open) - Number(a.open));
---

<div class="grid-bg" aria-hidden="true"></div>
<div class="ambient-glow glow-top" aria-hidden="true"></div>
<div class="ambient-glow glow-bottom" aria-hidden="true"></div>

<header class="careers-hero reveal">
  <div class="hero-inner">
    <span class="hero-eyebrow">{C.eyebrow}</span>
    <h1 class="hero-title">{C.title}</h1>
    <p class="hero-subtitle">{C.subtitle}</p>
    <!-- Full path, not a bare "#ofertas": the navbar rewrites bare hash links on
         inner pages to point at the home page -->
    <a href={`${careersBasePath[lang]}#ofertas`} class="hero-cta">
      {C.heroCta}
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
    </a>
  </div>
</header>

<main class="careers-container" id="main-content">
  <section class="why-section" aria-labelledby="why-title">
    <div class="section-header reveal">
      <span class="section-eyebrow">{C.whyEyebrow}</span>
      <h2 class="section-heading" id="why-title">{C.whyTitle}</h2>
    </div>
    <ul class="why-grid reveal-stagger" role="list">
      {C.why.map((item, i) => (
        <li class="glass-card why-card">
          <span class="why-index" aria-hidden="true">0{i + 1}</span>
          <h3 class="why-title">{item.title}</h3>
          <p class="why-desc">{item.desc}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="openings-section" id="ofertas" aria-labelledby="openings-title">
    <div class="section-header reveal">
      <span class="section-eyebrow">{C.openingsEyebrow}</span>
      <h2 class="section-heading" id="openings-title">{C.openingsTitle}</h2>
    </div>

    {listed.length === 0 ? (
      <p class="no-openings">{C.noOpenings}</p>
    ) : (
      <ul class="job-list reveal-stagger" role="list">
        {listed.map((job) => {
          const J = job[lang];
          return (
            <li>
              <a href={jobPath(job.slug, lang)} class={`glass-card job-card ${job.open ? '' : 'is-closed'}`}>
                <div class="job-main">
                  <span class="job-department">{J.department}</span>
                  <h3 class="job-title">
                    {J.title}
                    {!job.open && <span class="closed-badge">{C.closedBadge}</span>}
                  </h3>
                  <p class="job-summary">{J.summary}</p>
                  <ul class="job-tags" role="list">
                    <li class="job-tag">{J.location}</li>
                    <li class="job-tag">{J.workplace}</li>
                    <li class="job-tag">{J.experience}</li>
                  </ul>
                </div>
                <span class="job-cta">
                  {C.viewOffer}
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    )}

    <div class="glass-card spontaneous reveal">
      <div>
        <h3 class="spontaneous-title">{C.spontaneousTitle}</h3>
        <p class="spontaneous-desc">{C.spontaneousDesc}</p>
      </div>
      <a href={`mailto:support@giralabs.es?subject=${encodeURIComponent(lang === 'en' ? 'Spontaneous application' : 'Candidatura espontánea')}`} class="spontaneous-cta">{C.spontaneousCta}</a>
    </div>
  </section>
</main>

<script>
  const revealEls = document.querySelectorAll('.reveal, .reveal-stagger');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, { threshold: 0, rootMargin: '0px 0px -40px 0px' });
  revealEls.forEach((el) => observer.observe(el));
</script>

<style>
  .grid-bg {
    position: fixed;
    inset: 0;
    background-image: radial-gradient(rgba(0,0,0,0.05) 1.2px, transparent 1.2px);
    background-size: 32px 32px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.65;
  }

  .ambient-glow {
    position: fixed;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    opacity: 0.07;
  }

  .glow-top {
    top: -200px;
    right: -100px;
    background: radial-gradient(circle, rgba(255, 180, 100, 0.15) 0%, transparent 65%);
  }

  .glow-bottom {
    bottom: -250px;
    left: -150px;
    background: radial-gradient(circle, rgba(0, 200, 255, 0.1) 0%, transparent 70%);
  }

  /* ---------- Hero ---------- */
  .careers-hero {
    position: relative;
    z-index: 1;
    padding: 10rem 2rem 4rem;
    text-align: center;
  }

  .hero-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .hero-eyebrow,
  .section-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.6);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.12;
    color: #000;
    margin: 0 0 1.2rem;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 3vw, 1.22rem);
    line-height: 1.6;
    color: rgba(0,0,0,0.68);
    margin: 0 0 2.2rem;
  }

  .hero-cta,
  .spontaneous-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.9rem 1.8rem;
    border-radius: 100px;
    background: rgba(20, 20, 20, 0.9);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12), 0 1px 0 rgba(255,255,255,0.12) inset;
    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  }

  .hero-cta:hover,
  .spontaneous-cta:hover {
    background: #000;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(0,0,0,0.2);
  }

  /* ---------- Layout ---------- */
  .careers-container {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem 7rem;
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  .openings-section {
    scroll-margin-top: 6rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-eyebrow {
    font-size: 0.68rem;
    margin-bottom: 0.6rem;
  }

  .section-heading {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #000;
    margin: 0;
  }

  .glass-card {
    position: relative;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 8px 32px rgba(0,0,0,0.03), 0 1px 0 rgba(255,255,255,0.7) inset;
  }

  /* ---------- Why ---------- */
  .why-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.8rem;
  }

  .why-card {
    padding: 2.2rem;
  }

  .why-index {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: rgba(0,0,0,0.45);
    margin-bottom: 1.4rem;
    font-variant-numeric: tabular-nums;
  }

  .why-title {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.7rem;
    color: #000;
  }

  .why-desc {
    font-size: 0.92rem;
    line-height: 1.65;
    color: rgba(0,0,0,0.68);
    margin: 0;
  }

  /* ---------- Job list ---------- */
  .job-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .job-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.2rem 2.4rem;
    color: inherit;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.3s ease, background 0.3s ease;
  }

  .job-card:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.55);
    box-shadow: 0 16px 40px rgba(0,0,0,0.06), 0 1px 0 rgba(255,255,255,0.9) inset;
  }

  .job-card.is-closed {
    opacity: 0.7;
  }

  .job-department {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.58);
  }

  .job-title {
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #000;
    margin: 0.4rem 0 0.7rem;
    line-height: 1.25;
  }

  .closed-badge {
    display: inline-block;
    margin-left: 0.6rem;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    background: rgba(0,0,0,0.08);
    font-size: 0.7rem;
    font-weight: 600;
    vertical-align: middle;
    letter-spacing: 0;
  }

  .job-summary {
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(0,0,0,0.68);
    margin: 0 0 1.1rem;
    max-width: 680px;
  }

  .job-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .job-tag {
    font-size: 0.76rem;
    font-weight: 500;
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    background: rgba(0,0,0,0.05);
    color: rgba(0,0,0,0.75);
  }

  .job-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.4rem;
    border-radius: 100px;
    background: rgba(20, 20, 20, 0.9);
    color: #fff;
    font-size: 0.84rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background 0.25s ease;
  }

  .job-card:hover .job-cta {
    background: #000;
  }

  .no-openings {
    text-align: center;
    color: rgba(0,0,0,0.68);
    margin: 0 0 2rem;
  }

  /* ---------- Spontaneous ---------- */
  .spontaneous {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem 2.4rem;
  }

  .spontaneous-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
    color: #000;
  }

  .spontaneous-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(0,0,0,0.68);
    margin: 0;
  }

  .spontaneous-cta {
    flex-shrink: 0;
    padding: 0.8rem 1.4rem;
    font-size: 0.84rem;
  }

  a:focus-visible {
    outline: 3px solid #000;
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .why-grid { grid-template-columns: 1fr; gap: 1.2rem; }
    .job-card,
    .spontaneous { flex-direction: column; align-items: flex-start; gap: 1.4rem; }
  }

  @media (max-width: 600px) {
    .careers-hero { padding: 8rem 1rem 3rem; }
    .careers-container { padding: 0 1rem 5rem; gap: 4.5rem; }
    .job-card,
    .spontaneous,
    .why-card { padding: 1.6rem 1.4rem; }
    .job-cta,
    .spontaneous-cta { width: 100%; justify-content: center; white-space: normal; text-align: center; }
  }
</style>
