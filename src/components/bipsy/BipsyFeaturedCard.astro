---
import { getImage } from 'astro:assets';
import { translations } from '../../i18n/translations';
import { getLocalizedPath } from '../../lib/paths';
// Bip + phone with the current screens (generated by renders/keyvisuals_v1 in
// the bipsy repo). Dated names, so a new version never hides behind a cache.
import bipsyApp from '../../assets/bipsy/keyvisuals/bipsy-app-2026-11.webp';
import bipsyBusinessApp from '../../assets/bipsy/keyvisuals/bipsy-business-app-2026-11.webp';
import bipsyMark from '../../assets/bipsy/lockups/bipsy_lockup.webp';
// The bare symbol, for the animated «Descubre Bipsy» button
import bipsySymbol from '../../assets/bipsy/derived/bipsy_symbol_outline_cropped.webp';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const T = translations[lang];

// Two ways in: the Bip experience (Spanish only for now) and the project page
const projectHref = getLocalizedPath('/proyecto/bipsy', lang);
const discoverHref = lang === 'es' ? '/descubre-bipsy' : null;
const labels = lang === 'es'
  ? { discover: 'Descubre Bipsy', discoverSub: 'Bip te lo enseña', project: 'Ver el proyecto', projectSub: 'Pantallas, proceso y tecnología' }
  : { discover: 'Discover Bipsy', discoverSub: 'Bip shows you around', project: 'See the project', projectSub: 'Screens, process and tech' };

const [clientShot, businessShot, mark, symbol] = await Promise.all([
  getImage({ src: bipsyApp, format: 'webp', width: 820 }),
  getImage({ src: bipsyBusinessApp, format: 'webp', width: 820 }),
  getImage({ src: bipsyMark, format: 'webp', width: 420 }),
  getImage({ src: bipsySymbol, format: 'webp', width: 160 }),
]);
---

<article class="bf-card" aria-label={`${T.project_bipsy_title} — ${T.project_bipsy_status}`}>
  <div class="bf-aura" aria-hidden="true"></div>
  <div class="bf-shine" aria-hidden="true"></div>

  <!-- ---------- CONTENT ---------- -->
  <div class="bf-content">
    <span class="bf-status">{T.project_bipsy_status}</span>

    <div class="bf-identity">
      <img src={mark.src} alt={T.project_bipsy_title} class="bf-mark" width="1582" height="444" loading="lazy" />
      <span class="bf-tag">{T.project_bipsy_tag}</span>
    </div>

    <p class="bf-desc">{T.project_bipsy_desc}</p>

    <ul class="bf-apps" role="list">
      <li class="bf-app">{T.projects_app_client}</li>
      <li class="bf-app">{T.projects_app_business}</li>
    </ul>

    <div class="bf-actions">
      {discoverHref && (
        <a href={discoverHref} class="bf-btn bf-btn--discover">
          <!-- The symbol's three leaves open like a flower every few seconds -->
          <span class="bf-bloom" aria-hidden="true">
            <img src={symbol.src} alt="" class="bf-leaf bf-leaf--left" width="160" height="158" />
            <img src={symbol.src} alt="" class="bf-leaf bf-leaf--right" width="160" height="158" />
            <img src={symbol.src} alt="" class="bf-leaf bf-leaf--center" width="160" height="158" />
          </span>
          <span class="bf-btn-text">
            <b>{labels.discover}</b>
            <small>{labels.discoverSub}</small>
          </span>
          <svg class="bf-btn-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      )}
      <a href={projectHref} class="bf-btn bf-btn--project">
        <span class="bf-btn-text">
          <b>{labels.project}</b>
          <small>{labels.projectSub}</small>
        </span>
        <svg class="bf-btn-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
    <span class="bf-meta">{T.project_bipsy_meta}</span>
  </div>

  <!-- ---------- VISUAL: the two apps stacked ---------- -->
  <div class="bf-visual" aria-hidden="true">
    <div class="bf-shot bf-shot--back">
      <img src={businessShot.src} alt="" width="820" height="627" loading="lazy" />
    </div>
    <div class="bf-shot bf-shot--front">
      <img src={clientShot.src} alt="" width="820" height="627" loading="lazy" />
    </div>
  </div>
</article>

<style>
  .bf-card {
    --mint: #c0ebd1;
    --mint-deep: #3f8c66;
    --slate: #6d7174;

    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.02fr;
    align-items: center;
    gap: 2rem;
    overflow: hidden;
    padding: 3rem 3rem 3rem 3.2rem;
    border-radius: 34px;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(28px) saturate(170%);
    -webkit-backdrop-filter: blur(28px) saturate(170%);
    border: 1px solid rgba(255, 255, 255, 0.82);
    box-shadow:
      0 14px 44px rgba(0, 0, 0, 0.04),
      0 1px 0 rgba(255, 255, 255, 0.9) inset;
    transition:
      transform 0.55s cubic-bezier(0.25, 1, 0.5, 1),
      box-shadow 0.55s cubic-bezier(0.25, 1, 0.5, 1),
      background 0.55s ease,
      border-color 0.55s ease;
  }

  .bf-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.7);
    border-color: rgba(255, 255, 255, 0.95);
    box-shadow:
      0 34px 70px rgba(0, 0, 0, 0.08),
      0 1px 0 rgba(255, 255, 255, 0.95) inset;
  }

  .bf-aura {
    position: absolute;
    top: -45%;
    right: -12%;
    width: 620px;
    height: 620px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(192, 235, 209, 0.75) 0%, rgba(192, 235, 209, 0) 66%);
    /* No filter: blur() here. The background is already a soft radial
       gradient, so the blur was costing a full-size gaussian every frame
       for a difference measured at 0.5/255 — and WebKit pays that on the
       CPU, which put mobile Safari at roughly one frame per second. */
    pointer-events: none;
    z-index: 0;
  }

  /* Slow light sweep across the glass */
  .bf-shine {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  .bf-shine::after {
    content: '';
    position: absolute;
    top: -60%;
    /* Anchored at 0 and moved with a transform: sweeping `left` forever kept the
       main thread running layout on every frame. The box is 45% of the parent, so
       -55%/135% of the parent become -122%/300% of the box. */
    left: 0;
    width: 45%;
    height: 220%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.42), transparent);
    transform: translateX(-122.22%) rotate(14deg);
    animation: bfShine 9s ease-in-out 2s infinite;
  }

  /* translateX before rotate, so the sweep still travels along the card's axis */
  @keyframes bfShine {
    0% { transform: translateX(-122.22%) rotate(14deg); }
    35%, 100% { transform: translateX(300%) rotate(14deg); }
  }

  /* ---------- CONTENT ---------- */
  .bf-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .bf-status {
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: #3f8c66;
  }

  .bf-identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  .bf-mark {
    width: 132px;
    height: auto;
  }

  .bf-tag {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(0, 0, 0, 0.4);
  }

  .bf-desc {
    font-size: 0.94rem;
    line-height: 1.72;
    color: rgba(0, 0, 0, 0.58);
    margin: 0.2rem 0 0;
    max-width: 44ch;
  }

  .bf-apps {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .bf-app {
    font-size: 0.83rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: rgba(0, 0, 0, 0.62);
  }

  /* ---------- The two ways in ---------- */
  .bf-actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    width: 100%;
    max-width: 420px;
    margin-top: 1.4rem;
  }

  .bf-btn {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 68px;
    padding: 12px 20px 12px 16px;
    border-radius: 22px;
    text-decoration: none;
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.35s ease, background 0.3s ease;
  }

  .bf-btn:hover { transform: translateY(-2px); }
  .bf-btn:active { transform: scale(0.98); }

  .bf-btn-text { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
  .bf-btn-text b { font-size: 1.02rem; font-weight: 800; letter-spacing: -0.02em; }
  .bf-btn-text small { font-size: 0.78rem; font-weight: 500; opacity: 0.62; }
  .bf-btn-arrow { flex: none; transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1); }
  .bf-btn:hover .bf-btn-arrow { transform: translateX(4px); }

  /* Descubre Bipsy: carbon, with the symbol blooming on the left */
  .bf-btn--discover {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #2b3238 0%, #1c2125 100%);
    color: #fff;
    box-shadow: 0 14px 34px -14px rgba(28, 33, 37, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  /* A mint light that wakes up behind the symbol with each bloom */
  .bf-btn--discover::before {
    content: '';
    position: absolute;
    left: -10px;
    top: 50%;
    width: 120px;
    height: 120px;
    margin-top: -60px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(143, 220, 178, 0.35), transparent);
    opacity: 0.4;
    animation: bfGlow 3.4s ease-in-out infinite;
    pointer-events: none;
  }

  .bf-btn--discover:hover { box-shadow: 0 20px 40px -14px rgba(28, 33, 37, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.1); }

  .bf-bloom {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
  }

  /* The same symbol three times, each cut to one leaf, so each can move */
  .bf-leaf {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform-origin: 50% 64%;
    animation: 3.4s cubic-bezier(0.45, 0, 0.2, 1) infinite;
  }

  .bf-leaf--center { clip-path: polygon(50% 0, 74% 28%, 74% 52%, 50% 62%, 26% 52%, 26% 28%); animation-name: bfCenter; }
  .bf-leaf--left { clip-path: polygon(0 26%, 26% 28%, 26% 52%, 50% 62%, 50% 100%, 0 100%); animation-name: bfLeft; }
  .bf-leaf--right { clip-path: polygon(100% 26%, 74% 28%, 74% 52%, 50% 62%, 50% 100%, 100% 100%); animation-name: bfRight; }

  @keyframes bfLeft {
    0%, 55%, 100% { transform: none; }
    18% { transform: rotate(-16deg) translate(-4%, -2%); }
    32% { transform: rotate(4deg); }
    42% { transform: rotate(-2deg); }
  }

  @keyframes bfRight {
    0%, 55%, 100% { transform: none; }
    18% { transform: rotate(16deg) translate(4%, -2%); }
    32% { transform: rotate(-4deg); }
    42% { transform: rotate(2deg); }
  }

  @keyframes bfCenter {
    0%, 55%, 100% { transform: none; }
    18% { transform: translateY(-12%) scale(1.08); }
    32% { transform: translateY(3%) scale(0.98); }
    42% { transform: translateY(-1%); }
  }

  @keyframes bfGlow {
    0%, 55%, 100% { opacity: 0.35; transform: scale(0.85); }
    20% { opacity: 1; transform: scale(1.1); }
  }

  /* Hovered, it blooms faster */
  .bf-btn--discover:hover .bf-leaf,
  .bf-btn--discover:hover::before { animation-duration: 1.6s; }

  /* Ver el proyecto: plain and quiet */
  .bf-btn--project {
    background: rgba(255, 255, 255, 0.75);
    color: #0b0e10;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  .bf-btn--project:hover { background: #fff; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12), 0 12px 28px -14px rgba(0, 0, 0, 0.2); }

  .bf-meta {
    margin-top: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: rgba(0, 0, 0, 0.34);
  }

  /* ---------- VISUAL ---------- */
  .bf-visual {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 380px;
  }

  .bf-shot {
    position: absolute;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.05);
    transition: transform 0.65s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.65s ease;
  }

  .bf-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Bipsy Business sits behind, tilted */
  .bf-shot--back {
    width: 78%;
    transform: translate(-11%, -13%) rotate(-5deg);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.07);
  }

  /* Bipsy (client) leads in front */
  .bf-shot--front {
    width: 82%;
    transform: translate(10%, 11%) rotate(2.5deg);
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.11);
  }

  .bf-card:hover .bf-shot--back {
    transform: translate(-14%, -16%) rotate(-6.5deg);
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.09);
  }

  .bf-card:hover .bf-shot--front {
    transform: translate(12%, 13%) rotate(3.5deg);
    box-shadow: 0 30px 62px rgba(0, 0, 0, 0.14);
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 960px) {
    .bf-card {
      grid-template-columns: 1fr;
      gap: 2.4rem;
      padding: 2.4rem 2rem;
      border-radius: 26px;
    }
    .bf-visual { order: -1; min-height: 260px; }
    .bf-shot--back { width: 72%; transform: translate(-14%, -13%) rotate(-5deg); }
    .bf-shot--front { width: 76%; transform: translate(13%, 11%) rotate(2.5deg); }
  }

  @media (max-width: 600px) {
    .bf-card { padding: 1.8rem 1.4rem; border-radius: 22px; }
    .bf-visual { min-height: 210px; }
    .bf-mark { width: 116px; }
    .bf-actions { max-width: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bf-shine::after,
    .bf-leaf,
    .bf-btn--discover::before { animation: none; }
  }
</style>
