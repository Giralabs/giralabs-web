---
import { translations } from '../../i18n/translations';
import { getLocalizedPath } from '../../lib/paths';
import { getImage } from 'astro:assets';
import { BIPSY_STORE } from '../../lib/bipsy-links';
// Apple's official badge, never recoloured or redrawn
import appStoreBadge from '../../assets/bipsy/badges/app-store-badge.webp';
// 135x240 variant of the 400x711 master: the mascot never renders taller than
// 118 CSS px, so the full-size 48-frame animation was ~190 kB of unused pixels
import bipHello from '../../assets/bipsy/bip_assets/bip_hello_animated_135.webp';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const T = translations[lang];

// «Descubrir Bipsy» opens the Bip experience (Spanish only for now); in
// English it is still the project page.
const projectHref = lang === 'es' ? '/descubre-bipsy' : getLocalizedPath('/proyecto/bipsy', lang);
// The animated WebP is used raw (no getImage) so the frames survive the build
const bipSrc = bipHello.src;
const storeBadge = await getImage({ src: appStoreBadge, width: 405, format: 'webp' });
---

<!-- Cookie-style notice: anchored bottom-right, never blocks the page -->
<div class="bipsy-announce" data-bipsy-announce data-bipsy-state="hidden">
  <div
    class="bipsy-notice"
    role="dialog"
    aria-labelledby="bipsy-announce-title"
    aria-describedby="bipsy-announce-text"
  >
    <!-- Bip stands behind the card -->
    <div class="bipsy-mascot" aria-hidden="true">
      <!-- Decorative and only revealed after 1.1s: must not compete with the LCP -->
      <img src={bipSrc} alt="" class="bipsy-mascot-img" width="135" height="240" loading="lazy" decoding="async" fetchpriority="low" />
    </div>

    <div class="bipsy-card lg">

      <button class="bipsy-close" type="button" data-bipsy-close aria-label={T.bipsy_announce_close}>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <h2 class="bipsy-title" id="bipsy-announce-title">{T.bipsy_announce_title}</h2>
      <p class="bipsy-text" id="bipsy-announce-text" set:html={T.bipsy_announce_text}></p>

      <div class="bipsy-actions">
        <a href={BIPSY_STORE.client.appStore} class="bipsy-store" target="_blank" rel="noopener">
          <img src={storeBadge.src} alt={T.bipsy_announce_store} width="135" height="40" loading="lazy" decoding="async" />
        </a>
        <a href={projectHref} class="bipsy-link">
          <span>{T.bipsy_announce_cta}</span>
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Collapsed state: a small pill that brings the notice back -->
  <button class="bipsy-pill lg" type="button" data-bipsy-reopen aria-label={T.bipsy_announce_title}>
    <span class="bipsy-pill-avatar" aria-hidden="true">
      <img src={bipSrc} alt="" width="60" height="107" loading="lazy" decoding="async" fetchpriority="low" />
    </span>
    <span class="bipsy-pill-text">
      <span class="bipsy-pill-name">Bipsy</span>
      <span class="bipsy-pill-status">{T.project_bipsy_status}</span>
    </span>
  </button>
</div>

<script>
  function initBipsyAnnounce() {
    const root = document.querySelector<HTMLElement>('[data-bipsy-announce]');
    if (!root || root.dataset.bipsyReady === 'true') return;
    root.dataset.bipsyReady = 'true';

    // v3: the launch notice. A new key so whoever closed the old "in development"
    // notice still gets to see that the apps are out.
    const STORAGE_KEY = 'giralabs:bipsy-announce-v3';
    const closeEls = root.querySelectorAll<HTMLElement>('[data-bipsy-close]');
    const reopenBtn = root.querySelector<HTMLElement>('[data-bipsy-reopen]');

    // sessionStorage can throw in private/blocked contexts: degrade to "always show"
    const readDismissed = (): boolean => {
      try {
        return sessionStorage.getItem(STORAGE_KEY) === 'dismissed';
      } catch {
        return false;
      }
    };
    const markDismissed = () => {
      try {
        sessionStorage.setItem(STORAGE_KEY, 'dismissed');
      } catch {
        /* storage unavailable: the notice simply reappears next visit */
      }
    };

    const open = () => {
      root.dataset.bipsyState = 'open';
    };

    const close = () => {
      root.dataset.bipsyState = 'minimized';
      markDismissed();
    };

    closeEls.forEach((el) => el.addEventListener('click', close));
    reopenBtn?.addEventListener('click', open);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.dataset.bipsyState === 'open') close();
    });

    if (readDismissed()) root.dataset.bipsyState = 'minimized';
    else window.setTimeout(open, 1100);
  }

  initBipsyAnnounce();
  document.addEventListener('astro:after-swap', initBipsyAnnounce);
</script>

<style>
  /* =============================================
     BIPSY NOTICE — anchored bottom-right
  ============================================= */
  .bipsy-announce {
    --mint: #c0ebd1;
    --carbon: #31373c;

    position: fixed;
    right: 1.6rem;
    bottom: 1.6rem;
    z-index: 1500;
    display: flex;
    justify-content: flex-end;
    pointer-events: none;
  }

  /* Collapsed pill sits in the same corner as the notice it replaces */
  .bipsy-pill {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.42rem 1.05rem 0.42rem 0.42rem;
    border-radius: 100px;
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
    /* Liquid Glass (.lg) supplies the material */
    opacity: 0;
    transform: translateY(16px) scale(0.92);
    transform-origin: bottom right;
    pointer-events: none;
    transition:
      opacity 0.4s cubic-bezier(0.25, 1, 0.5, 1),
      transform 0.5s cubic-bezier(0.34, 1.5, 0.64, 1),
      box-shadow 0.3s ease;
  }

  .bipsy-announce[data-bipsy-state='minimized'] .bipsy-pill {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .bipsy-pill:hover {
    --lg-tint-top: rgba(255, 255, 255, 0.78);
  }

  .bipsy-pill-avatar {
    position: relative;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: radial-gradient(circle at 50% 30%, rgba(192, 235, 209, 0.6), rgba(192, 235, 209, 0.22));
    border: 1px solid rgba(255, 255, 255, 0.8);
  }

  /* Frames Bip's head inside the circular avatar */
  .bipsy-pill-avatar img {
    position: absolute;
    top: 1px;
    left: 50%;
    height: 57px;
    width: auto;
    transform: translateX(-50%);
  }

  .bipsy-pill-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.08rem;
    line-height: 1.15;
  }

  .bipsy-pill-name {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #000;
  }

  /* Quiet subtitle: the pill should read as a label, not as a shout */
  .bipsy-pill-status {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: rgba(0, 0, 0, 0.45);
  }

  .bipsy-notice {
    position: relative;
    width: 352px;
    max-width: 100%;
    opacity: 0;
    transform: translateY(26px) scale(0.96);
    transform-origin: bottom right;
    pointer-events: none;
    transition:
      opacity 0.45s cubic-bezier(0.25, 1, 0.5, 1),
      transform 0.6s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .bipsy-announce[data-bipsy-state='open'] .bipsy-notice {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  /* ---- Bip leaning on the card from behind ---- */
  .bipsy-mascot {
    position: absolute;
    left: 14px;
    bottom: calc(100% - 22px);
    width: 106px;
    height: 118px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
  }

  .bipsy-mascot-img {
    width: auto;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.16));
    opacity: 0;
    transform: translateY(18px) rotate(-5deg);
    transition:
      opacity 0.45s ease 0.18s,
      transform 0.7s cubic-bezier(0.34, 1.5, 0.64, 1) 0.18s;
  }

  /* Bip stays put: the only motion is the wave baked into the animated WebP */
  .bipsy-announce[data-bipsy-state='open'] .bipsy-mascot-img {
    opacity: 1;
    transform: translateY(0) rotate(0deg);
  }

  /* ---- Glass card ---- */
  .bipsy-card {
    position: relative;
    z-index: 1;
    overflow: hidden;
    padding: 1.5rem 1.5rem 1.4rem;
    border-radius: 24px;
    /* Liquid Glass (.lg), dense enough to read over any section */
    --lg-tint-top: rgba(255, 255, 255, 0.8);
    --lg-tint-bottom: rgba(255, 255, 255, 0.6);
    --lg-blur: 28px;
    --lg-light-size: 260px;
  }

  .bipsy-close {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    z-index: 2;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: rgba(0, 0, 0, 0.4);
    background: transparent;
    border: 1px solid rgba(0, 0, 0, 0.07);
    transition: color 0.25s ease, background 0.25s ease, transform 0.3s ease;
  }

  .bipsy-close:hover {
    color: #000;
    background: rgba(0, 0, 0, 0.04);
    transform: rotate(90deg);
  }

  .bipsy-title,
  .bipsy-text,
  .bipsy-actions {
    position: relative;
    z-index: 1;
  }

  .bipsy-title {
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.25;
    color: #000;
    margin: 0 2rem 0.5rem 0;
  }

  .bipsy-text {
    font-size: 0.83rem;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.58);
    margin: 0;
  }

  .bipsy-text :global(strong) {
    font-weight: 700;
    color: #000;
  }

  /* Badge and link share one 40px row, so both sit on the same centre line */
  .bipsy-actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    height: 40px;
    margin-top: 1.2rem;
  }

  .bipsy-store {
    display: block;
    flex-shrink: 0;
    height: 40px;
    transition: opacity 0.2s ease;
  }

  .bipsy-store img {
    display: block;
    width: auto;
    height: 40px;
  }

  .bipsy-store:hover { opacity: 0.85; }

  .bipsy-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #000;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-decoration: none;
  }

  .bipsy-link svg { transition: transform 0.25s ease; }
  .bipsy-link:hover svg { transform: translateX(3px); }

  /* =============================================
     RESPONSIVE + A11Y
  ============================================= */
  @media (max-width: 520px) {
    .bipsy-announce {
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
    }
    .bipsy-notice { width: 100%; }
    .bipsy-card { border-radius: 20px; padding: 1.3rem 1.2rem 1.2rem; }
    .bipsy-mascot { width: 92px; height: 102px; left: 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bipsy-notice,
    .bipsy-mascot-img { transition-duration: 0.01ms; }
    .bipsy-announce[data-bipsy-state='open'] .bipsy-mascot-img { animation: none; }  }
</style>
