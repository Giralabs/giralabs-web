---
import { getImage } from 'astro:assets';
// The five slides of the App Store launch carousel posted on @bipsy_es
// (renders/lanzamiento_ios_v1 in the bipsy repo), 1080x1350.
import slide1 from '../../assets/bipsy/launch/carrusel-1.webp';
import slide2 from '../../assets/bipsy/launch/carrusel-2.webp';
import slide3 from '../../assets/bipsy/launch/carrusel-3.webp';
import slide4 from '../../assets/bipsy/launch/carrusel-4.webp';
import slide5 from '../../assets/bipsy/launch/carrusel-5.webp';

// The profile avatar on Instagram is the app icon
import avatarSrc from '../../assets/bipsy/icons/bipsy-icon.webp';

interface Props {
  lang?: string;
  /** Eager in the launch notice, lazy inside an article. */
  eager?: boolean;
  /** Framed as the Instagram post it is, with the profile on top linking to it. */
  instagram?: boolean;
}

const { lang = 'es', eager = false, instagram = false } = Astro.props;

const INSTAGRAM_URL = 'https://www.instagram.com/bipsy_es/';
const avatar = await getImage({ src: avatarSrc, width: 96, format: 'webp' });
const isEs = lang !== 'en';

const alts = isEs
  ? [
      'Dos apps. Ya en iPhone: Bipsy y Bipsy Business en dos móviles',
      'Bipsy, para quien reserva: encuentra barberías, peluquerías y centros de estética, mira las horas libres y reserva sin llamar',
      'Bipsy Business, para quien atiende: la agenda del día, la ficha de cada cliente y el equipo, con el aviso de una nueva cita',
      '¿Cómo empiezo? Abre el App Store, busca Bipsy o Bipsy Business y descárgala',
      '¿Tienes Android? Llega en unas semanas. Bip saluda',
    ]
  : [
      'Two apps. Now on iPhone: Bipsy and Bipsy Business on two phones',
      'Bipsy, for whoever books: find barbershops, hair salons and beauty studios, see the free slots and book without calling',
      'Bipsy Business, for whoever serves: the day agenda, each client profile and the team, with a new booking notification',
      'How do I start? Open the App Store, search for Bipsy or Bipsy Business and download it',
      'On Android? It lands in a few weeks. Bip waves',
    ];

const labels = isEs
  ? { prev: 'Lámina anterior', next: 'Lámina siguiente', region: 'Carrusel del lanzamiento de Bipsy', of: 'de', igOpen: 'Ver en Instagram', igAria: 'Abrir @bipsy_es en Instagram' }
  : { prev: 'Previous slide', next: 'Next slide', region: 'Bipsy launch carousel', of: 'of', igOpen: 'View on Instagram', igAria: 'Open @bipsy_es on Instagram' };

const slides = await Promise.all(
  [slide1, slide2, slide3, slide4, slide5].map(async (src) => {
    const [small, large] = await Promise.all([
      getImage({ src, format: 'webp', width: 480 }),
      getImage({ src, format: 'webp', width: 900 }),
    ]);
    return { small: small.src, large: large.src };
  })
);
---

<!--
  Story-style carousel: one bar per slide on top, the active one fills while it
  is shown and its animationend moves on, so pausing the bar pauses the
  carousel with no second clock. Tap the left or right half, swipe, or use the
  arrow keys. It only runs while [data-playing="true"]: the launch notice turns
  it on when it opens, an article when it scrolls into view.
-->
<div class:list={['lc', { 'lc--ig': instagram }]} data-launch-carousel data-index="0" data-playing="false" role="region" aria-roledescription="carousel" aria-label={labels.region} tabindex="0">
  {instagram && (
    <a class="lc-ig" href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label={labels.igAria}>
      <img src={avatar.src} alt="" class="lc-ig-avatar" width="36" height="36" loading="lazy" decoding="async" />
      <span class="lc-ig-who">
        <b>bipsy_es</b>
        <small>Bipsy</small>
      </span>
      <span class="lc-ig-open">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4.2"></circle>
          <circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"></circle>
        </svg>
        {labels.igOpen}
      </span>
    </a>
  )}
  <div class="lc-viewport">
    <div class="lc-track">
      {slides.map((s, i) => (
        <figure class="lc-slide" aria-roledescription="slide" aria-label={`${i + 1} ${labels.of} ${slides.length}`}>
          <img
            src={s.small}
            srcset={`${s.small} 480w, ${s.large} 900w`}
            sizes="(max-width: 720px) 90vw, 420px"
            alt={alts[i]}
            width="1080"
            height="1350"
            loading={eager || i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            draggable="false"
          />
        </figure>
      ))}
    </div>

    <div class="lc-progress" aria-hidden="true">
      {slides.map(() => <span class="lc-bar"><i></i></span>)}
    </div>

    <button type="button" class="lc-hit lc-hit--prev" data-lc-prev aria-label={labels.prev}></button>
    <button type="button" class="lc-hit lc-hit--next" data-lc-next aria-label={labels.next}></button>
  </div>
</div>

<script>
  const SWIPE = 40;

  function initLaunchCarousels() {
    document.querySelectorAll<HTMLElement>('[data-launch-carousel]').forEach((root) => {
      if (root.dataset.lcReady === 'true') return;
      root.dataset.lcReady = 'true';

      const bars = Array.from(root.querySelectorAll<HTMLElement>('.lc-bar'));
      const count = bars.length;
      let index = 0;

      const show = (next: number) => {
        index = (next + count) % count;
        root.dataset.index = String(index);
        root.style.setProperty('--lc-index', String(index));
        bars.forEach((bar, i) => {
          bar.classList.toggle('is-done', i < index);
          bar.classList.toggle('is-active', i === index);
          // Restart the fill of the active bar
          const fill = bar.firstElementChild as HTMLElement | null;
          if (fill && i === index) {
            fill.style.animation = 'none';
            void fill.offsetWidth;
            fill.style.animation = '';
          }
        });
      };

      // A swipe ends on one of the halves: that click must not move again
      let swiped = false;
      const tap = (step: number) => () => {
        if (swiped) { swiped = false; return; }
        show(index + step);
      };

      bars.forEach((bar) => bar.firstElementChild?.addEventListener('animationend', () => show(index + 1)));
      root.querySelector('[data-lc-prev]')?.addEventListener('click', tap(-1));
      root.querySelector('[data-lc-next]')?.addEventListener('click', tap(1));
      root.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') show(index + 1);
        if (e.key === 'ArrowLeft') show(index - 1);
      });

      // Swipe
      let startX: number | null = null;
      root.addEventListener('pointerdown', (e) => { startX = e.clientX; });
      root.addEventListener('pointerup', (e) => {
        if (startX === null) return;
        const dx = e.clientX - startX;
        startX = null;
        if (Math.abs(dx) > SWIPE) {
          swiped = true;
          show(index + (dx < 0 ? 1 : -1));
        }
      });

      // Inside an article: play only while on screen. The launch notice
      // drives data-playing itself.
      if (!root.closest('[data-bipsy-announce]') && 'IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => {
          root.dataset.playing = entry.isIntersecting ? 'true' : 'false';
        }, { threshold: 0.4 }).observe(root);
      }

      show(0);
    });
  }

  initLaunchCarousels();
  document.addEventListener('astro:after-swap', initLaunchCarousels);
</script>

<style>
  .lc {
    --lc-slide-ms: 5200ms;
    position: relative;
    width: 100%;
    outline: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .lc:focus-visible .lc-viewport { box-shadow: 0 0 0 3px rgba(63, 140, 102, 0.6); }

  /* ---------- As an Instagram post: white card, profile on top ---------- */
  .lc--ig {
    padding: 0 0 6px;
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
  }

  .lc--ig .lc-viewport {
    border-radius: 0;
    box-shadow: none;
  }

  .lc-ig {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    color: #0d0d0f;
    text-decoration: none;
  }

  .lc-ig-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    /* Instagram's story ring, in Bipsy's mint */
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px #8fdcb2;
  }

  .lc-ig-who {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    margin-left: 4px;
  }

  .lc-ig-who b { font-size: 0.86rem; font-weight: 700; letter-spacing: -0.01em; }
  .lc-ig-who small { font-size: 0.74rem; color: rgba(0, 0, 0, 0.5); }

  .lc-ig-open {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 100px;
    background: #0d0d0f;
    color: #fff;
    font-size: 0.76rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background 0.2s ease;
  }

  .lc-ig:hover .lc-ig-open { background: #3f8c66; }

  .lc-viewport {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 22px;
    background: #2e343b;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.22);
    touch-action: pan-y;
  }

  .lc-track {
    display: flex;
    height: 100%;
    transform: translateX(calc(var(--lc-index, 0) * -100%));
    transition: transform 0.7s cubic-bezier(0.65, 0, 0.25, 1);
  }

  .lc-slide {
    flex: 0 0 100%;
    height: 100%;
    margin: 0;
  }

  .lc-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Story bars over the top edge of the slide */
  .lc-progress {
    position: absolute;
    top: 12px;
    left: 14px;
    right: 14px;
    display: flex;
    gap: 5px;
    pointer-events: none;
  }

  .lc-bar {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.28);
  }

  .lc-bar i {
    display: block;
    height: 100%;
    background: rgba(255, 255, 255, 0.95);
    transform: scaleX(0);
    transform-origin: left;
  }

  .lc-bar.is-done i { transform: none; }

  .lc-bar.is-active i {
    animation: lcFill var(--lc-slide-ms) linear forwards;
    animation-play-state: paused;
  }

  .lc[data-playing='true'] .lc-bar.is-active i { animation-play-state: running; }
  .lc[data-playing='true']:hover .lc-bar.is-active i { animation-play-state: paused; }

  @keyframes lcFill {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  /* The two halves of the slide are the controls, like a story */
  .lc-hit {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .lc-hit--prev { left: 0; cursor: w-resize; }
  .lc-hit--next { right: 0; cursor: e-resize; }
  .lc-hit:focus-visible { outline: 2px solid rgba(255, 255, 255, 0.8); outline-offset: -6px; border-radius: 18px; }

  @media (prefers-reduced-motion: reduce) {
    .lc-track { transition: none; }
    /* No autoplay: the bars only mark where you are */
    .lc-bar.is-active i { animation: none; transform: none; }
  }
</style>
