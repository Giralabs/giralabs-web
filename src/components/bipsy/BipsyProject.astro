      { name: 'Mint', hex: '#C0EBD1', note: 'Bipsy' },
      { name: 'Carbon', hex: '#31373C', note: 'Type and symbol' },
      { name: 'Slate', hex: '#6D7174', note: 'Bipsy Business' },
      { name: 'Cloud', hex: '#F5F6F5', note: 'Surfaces' },
