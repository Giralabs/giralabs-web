<!-- Overlays sit outside <main>: .bp-main is a stacking context (position:relative
     + z-index) and would trap them underneath the navbar. The .reveal sections
     would also turn their position:fixed into position:absolute. -->
<div class="bp-viewer" data-pose-viewer hidden>
  <div class="bp-viewer-backdrop" data-pose-close></div>
  <button type="button" class="bp-viewer-close" data-pose-close aria-label={c.poseViewerClose}>
