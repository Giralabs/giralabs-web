      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  <figure class="bp-viewer-figure">
    <img src="" alt="" data-pose-image width="900" height="900" />
  </figure>
</div>

<script>
  function initScreenTabs() {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-screens-tab]'));
    if (!tabs.length || tabs[0].dataset.tabsReady === 'true') return;
    tabs[0].dataset.tabsReady = 'true';

    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        const panel = document.querySelector<HTMLElement>(`[data-screens-panel="${t.dataset.screensTab}"]`);
        if (panel) {
          panel.hidden = !on;
          if (on) panel.querySelector('.bp-screens-row')?.scrollTo({ left: 0 });
        }
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        next.focus();
        select(next);
      });
    });
  }

  function initPoseViewer() {
    const viewer = document.querySelector<HTMLElement>('[data-pose-viewer]');
    const image = viewer?.querySelector<HTMLImageElement>('[data-pose-image]');
    if (!viewer || !image || viewer.dataset.poseReady === 'true') return;
    viewer.dataset.poseReady = 'true';

    let lastTrigger: HTMLElement | null = null;

    const open = (trigger: HTMLElement) => {
      const src = trigger.dataset.poseSrc;
      if (!src) return;
      lastTrigger = trigger;
      image.src = src;
      viewer.hidden = false;
      // next frame, so the transition runs from the hidden state
      requestAnimationFrame(() => viewer.classList.add('is-open'));
      document.documentElement.classList.add('bp-viewer-open');
      viewer.querySelector<HTMLElement>('.bp-viewer-close')?.focus();
    };

    const close = () => {
      viewer.classList.remove('is-open');
      document.documentElement.classList.remove('bp-viewer-open');
      window.setTimeout(() => {
        viewer.hidden = true;
        image.src = '';
      }, 300);
      lastTrigger?.focus();
    };

    document.querySelectorAll<HTMLElement>('[data-pose-open]').forEach((btn) => {
      btn.addEventListener('click', () => open(btn));
    });
    viewer.querySelectorAll<HTMLElement>('[data-pose-close]').forEach((el) => {
      el.addEventListener('click', close);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !viewer.hidden) close();
    });
  }

  initScreenTabs();
  initPoseViewer();
  document.addEventListener('astro:after-swap', () => {
    initScreenTabs();
    initPoseViewer();
  });
</script>

