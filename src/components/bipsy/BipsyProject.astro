---
import { getImage } from 'astro:assets';
import { getLocalizedPath } from '../../lib/paths';
import BipsyPilotModal from './BipsyPilotModal.astro';

// Bip (mascot) renders
import bipBooking from '../../assets/bipsy/bip_assets/bip_booking.webp';
import bipSupport from '../../assets/bipsy/bip_assets/bip_support.webp';
import bipHello from '../../assets/bipsy/bip_assets/bip_hello.webp';
import bipRecool from '../../assets/bipsy/bip_assets/bip_recool.webp';
import bipPockets from '../../assets/bipsy/bip_assets/big_pockets.webp';
import bipLaughing from '../../assets/bipsy/bip_assets/bip_laughing.webp';

// App key visuals
// Bip ships grey in the light capture: this derived copy repaints him with the
// exact mint sampled from the dark capture, keeping the light UI theme
import bipsyApp from '../../assets/bipsy/derived/bipsy_light_mint.webp';
import bipsyBusinessApp from '../../assets/bipsy/assets_apps/bipsy_business_light.webp';

// Brand lockups
import bipsyMark from '../../assets/bipsy/lockups/bipsy_lockup.webp';
import bipsyBusinessMark from '../../assets/bipsy/lockups/bipsy_business_lockup.webp';

interface Props {
  lang?: string;
  formActionUrl?: string;
}

const { lang = 'es', formActionUrl = 'https://formspree.io/f/xvznwgob' } = Astro.props;
const isEs = lang !== 'en';

const localizedPath = (path: string) => getLocalizedPath(path, lang);

// ---- Optimized assets -------------------------------------------------------
const [heroVisual, supportVisual, appClient, appBusiness, markClient, markBusiness] = await Promise.all([
  getImage({ src: bipBooking, format: 'webp', width: 900 }),
  getImage({ src: bipSupport, format: 'webp', width: 620 }),
  getImage({ src: bipsyApp, format: 'webp', width: 900 }),
  getImage({ src: bipsyBusinessApp, format: 'webp', width: 900 }),
  getImage({ src: bipsyMark, format: 'webp', width: 560 }),
  getImage({ src: bipsyBusinessMark, format: 'webp', width: 560 }),
]);

const poseSources = [bipHello, bipRecool, bipPockets, bipLaughing];
const poses = await Promise.all(
  poseSources.map((src) => getImage({ src, format: 'webp', width: 340 }))
);
// Full-size copies for the pose viewer
const posesLarge = await Promise.all(
  poseSources.map((src) => getImage({ src, format: 'webp', width: 900 }))
);

// ---- Copy -------------------------------------------------------------------
const copy = {
  es: {
    breadcrumbHome: 'Inicio',
    breadcrumbProjects: 'Proyectos',
    back: 'Todos los proyectos',
    status: 'En desarrollo',
    heroEyebrow: 'PRODUCTO PROPIO DE GIRALABS',
    heroLead: 'Reservar en tu barbería, peluquería o centro de estética debería costar dos toques. Gestionarlo, ninguno más.',
    heroDesc:
      'Bipsy es el ecosistema de reservas que estamos construyendo puertas adentro: dos aplicaciones móviles unidas por el mismo motor, una para quien reserva y otra para quien gestiona. Todavía no está publicada — está en pleno desarrollo, y lo contamos en abierto.',
    storesLabel: 'Próximamente en',
    storeApple: 'App Store',
    storeGoogle: 'Google Play',
    poseViewerClose: 'Cerrar la imagen',
    poseViewerOpen: 'Ver la ilustración de Bip a tamaño grande',
    heroImgAlt: 'Bip, la mascota de Bipsy, con el móvil frente a una barbería',

    challengeLabel: 'El punto de partida',
    challengeBody:
      'En la mayoría de barberías, peluquerías y centros de estética la agenda sigue viviendo en un cuaderno, en un WhatsApp a deshora o en una llamada que nadie coge mientras hay un cliente en la silla. El negocio pierde huecos que jamás sabrá que perdió; el cliente pierde la paciencia.',
    solutionLabel: 'Nuestra apuesta',
    solutionBody:
      'Un único ecosistema y cero fricción: el cliente descubre, reserva y recuerda su cita desde el móvil; el negocio ve el día entero en una pantalla y confirma con un gesto. Sin panel de escritorio, sin manual de instrucciones y sin cambiar cómo trabaja.',

    ecoEyebrow: 'EL ECOSISTEMA',
    ecoTitle: 'Dos aplicaciones, un mismo motor.',
    ecoSub: 'Cada lado del mostrador tiene su app. Comparten catálogo, disponibilidad y estado de la cita en tiempo real.',
    apps: [
      {
        name: 'Bipsy',
        audience: 'Para quien reserva',
        accent: 'mint',
        desc: 'La app de cliente. Encuentra el sitio, elige servicio y profesional, y confirma la hora sin escribir a nadie.',
        alt: 'Pantalla de descubrimiento de la app Bipsy junto a Bip',
        features: [
          'Descubrimiento por categoría: barbería, peluquería, estética',
          'Disponibilidad real y reserva en dos toques',
          'Recordatorios antes de la cita, sin llamadas',
          'Historial para repetir la última reserva',
          'Profesional habitual y negocios favoritos',
          'Valoraciones verificadas tras el servicio',
        ],
      },
      {
        name: 'Bipsy Business',
        audience: 'Para el negocio',
        accent: 'slate',
        desc: 'La app del salón. La agenda del día entera en una pantalla, con todo lo necesario para confirmar, mover o cerrar un hueco.',
        alt: 'Pantalla de agenda de la app Bipsy Business junto a Bip',
        features: [
          'Agenda de hoy, pendientes y próximos días',
          'Confirmar o cancelar una cita con un gesto',
          'Servicios con duración y precio propios',
