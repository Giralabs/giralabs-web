      { phase: 'Building both apps', state: 'active', stateLabel: 'In progress', body: 'Booking engine, real-time agenda and the two Flutter applications.' },
      { phase: 'Closed beta with pilot venues', state: 'next', stateLabel: 'Next', body: 'A small group of salons running Bipsy on their real working day.' },
      { phase: 'App Store and Google Play release', state: 'planned', stateLabel: 'Planned', body: 'Public launch of Bipsy and Bipsy Business.' },
