  poseSources.map((src) => getImage({ src, format: 'webp', height: 440 }))
);
// Full-size copies for the pose viewer
const posesLarge = await Promise.all(
  poseSources.map((src) => getImage({ src, format: 'webp', height: 900 }))
);

// Painted at most ~540px wide
const webShots = await Promise.all([webClient, webBusiness].map((src) => getImage({ src, format: 'webp', width: 1100 })));

// Phones are painted ~230px wide: 460 covers 2x screens
const shot = (src: ImageMetadata) => getImage({ src, format: 'webp', width: 460 });
const clientShots = await Promise.all([shotExplore, shotMap, shotWho, shotWhen, shotMine].map(shot));
const businessShots = await Promise.all([shotAgenda, shotServices, shotClient, shotChat, shotTeam, shotReviews].map(shot));

