<script>
  function initPoseViewer() {
    const viewer = document.querySelector<HTMLElement>('[data-pose-viewer]');
    const image = viewer?.querySelector<HTMLImageElement>('[data-pose-image]');
    if (!viewer || !image || viewer.dataset.poseReady === 'true') return;
    viewer.dataset.poseReady = 'true';

    let lastTrigger: HTMLElement | null = null;

    const open = (trigger: HTMLElement) => {
      const src = trigger.dataset.poseSrc;
      if (!src) return;
      lastTrigger = trigger;
      image.src = src;
      viewer.hidden = false;
      // next frame, so the transition runs from the hidden state
      requestAnimationFrame(() => viewer.classList.add('is-open'));
      document.documentElement.classList.add('bp-viewer-open');
      viewer.querySelector<HTMLElement>('.bp-viewer-close')?.focus();
    };

    const close = () => {
      viewer.classList.remove('is-open');
      document.documentElement.classList.remove('bp-viewer-open');
      window.setTimeout(() => {
        viewer.hidden = true;
        image.src = '';
      }, 300);
      lastTrigger?.focus();
    };

    document.querySelectorAll<HTMLElement>('[data-pose-open]').forEach((btn) => {
      btn.addEventListener('click', () => open(btn));
    });
    viewer.querySelectorAll<HTMLElement>('[data-pose-close]').forEach((el) => {
      el.addEventListener('click', close);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !viewer.hidden) close();
    });
  }

  initPoseViewer();
  document.addEventListener('astro:after-swap', initPoseViewer);
</script>

