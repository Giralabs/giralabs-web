      { title: 'Consistent across both apps', body: 'Same character, different wardrobe: hoodie on Bipsy, suit on Business.' },
    ],

    roadmapEyebrow: 'DEVELOPMENT STATUS',
    roadmapTitle: 'Where is Bipsy right now?',
    roadmapSub: 'We update this section as we move forward. Right now we are here:',
    roadmap: [
      { phase: 'Discovery and validation', state: 'done', stateLabel: 'Done', body: 'Interviews with barbershops and hair salons to understand how they run their calendar today.' },
