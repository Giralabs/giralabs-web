    ],

    stackEyebrow: 'TECNOLOGÍA',
    stackTitle: 'Stack técnico',
    stackSub: 'Elegido para que dos apps compartan motor sin duplicar equipo ni deuda técnica.',
    stack: ['Flutter', 'Dart', 'Go', 'Supabase', 'PostgreSQL', 'Firebase', 'Realtime', 'Figma'],

    brandEyebrow: 'SISTEMA DE MARCA',
    brandTitle: 'Una identidad, dos aplicaciones.',
    brandSub: 'Bipsy habla en menta; Bipsy Business, en grafito. Mismo símbolo, misma tipografía, distinta temperatura.',
    brandColorsLabel: 'Paleta',
    colors: [
      { name: 'Mint', hex: '#C0EBD1', note: 'Bipsy' },
      { name: 'Carbon', hex: '#31373C', note: 'Texto y símbolo' },
      { name: 'Slate', hex: '#6D7174', note: 'Bipsy Business' },
      { name: 'Cloud', hex: '#F5F6F5', note: 'Fondos' },
    ],
    brandLockups: [
      { label: 'Aplicación de cliente', caption: 'Bipsy' },
      { label: 'Aplicación de negocio', caption: 'Bipsy Business' },
    ],

    pilotEyebrow: 'BUSCAMOS PILOTOS',
    pilotTitle: '¿Tienes un salón y te apetece probarlo antes que nadie?',
    pilotBody:
      'Estamos cerrando el grupo de negocios que estrenarán Bipsy Business en la beta. Sin coste, con acompañamiento nuestro y con tu opinión metida directamente en el producto.',
    pilotCta: 'Quiero ser piloto',
    pilotSecondary: 'Hablar con el equipo',

    serviceEyebrow: 'SERVICIO RELACIONADO',
    serviceIntro: 'Desarrollado bajo el servicio:',
    serviceName: 'Creación de aplicaciones móviles',
    serviceCta: 'Ver detalles del servicio',
    serviceSlug: '/servicio/aplicaciones-moviles',
  },
  en: {
    breadcrumbHome: 'Home',
    breadcrumbProjects: 'Projects',
    back: 'All projects',
    status: 'In development',
    heroEyebrow: 'AN IN-HOUSE GIRALABS PRODUCT',
    heroLead: 'Booking at your barbershop, hair salon or beauty studio should take two taps. Running it, none at all.',
    heroDesc:
      'Bipsy is the booking ecosystem we are building in-house: two mobile apps sharing one engine, one for the person booking and one for the person running the place. It is not published yet — it is in active development, and we are building it out in the open.',
    storesLabel: 'Coming soon on',
    storeApple: 'App Store',
    storeGoogle: 'Google Play',
    poseViewerClose: 'Close the image',
    poseViewerOpen: 'View the Bip illustration at full size',
    heroImgAlt: 'Bip, the Bipsy mascot, holding a phone in front of a barbershop',

    challengeLabel: 'The starting point',
    challengeBody:
      'In most barbershops, hair salons and beauty studios the calendar still lives in a notebook, in a late-night WhatsApp or in a call nobody picks up while a client is in the chair. The venue loses slots it will never know it lost; the client loses patience.',
    solutionLabel: 'Our bet',
    solutionBody:
      'One ecosystem and zero friction: the client discovers, books and remembers the appointment from the phone; the venue sees the whole day on one screen and confirms with a single gesture. No desktop panel, no manual, no change in how they already work.',

    ecoEyebrow: 'THE ECOSYSTEM',
    ecoTitle: 'Two apps, one engine.',
    ecoSub: 'Each side of the counter gets its own app. They share catalogue, availability and appointment state in real time.',
    apps: [
      {
        name: 'Bipsy',
        audience: 'For the client',
        accent: 'mint',
        desc: 'The client app. Find the place, pick service and professional, and lock the time without messaging anyone.',
        alt: 'Discovery screen of the Bipsy app next to Bip',
        features: [
          'Discovery by category: barbershop, hair salon, beauty',
          'Real availability and booking in two taps',
          'Reminders before the appointment, no calls',
          'History to repeat your last booking',
          'Preferred professional and favourite venues',
          'Verified reviews after the service',
        ],
      },
      {
        name: 'Bipsy Business',
        audience: 'For the venue',
        accent: 'slate',
        desc: 'The salon app. The entire day on one screen, with everything needed to confirm, move or fill a slot.',
        alt: 'Agenda screen of the Bipsy Business app next to Bip',
        features: [
          'Today, pending and upcoming days at a glance',
          'Confirm or cancel an appointment in one gesture',
          'Services with their own duration and price',
          'Team, shifts and schedule per professional',
          'Client profile with notes and history',
          'Open slots always in sight',
        ],
      },
    ],

    flowEyebrow: 'HOW IT WORKS',
    flowTitle: 'From sign-up to the chair, in four steps.',
    flow: [
      { title: 'The venue signs up', body: 'Straight from Bipsy Business on the phone: venue details, team and time zone.' },
      { title: 'It publishes services and hours', body: 'Every service with its duration, its price and the professionals who deliver it.' },
      { title: 'The client books', body: 'They find the salon on Bipsy, see the real open slots and confirm instantly.' },
      { title: 'Both see the same thing', body: 'The appointment lands on the venue agenda and on the client phone, in sync.' },
    ],

    bipEyebrow: 'IDENTITY',
    bipTitle: 'Meet Bip.',
    bipBody:
      'Bip is the face of Bipsy. It shows up when a screen is empty, when something breaks and when there is something to celebrate. Not decoration: it is the product tone of voice turned into a character, and the reason a booking app can actually be likeable.',
    bipNote: 'Four poses from the illustration system.',
    bipSupportAlt: 'Bip wearing a headset, working at a desk',
    bipTraits: [
      { title: 'Warm, never childish', body: 'It keeps you company without getting in the way: it appears exactly where people hesitate.' },
