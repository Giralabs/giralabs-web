  getImage({ src: iconClient, format: 'webp', width: 112 }),
  getImage({ src: iconBusiness, format: 'webp', width: 112 }),
]);

const poseSources = [poseHello, poseRecool, posePockets, poseLaughing];
// Painted ~210px tall in the strip
