const c = isEs ? copy.es : copy.en;
const appVisuals = [appClient, appBusiness];

// The rail is filled up to the phase currently under way
const activeIndex = c.roadmap.findIndex((phase) => phase.state === 'active');
---

<!-- ==================== BREADCRUMB ==================== -->
<nav class="bp-breadcrumb reveal" aria-label="Breadcrumb">
  <div class="bp-breadcrumb-inner">
    <div class="bp-breadcrumb-trail">
      <a href={localizedPath('/')} class="bp-crumb-link">{c.breadcrumbHome}</a>
      <span class="bp-crumb-sep" aria-hidden="true">&gt;</span>
      <a href={localizedPath('/proyectos')} class="bp-crumb-link">{c.breadcrumbProjects}</a>
      <span class="bp-crumb-sep" aria-hidden="true">&gt;</span>
      <span class="bp-crumb-current">Bipsy</span>
    </div>
    <a href={localizedPath('/proyectos')} class="bp-back">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span>{c.back}</span>
    </a>
  </div>
</nav>

<main class="bp-main">
  <!-- ==================== HERO ==================== -->
  <header class="bp-hero reveal">
    <div class="bp-hero-glass">
      <div class="bp-hero-aura" aria-hidden="true"></div>

      <div class="bp-hero-content">
        <p class="bp-hero-eyebrow">
          {c.heroEyebrow}<span class="bp-hero-status"> — {c.status}</span>
        </p>

        <h1 class="bp-hero-title">Bipsy</h1>

        <p class="bp-hero-lead">{c.heroLead}</p>
        <p class="bp-hero-desc">{c.heroDesc}</p>

        <div class="bp-stores">
          <p class="bp-stores-label">{c.storesLabel}</p>
          <div class="bp-stores-badges">
            <span class="bp-badge">
              <svg class="bp-badge-glyph" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path fill="currentColor" d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
              </svg>
              <span class="bp-badge-name">{c.storeApple}</span>
            </span>
            <span class="bp-badge">
              <svg class="bp-badge-glyph" viewBox="0 0 512 512" width="19" height="19" aria-hidden="true">
                <path fill="#00D0FF" d="M47.6 24.1C42.5 29.5 39.5 37.9 39.5 48.7v414.6c0 10.9 3 19.2 8.1 24.6l1.4 1.4 232.3-232.3v-5.5L49 23.2z"/>
                <path fill="#FFD500" d="M357.7 343.4l-77.4-77.4v-5.5l77.4-77.4 1.7 1L451.7 236c26.2 14.8 26.2 39.2 0 54.2l-92.3 52.4z"/>
                <path fill="#FF3A44" d="M359.4 342.6L280.3 263.5 47.6 496.2c8.7 9.2 22.9 10.3 39.1 1.1z"/>
                <path fill="#00F076" d="M359.4 184.4L86.7 30.1C70.5 20.8 56.3 22 47.6 31.2l232.7 232.3z"/>
              </svg>
              <span class="bp-badge-name">{c.storeGoogle}</span>
            </span>
          </div>
        </div>
      </div>

      <div class="bp-hero-visual">
        <div class="bp-hero-visual-glow" aria-hidden="true"></div>
        <img
          src={heroVisual.src}
          alt={c.heroImgAlt}
          class="bp-hero-img"
          width="900"
          height="900"
          loading="eager"
        />
      </div>
    </div>
  </header>

  <!-- ==================== CONTEXT ==================== -->
  <section class="bp-section bp-context reveal" aria-label={c.challengeLabel}>
    <div class="bp-context-col">
      <p class="bp-context-label">{c.challengeLabel}</p>
      <p class="bp-context-body">{c.challengeBody}</p>
    </div>
    <div class="bp-context-col bp-context-col--answer">
      <p class="bp-context-label">{c.solutionLabel}</p>
      <p class="bp-context-body">{c.solutionBody}</p>
    </div>
  </section>

  <!-- ==================== THE TWO APPS ==================== -->
  <section class="bp-section reveal" id="apps">
    <div class="bp-head">
      <p class="bp-eyebrow">{c.ecoEyebrow}</p>
      <h2 class="bp-title">{c.ecoTitle}</h2>
      <p class="bp-sub">{c.ecoSub}</p>
    </div>

    <div class="bp-apps">
      {c.apps.map((app, i) => (
        <article class={`bp-glass bp-app bp-app--${app.accent}`}>
          <div class="bp-app-glow" aria-hidden="true"></div>

          <header class="bp-app-head">
            <img
              src={i === 0 ? markClient.src : markBusiness.src}
              alt={app.name}
              class={`bp-app-mark bp-app-mark--${app.accent}`}
              width="1582"
              height={i === 0 ? 444 : 547}
              loading="lazy"
            />
            <span class="bp-app-audience">{app.audience}</span>
          </header>

          <p class="bp-app-desc">{app.desc}</p>

          <div class="bp-app-shot">
            <img src={appVisuals[i].src} alt={app.alt} width="900" height="688" loading="lazy" />
          </div>

          <ul class="bp-app-features" role="list">
            {app.features.map((feature) => (
              <li class="bp-feature">
                <span class="bp-feature-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- ==================== HOW IT WORKS ==================== -->
  <section class="bp-section reveal">
    <div class="bp-head">
      <p class="bp-eyebrow">{c.flowEyebrow}</p>
      <h2 class="bp-title">{c.flowTitle}</h2>
    </div>

    <ol class="bp-flow" role="list">
      {c.flow.map((step, i) => (
        <li class="bp-glass bp-flow-step" style={`--i: ${i}`}>
          <span class="bp-flow-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="bp-flow-title">{step.title}</h3>
          <p class="bp-flow-body">{step.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ==================== MEET BIP ==================== -->
  <section class="bp-section reveal" id="bip">
    <div class="bp-glass bp-bip">
      <div class="bp-bip-aura" aria-hidden="true"></div>

      <div class="bp-bip-intro">
        <p class="bp-eyebrow">{c.bipEyebrow}</p>
        <h2 class="bp-title">{c.bipTitle}</h2>
        <p class="bp-bip-body">{c.bipBody}</p>

        <ul class="bp-bip-traits" role="list">
          {c.bipTraits.map((trait) => (
            <li class="bp-trait">
              <h3 class="bp-trait-title">{trait.title}</h3>
              <p class="bp-trait-body">{trait.body}</p>
            </li>
          ))}
        </ul>
      </div>

