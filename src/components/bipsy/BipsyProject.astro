    flow: [
      { title: 'El negocio se da de alta', body: 'Desde Bipsy Business, en el móvil: datos del salón, equipo y zona horaria.' },
      { title: 'Publica servicios y horarios', body: 'Cada servicio con su duración, su precio y los profesionales que lo realizan.' },
      { title: 'El cliente reserva', body: 'Encuentra el salón en Bipsy, ve los huecos reales y confirma su cita al instante.' },
