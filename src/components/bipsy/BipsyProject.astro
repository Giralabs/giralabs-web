  // Painted at most 320px wide; 640 covers 2x screens
  getImage({ src: bipsyWordmark, format: 'webp', width: 640 }),
  getImage({ src: shotAgenda, format: 'webp', width: 520 }),
  // Painted 44px tall (~148px wide); 3x covers every screen
  getImage({ src: appStoreBadge, format: 'webp', width: 450 }),
  getImage({ src: poseLaughing, format: 'webp', height: 640 }),
  // Bip in front of the phones, painted ~300px tall
