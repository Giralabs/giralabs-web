---
import { getImage } from 'astro:assets';
import apricotSymbol from '../assets/brand_marks/apricot_symbol_nobackground.avif';
import { translations } from '../i18n/translations';
import { getSwitchLanguagePath, getLocalizedPath, hasEnglishAlternate } from '../lib/paths';

interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;
const T = translations[lang];

// The symbol is painted at 34px (top bar) and 24px (scrolled pill); one 68px
// render covers both at 2x instead of shipping the full-size master.
const navSymbol = await getImage({ src: apricotSymbol, format: 'webp', width: 68 });

// Dynamic routing for lang switch
const pathname = Astro.url.pathname;
const esUrlPath = getSwitchLanguagePath(pathname, 'es');
const enUrlPath = getSwitchLanguagePath(pathname, 'en');

const esHref = esUrlPath === '/' ? '/' : esUrlPath;
// Posts published only in Spanish have no English URL: send the switcher to the
// English blog index rather than to a 404
const enHref = hasEnglishAlternate(pathname) ? enUrlPath : '/en/blog';

// Helper to localize paths based on the current lang
const localizedPath = (path: string) => getLocalizedPath(path, lang);

const isEn = lang === 'en';
const L = {
  nav: isEn ? 'Main navigation' : 'Navegación principal',
  home: isEn ? 'Giralabs, home page' : 'Giralabs, página de inicio',
  language: isEn ? 'Language' : 'Idioma',
  openMenu: isEn ? 'Open menu' : 'Abrir menú',
  closeMenu: isEn ? 'Close menu' : 'Cerrar menú',
};

// aria-current tells screen readers which entry is the page they are on
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (path: string) => {
  const target = localizedPath(path).replace(/\/$/, '') || '/';
  return target === currentPath ? 'page' : undefined;
};
---

<nav id="navbar" aria-label={L.nav}>
  <!-- Top bar: visible before scroll -->
  <div class="nav-top-bar" id="nav-top-bar">
    <div class="nav-inner">
      <!-- Logo -->
      <a href={localizedPath("/")} class="nav-logo" aria-label={L.home} id="nav-logo-link">
        <div class="nav-logo-wrapper">
          <div class="nav-logo-entrance">
            <img src={navSymbol.src} alt="" class="nav-logo-img" width="34" height="34" fetchpriority="high" decoding="async" />
          </div>
        </div>
        <span class="nav-brand-name" aria-hidden="true">
          <span class="nb-char" style="--d:0.05s">G</span><span class="nb-char" style="--d:0.09s">I</span><span class="nb-char" style="--d:0.13s">R</span><span class="nb-char" style="--d:0.17s">A</span><span class="nb-char" style="--d:0.21s">L</span><span class="nb-char" style="--d:0.25s">A</span><span class="nb-char" style="--d:0.29s">B</span><span class="nb-char" style="--d:0.33s">S</span>
        </span>
      </a>

      <!-- Center nav links -->
      <ul class="nav-links" role="list">
        <li><a href={localizedPath("/")} class="nav-link" data-i18n="nav_home" aria-current={current("/")}>{T.nav_home}</a></li>
        <li class="nav-dropdown-wrapper">
          <a href={localizedPath("/servicios")} class="nav-link dropdown-toggle" aria-current={current("/servicios")}>
            <span data-i18n="nav_services">{T.nav_services}</span>
            <svg class="chevron-icon" aria-hidden="true" viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <div class="nav-dropdown-menu lg">
            <a href={localizedPath("/servicios")} class="dropdown-item main-item" data-i18n="nav_services_all">{T.nav_services_all}</a>
            <div class="dropdown-divider"></div>
            <a href={localizedPath("/servicio/aplicaciones-moviles")} class="dropdown-item" data-i18n="service_1_title">{T.service_1_title}</a>
            <a href={localizedPath("/servicio/paginas-web")} class="dropdown-item" data-i18n="service_2_title">{T.service_2_title}</a>
            <a href={localizedPath("/servicio/digitalizacion-empresas")} class="dropdown-item" data-i18n="service_3_title">{T.service_3_title}</a>
            <a href={localizedPath("/servicio/tiendas-online")} class="dropdown-item" data-i18n="service_4_title">{T.service_4_title}</a>
            <a href={localizedPath("/servicio/software-a-medida")} class="dropdown-item" data-i18n="service_5_title">{T.service_5_title}</a>
            <a href={localizedPath("/servicio/integracion-ia")} class="dropdown-item" data-i18n="service_6_title">{T.service_6_title}</a>
          </div>
        </li>
        <li><a href={localizedPath("/proyectos")} class="nav-link" data-i18n="nav_projects" aria-current={current("/proyectos")}>{T.nav_projects}</a></li>
        <li><a href={localizedPath("/nosotros")} class="nav-link" data-i18n="nav_about" aria-current={current("/nosotros")}>{T.nav_about}</a></li>
        <li><a href={localizedPath("/blog")} class="nav-link" data-i18n="nav_blog" aria-current={current("/blog")}>{T.nav_blog}</a></li>
      </ul>

      <!-- Right -->
      <div class="nav-right">
        <div class="lang-toggle" role="group" aria-label={L.language}>
          <a href={esHref} id="lang-es" class={`lang-opt ${lang === 'es' ? 'active' : ''}`} hreflang="es" lang="es" aria-label="Español" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
          <span class="lang-sep" aria-hidden="true">/</span>
          <a href={enHref} id="lang-en" class={`lang-opt ${lang === 'en' ? 'active' : ''}`} hreflang="en" lang="en" aria-label="English" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </div>
        <a href={localizedPath("/contacto")} class="nav-cta lg-press" id="nav-cta-btn" data-i18n="nav_cta">{T.nav_cta}</a>
        <button class="hamburger" id="hamburger-btn" aria-label={L.openMenu} data-label-open={L.openMenu} data-label-close={L.closeMenu} aria-expanded="false" aria-controls="mobile-drawer" type="button">
          <span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Floating glass pill: appears on scroll. `inert` (not just aria-hidden)
       while hidden, so its links can't be tabbed to while invisible. -->
  <div class="nav-pill" id="nav-pill" inert>
    <div class="pill-inner lg">
      <a href={localizedPath("/")} class="pill-logo" aria-label={L.home}>
        <img src={navSymbol.src} alt="" width="24" height="24" decoding="async" />
      </a>
      <ul class="pill-links" role="list">
        <li><a href={localizedPath("/")} class="pill-link" data-i18n="nav_home" aria-current={current("/")}>{T.nav_home}</a></li>
        <li class="pill-dropdown-wrapper">
          <a href={localizedPath("/servicios")} class="pill-link dropdown-toggle" aria-current={current("/servicios")}>
            <span data-i18n="nav_services">{T.nav_services}</span>
            <svg class="chevron-icon" aria-hidden="true" viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <div class="pill-dropdown-menu lg">
            <a href={localizedPath("/servicios")} class="dropdown-item main-item" data-i18n="nav_services_all">{T.nav_services_all}</a>
            <div class="dropdown-divider"></div>
            <a href={localizedPath("/servicio/aplicaciones-moviles")} class="dropdown-item" data-i18n="service_1_title">{T.service_1_title}</a>
            <a href={localizedPath("/servicio/paginas-web")} class="dropdown-item" data-i18n="service_2_title">{T.service_2_title}</a>
            <a href={localizedPath("/servicio/digitalizacion-empresas")} class="dropdown-item" data-i18n="service_3_title">{T.service_3_title}</a>
            <a href={localizedPath("/servicio/tiendas-online")} class="dropdown-item" data-i18n="service_4_title">{T.service_4_title}</a>
            <a href={localizedPath("/servicio/software-a-medida")} class="dropdown-item" data-i18n="service_5_title">{T.service_5_title}</a>
            <a href={localizedPath("/servicio/integracion-ia")} class="dropdown-item" data-i18n="service_6_title">{T.service_6_title}</a>
          </div>
        </li>
        <li><a href={localizedPath("/proyectos")} class="pill-link" data-i18n="nav_projects" aria-current={current("/proyectos")}>{T.nav_projects}</a></li>
        <li><a href={localizedPath("/nosotros")} class="pill-link" data-i18n="nav_about" aria-current={current("/nosotros")}>{T.nav_about}</a></li>
        <li><a href={localizedPath("/blog")} class="pill-link" data-i18n="nav_blog" aria-current={current("/blog")}>{T.nav_blog}</a></li>
      </ul>
      <div class="pill-right">
        <div class="lang-toggle pill-lang" role="group" aria-label={L.language}>
          <a href={esHref} id="pill-lang-es" class={`lang-opt ${lang === 'es' ? 'active' : ''}`} hreflang="es" lang="es" aria-label="Español" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
          <span class="lang-sep" aria-hidden="true">/</span>
          <a href={enHref} id="pill-lang-en" class={`lang-opt ${lang === 'en' ? 'active' : ''}`} hreflang="en" lang="en" aria-label="English" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </div>
        <a href={localizedPath("/contacto")} class="pill-cta lg-press" data-i18n="nav_cta">{T.nav_cta}</a>
      </div>
    </div>
  </div>

  <!-- Mobile drawer: `inert` while closed so its links stay out of the tab order -->
  <div class="mobile-drawer lg" id="mobile-drawer" inert>
    <ul class="mobile-links" role="list">
      <li><a href={localizedPath("/")} class="mobile-link" data-i18n="nav_home" aria-current={current("/")}>{T.nav_home}</a></li>
      <li class="mobile-dropdown-wrapper">
        <button class="mobile-link mobile-dropdown-toggle" type="button" aria-expanded="false" aria-controls="mobile-services-menu">
          <span data-i18n="nav_services">{T.nav_services}</span>
          <svg class="mobile-chevron-icon" aria-hidden="true" viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="mobile-dropdown-menu" id="mobile-services-menu">
          <a href={localizedPath("/servicios")} class="mobile-sublink main-item" data-i18n="nav_services_all">{T.nav_services_all}</a>
          <a href={localizedPath("/servicio/aplicaciones-moviles")} class="mobile-sublink" data-i18n="service_1_title">{T.service_1_title}</a>
          <a href={localizedPath("/servicio/paginas-web")} class="mobile-sublink" data-i18n="service_2_title">{T.service_2_title}</a>
          <a href={localizedPath("/servicio/digitalizacion-empresas")} class="mobile-sublink" data-i18n="service_3_title">{T.service_3_title}</a>
          <a href={localizedPath("/servicio/tiendas-online")} class="mobile-sublink" data-i18n="service_4_title">{T.service_4_title}</a>
          <a href={localizedPath("/servicio/software-a-medida")} class="mobile-sublink" data-i18n="service_5_title">{T.service_5_title}</a>
          <a href={localizedPath("/servicio/integracion-ia")} class="mobile-sublink" data-i18n="service_6_title">{T.service_6_title}</a>
        </div>
      </li>
      <li><a href={localizedPath("/proyectos")} class="mobile-link" data-i18n="nav_projects" aria-current={current("/proyectos")}>{T.nav_projects}</a></li>
      <li><a href={localizedPath("/nosotros")} class="mobile-link" data-i18n="nav_about" aria-current={current("/nosotros")}>{T.nav_about}</a></li>
      <li><a href={localizedPath("/blog")} class="mobile-link" data-i18n="nav_blog" aria-current={current("/blog")}>{T.nav_blog}</a></li>
      <li><a href={localizedPath("/empleo")} class="mobile-link" data-i18n="nav_careers" aria-current={current("/empleo")}>{T.nav_careers}</a></li>
      <li><a href={localizedPath("/contacto")} class="mobile-link mobile-cta lg-press" data-i18n="nav_cta">{T.nav_cta}</a></li>
    </ul>
  </div>
</nav>

<style>
  /* =============================================
     NAVBAR WRAPPER
  ============================================= */
  #navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
  }

  /* =============================================
     TOP BAR (visible when at top)
  ============================================= */
  .nav-top-bar {
    padding: 0 2rem;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .nav-top-bar.hidden {
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .nav-logo-wrapper {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 600px;
  }

  /* 3D entrance animation container */
  .nav-logo-entrance {
    opacity: 0;
    animation: navLogoFlip 1.4s cubic-bezier(0.25, 1, 0.3, 1) 0.1s forwards;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .nav-logo:hover .nav-logo-entrance {
    transform: rotateY(180deg);
  }

  .nav-logo-img {
    width: 32px;
    height: auto;
    display: block;
    filter: drop-shadow(0 2px 6px rgba(0,0,0,0.06));
  }

  .nav-brand-name {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #000;
    display: flex;
    overflow: hidden;
    padding-right: 4px;
  }

  /* Individual letter spans */
  .nb-char {
    display: inline-block;
    opacity: 0;
    transform: translateY(100%);
    animation: navCharReveal 0.6s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    animation-delay: var(--d);
  }

  @keyframes navLogoFlip {
    0%   { opacity: 0; transform: rotateY(-300deg) scale(0.7); }
    100% { opacity: 1; transform: rotateY(0deg) scale(1); }
  }

  @keyframes navCharReveal {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Nav links */
  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2rem;
    flex: 1;
    justify-content: center;
  }

  .nav-link {
    font-size: 0.85rem;
    font-weight: 400;
    color: #555;
    text-decoration: none;
    position: relative;
    transition: color 0.2s ease;
    letter-spacing: -0.005em;
    display: inline-flex;
    align-items: center;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 100%;
    height: 1px;
    background: #000;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .nav-link:hover { color: #000; }
  .nav-link:hover::after { transform: scaleX(1); transform-origin: left; }

  /* =============================================
     NAVBAR DROPDOWN (Hover triggers)
  ============================================= */
  .nav-dropdown-wrapper {
    position: relative;
  }

  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(12px) scale(0.96);
    transform-origin: top center;
    width: 250px;
    /* Liquid Glass (.lg) supplies the material; a denser tint keeps menu
       text readable over whatever is scrolling behind it */
    --lg-tint-top: rgba(250, 249, 245, 0.82);
    --lg-tint-bottom: rgba(244, 243, 238, 0.7);
    --lg-blur: 30px;
    border-radius: 20px;
    padding: 0.5rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.45s var(--ease-spring),
      visibility 0.25s;
    transition-delay: 0.12s; /* 120ms delay when closing to prevent slip-offs */
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .nav-dropdown-wrapper::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    bottom: -12px;
    background: transparent;
    pointer-events: none;
    z-index: 10;
  }

  .nav-dropdown-wrapper:hover::after {
    pointer-events: auto;
  }

  /* :focus-within opens the menu for keyboard users too: tabbing onto
     "Services" reveals the sub-pages, and Tab walks through them */
  .nav-dropdown-wrapper:hover .nav-dropdown-menu,
  .nav-dropdown-wrapper:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(4px) scale(1);
    transition-delay: 0s; /* Open instantly on hover */
  }

  .nav-dropdown-wrapper.dismissed .nav-dropdown-menu,
  .pill-dropdown-wrapper.dismissed .pill-dropdown-menu {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .chevron-icon {
    display: inline-block;
    margin-left: 4px;
    vertical-align: middle;
    position: relative;
    top: 1px;
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .nav-dropdown-wrapper:hover .chevron-icon,
  .pill-dropdown-wrapper:hover .chevron-icon,
  .nav-dropdown-wrapper:focus-within .chevron-icon,
  .pill-dropdown-wrapper:focus-within .chevron-icon {
    transform: rotate(180deg);
  }

  /* =============================================
     PILL DROPDOWN
  ============================================= */
  .pill-dropdown-wrapper {
    position: relative;
  }

  .pill-link {
    display: inline-flex;
    align-items: center;
  }

  .pill-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(16px) scale(0.96);
    transform-origin: top center;
    width: 240px;
    --lg-tint-top: rgba(250, 249, 245, 0.82);
    --lg-tint-bottom: rgba(244, 243, 238, 0.7);
    --lg-blur: 30px;
    border-radius: 20px;
    padding: 0.5rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.45s var(--ease-spring),
      visibility 0.25s;
    transition-delay: 0.12s; /* 120ms delay when closing to prevent slip-offs */
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .pill-dropdown-wrapper::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    bottom: -16px;
    background: transparent;
    pointer-events: none;
    z-index: 10;
  }

  .pill-dropdown-wrapper:hover::after {
    pointer-events: auto;
  }

  .pill-dropdown-wrapper:hover .pill-dropdown-menu,
  .pill-dropdown-wrapper:focus-within .pill-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(8px) scale(1);
    transition-delay: 0s; /* Open instantly on hover */
  }

  /* =============================================
     DROPDOWN SHARED ITEMS
  ============================================= */
  .dropdown-item {
    display: block;
    padding: 0.6rem 0.8rem;
    border-radius: 13px;
    font-size: 0.8rem;
    color: var(--ink-muted);
    text-decoration: none;
    text-align: left;
    transition: background-color 0.2s, color 0.2s, transform 0.35s var(--ease-spring), box-shadow 0.2s;
  }

  /* Hover lifts a small glass chip out of the menu, like the iOS selection pill */
  .dropdown-item:hover,
  .dropdown-item:focus-visible {
    background: rgba(255, 255, 255, 0.7);
    color: #000;
    transform: translateX(3px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 1px 2px rgba(0, 0, 0, 0.05),
      0 4px 12px -4px rgba(0, 0, 0, 0.1);
  }

  .dropdown-item:focus-visible {
    outline-offset: -2px;
  }

  .dropdown-item.main-item {
    font-weight: 600;
    color: #000;
  }

  .dropdown-divider {
    height: 1px;
    background: rgba(0, 0, 0, 0.06);
    margin: 0.25rem 0.5rem;
  }

  /* =============================================
     MOBILE ACCORDION DROPDOWN
  ============================================= */
  .mobile-dropdown-wrapper {
    width: 100%;
  }

  .mobile-dropdown-toggle {
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-family: inherit;
    padding: 0.75rem 0;
    font-size: 1.1rem;
    font-weight: 400;
    color: #333;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .mobile-chevron-icon {
    transition: transform 0.3s ease;
    color: #888;
  }

  .mobile-dropdown-menu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    display: flex;
    flex-direction: column;
    padding-left: 0.8rem;
  }

  .mobile-dropdown-wrapper.open .mobile-dropdown-menu {
    max-height: 380px;
  }

  .mobile-dropdown-wrapper.open .mobile-chevron-icon {
    transform: rotate(180deg);
  }

  .mobile-sublink {
    display: block;
    padding: 0.65rem 0;
    font-size: 0.88rem;
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid rgba(0,0,0,0.03);
    transition: color 0.2s;
  }

  .mobile-sublink:hover {
    color: #000;
  }

  .mobile-sublink.main-item {
    font-weight: 600;
    color: #333;
  }

  /* Right cluster */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex-shrink: 0;
  }

  /* Lang toggle */
  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink-subtle);
    transition: color 0.2s;
  }

  /* The inactive language used to be #888 at 40% opacity (~1.6:1). It is a
     real link, so it now meets AA and relies on weight to show the active one. */
  .lang-opt {
    text-decoration: none;
    color: var(--ink-subtle);
