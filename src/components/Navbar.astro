    flex-shrink: 0;
  }

  /* =============================================
     MOBILE DRAWER
  ============================================= */
  /* Mobile menu: a floating Liquid Glass sheet that springs down from the
     header, inset from the screen edges like an iOS popover */
  .mobile-drawer {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 12px;
    right: 12px;
    z-index: 99;
    flex-direction: column;
