  .pill-inner {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0.6rem 1rem 0.6rem 1rem;
    border-radius: 100px;
    min-width: 740px;

    /* Liquid Glass (.lg): a thinner, clearer tint than the menus so the page
       visibly flows under the bar, with a wide pointer light for its size */
    --lg-tint-top: rgba(255, 255, 255, 0.5);
    --lg-tint-bottom: rgba(245, 244, 239, 0.32);
    --lg-blur: 26px;
    --lg-saturate: 210%;
    --lg-light-size: 260px;
