    background: linear-gradient(180deg, rgba(40, 40, 40, 0.9), rgba(0, 0, 0, 0.92));
    color: #F7F6F2;
    border: none;
    box-shadow:
      inset 0 1px 0.5px rgba(255, 255, 255, 0.28),
