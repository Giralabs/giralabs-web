    left: 50%;
    transform: translateX(-50%) translateY(-80px);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.5s cubic-bezier(0.34, 1.2, 0.64, 1), opacity 0.4s ease;
    z-index: 101;
