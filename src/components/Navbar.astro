<script>
  // ---- Scroll: show pill, hide top bar ----
  const topBar = document.getElementById('nav-top-bar')!;
  const pill = document.getElementById('nav-pill')!;
  const THRESHOLD = 80;

  // window.innerWidth was read on every scroll event, which forces the browser to
  // flush layout before it can answer. matchMedia caches the same answer and only
  // recomputes when the breakpoint is actually crossed.
  const mobileQuery = window.matchMedia('(max-width: 768px)');
  let ticking = false;

  function updateNav() {
    ticking = false;
    const scrolled = window.scrollY > THRESHOLD;
    // Whichever bar is invisible is also inert: aria-hidden alone hid it from
    // screen readers but left its links in the Tab order, focusing nothing visible
    if (mobileQuery.matches) {
      topBar.classList.remove('hidden');
      topBar.classList.toggle('scrolled', scrolled);
      topBar.inert = false;
      pill.classList.remove('visible');
      pill.inert = true;
    } else {
      topBar.classList.remove('scrolled');
      topBar.classList.toggle('hidden', scrolled);
      topBar.inert = scrolled;
      pill.classList.toggle('visible', scrolled);
      pill.inert = !scrolled;
    }
  }

  // Sync class state with the scroll position established by the head script,
  // then remove data-scrolled so CSS transitions work normally from here on
  updateNav();
  requestAnimationFrame(() => {
    document.documentElement.removeAttribute('data-scrolled');
  });

  // Scroll fires far more often than the screen repaints; coalesce to one class
  // update per frame.
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(updateNav);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  // Crossing the breakpoint swaps which bar is in charge, so re-run then too
  mobileQuery.addEventListener('change', updateNav);

  // ---- Mobile hamburger ----
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  if (hamburgerBtn && mobileDrawer) {
    const setDrawer = (open: boolean, { restoreFocus = false } = {}) => {
      hamburgerBtn.setAttribute('aria-expanded', String(open));
      hamburgerBtn.setAttribute('aria-label', (open ? hamburgerBtn.dataset.labelClose : hamburgerBtn.dataset.labelOpen) ?? '');
      hamburgerBtn.classList.toggle('open', open);
      mobileDrawer.classList.toggle('open', open);
      mobileDrawer.inert = !open;
      if (open) {
        mobileDrawer.querySelector<HTMLElement>('a, button')?.focus({ preventScroll: true });
      } else if (restoreFocus) {
        hamburgerBtn.focus();
      }
    };

    hamburgerBtn.addEventListener('click', () => {
      setDrawer(hamburgerBtn.getAttribute('aria-expanded') !== 'true');
    });
    mobileDrawer.querySelectorAll('.mobile-link:not(.mobile-dropdown-toggle), .mobile-sublink').forEach(link => {
      link.addEventListener('click', () => setDrawer(false));
    });

    // Escape closes the sheet and hands focus back to the button that opened it;
    // a tap outside closes it too
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileDrawer.classList.contains('open')) setDrawer(false, { restoreFocus: true });
    });
    document.addEventListener('pointerdown', (e) => {
      if (!mobileDrawer.classList.contains('open')) return;
      const target = e.target as Node;
      if (!mobileDrawer.contains(target) && !hamburgerBtn.contains(target)) setDrawer(false);
    });
  }

  // ---- Desktop dropdowns: Escape dismisses ----
  // The menus open on hover and on :focus-within. Escape hides an open one
  // without moving focus; leaving the item (pointer or focus) re-arms it.
  document.querySelectorAll<HTMLElement>('.nav-dropdown-wrapper, .pill-dropdown-wrapper').forEach((wrapper) => {
    wrapper.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      wrapper.classList.add('dismissed');
      wrapper.querySelector<HTMLElement>('.dropdown-toggle')?.focus();
    });
    const rearm = () => wrapper.classList.remove('dismissed');
    wrapper.addEventListener('mouseleave', rearm);
    wrapper.addEventListener('focusout', (e) => {
      if (!wrapper.contains(e.relatedTarget as Node | null)) rearm();
    });
  });

  // ---- Dropdown cards smooth scroll & Sub-page Navigation ----
  function initDropdownScroll() {
    const isHomepage = window.location.pathname === '/' || window.location.pathname === '/en/' || window.location.pathname.endsWith('/index.html') || window.location.pathname === '';

    // Fix other header anchor links when not on homepage
    if (!isHomepage) {
      const isEn = window.location.pathname.startsWith('/en');
      const prefix = isEn ? '/en' : '';
      const servicesPath = isEn ? '/services' : '/servicios';
      const contactPath = isEn ? '/contact' : '/contacto';
      document.querySelectorAll('a[href^="#"]:not([href="#"]):not(.skip-link)').forEach(link => {
        const href = link.getAttribute('href');
        if (href) {
          if (href === '#services') {
            link.setAttribute('href', servicesPath);
          } else if (href === '#contact') {
            link.setAttribute('href', contactPath);
          } else {
            link.setAttribute('href', prefix + '/' + href);
          }
        }
      });
    }

    // Mobile dropdown accordion toggle
    const mobileToggle = document.querySelector<HTMLElement>('.mobile-dropdown-toggle');
    const mobileWrapper = document.querySelector<HTMLElement>('.mobile-dropdown-wrapper');
    const mobileMenu = document.getElementById('mobile-services-menu');
    if (mobileToggle && mobileWrapper) {
      const newToggle = mobileToggle.cloneNode(true) as HTMLElement;
      mobileToggle.replaceWith(newToggle);
      // Collapsed sub-links are clipped to zero height but were still tabbable
      if (mobileMenu) mobileMenu.inert = !mobileWrapper.classList.contains('open');

      newToggle.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const open = mobileWrapper.classList.toggle('open');
        newToggle.setAttribute('aria-expanded', String(open));
        if (mobileMenu) mobileMenu.inert = !open;
      });
    }
  }

  initDropdownScroll();
  document.addEventListener('astro:after-swap', initDropdownScroll);
</script>