      padding: 0 1rem 0 1.25rem;
      transition: background-color 0.3s ease, box-shadow 0.3s ease;
    }

    /* Scrolled: the header turns into a glass bar with the iOS edge — a lit
       top line, a faint hairline below and the content softly blurred under it */
    .nav-top-bar.scrolled {
      background: linear-gradient(180deg, rgba(250, 249, 245, 0.72), rgba(240, 239, 234, 0.5));
      backdrop-filter: blur(22px) saturate(190%);
      -webkit-backdrop-filter: blur(22px) saturate(190%);
      box-shadow:
        inset 0 -0.5px 0 rgba(0, 0, 0, 0.1),
        inset 0 1px 0 rgba(255, 255, 255, 0.8),
        0 8px 24px -12px rgba(0, 0, 0, 0.12);
