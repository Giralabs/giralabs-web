---
// Small looping UI scenes that illustrate each service. Each one shows the
// work, not just its result: the app is coded and assembled before it ships,
// the page is laid out before it scores, paper turns into a digital process,
// separate tools get wired into one panel. Purely decorative: the card around
// them already says what the service is, so the whole scene is hidden from
// assistive tech. Loops animate transform, opacity or a stroke only, and
// reduced motion shows the finished state of each scene.
interface Props {
  kind: 'apps' | 'web' | 'digital' | 'store' | 'software' | 'ai';
  lang?: string;
  theme?: 'dark' | 'light';
  /** The services page has room for a bigger scene than the home cards. */
  scale?: number;
}

const { kind, lang = 'es', theme = 'light', scale = 1 } = Astro.props;

const copy = {
  es: {
    ios: 'iOS',
    android: 'Android',
    url: 'tuempresa.es',
    score: 'Rendimiento',
    paper: 'En papel',
    today: 'Ahora, automático',
    tasks: ['Factura enviada', 'Stock actualizado', 'Informe semanal listo'],
    product: 'Zapatillas Run',
    price: '49 €',
    add: 'Añadir',
    paid: 'Pago completado',
    modules: ['Clientes', 'Pedidos', 'Facturas'],
    panel: 'Tu panel',
    growth: '+24%',
    ask: '¿Qué citas tengo mañana?',
    answer: 'Tres. La primera es a las 10:00 con Marta.',
  },
  en: {
    ios: 'iOS',
    android: 'Android',
    url: 'yourcompany.com',
    score: 'Performance',
    paper: 'On paper',
    today: 'Now, automatic',
    tasks: ['Invoice sent', 'Stock updated', 'Weekly report ready'],
    product: 'Run sneakers',
    price: '€49',
    add: 'Add',
    paid: 'Payment complete',
    modules: ['Clients', 'Orders', 'Invoices'],
    panel: 'Your panel',
    growth: '+24%',
    ask: 'What bookings do I have tomorrow?',
    answer: 'Three. The first is at 10:00 with Marta.',
  },
}[lang === 'en' ? 'en' : 'es'];

const check = 'M5 12.5l4.2 4.2L19 7';
---

<div class={`sv sv--${theme} sv-${kind}`} style={`--sv-scale: ${scale}`} aria-hidden="true">
  {kind === 'apps' && (
    <div class="sv-stage">
      <!-- 1. The code is written -->
      <div class="sv-code sv-glass">
        <span class="sv-code-head">main.dart</span>
        <i style="--d:0; --w:78%"></i>
        <i class="sv-code-accent" style="--d:1; --w:56%"></i>
        <i style="--d:2; --w:68%"></i>
        <i style="--d:3; --w:44%"></i>
      </div>
      <!-- 2. The app assembles on the phone, wireframe first -->
      <div class="sv-device">
        <div class="sv-device-screen">
          <span class="sv-device-island"></span>
          <span class="sv-b sv-b--title" style="--d:0"></span>
          <span class="sv-b sv-b--hero" style="--d:1"></span>
          <span class="sv-b sv-b--row" style="--d:2"></span>
          <span class="sv-b sv-b--row sv-b--row2" style="--d:3"></span>
          <span class="sv-b sv-b--btn" style="--d:4"></span>
        </div>
      </div>
      <!-- 3. It ships on both stores -->
      <div class="sv-stores">
        <span class="sv-store-pill sv-glass" style="--d:0">
          <svg viewBox="0 0 24 24" width="10" height="10"><path d={check} pathLength="100" /></svg>{copy.ios}
        </span>
        <span class="sv-store-pill sv-glass" style="--d:1">
          <svg viewBox="0 0 24 24" width="10" height="10"><path d={check} pathLength="100" /></svg>{copy.android}
        </span>
      </div>
    </div>
  )}

  {kind === 'web' && (
    <div class="sv-stage">
      <div class="sv-browser sv-glass">
        <div class="sv-browser-bar">
          <span class="sv-dots"><i></i><i></i><i></i></span>
          <span class="sv-url">{copy.url}</span>
        </div>
        <div class="sv-page">
          <span class="sv-b sv-b--nav" style="--d:0"></span>
          <span class="sv-b sv-b--h1" style="--d:1"></span>
          <span class="sv-b sv-b--sub" style="--d:2"></span>
          <span class="sv-b sv-b--cta" style="--d:3"></span>
          <span class="sv-b sv-b--img" style="--d:2"></span>
          <span class="sv-b sv-b--col sv-b--col1" style="--d:4"></span>
          <span class="sv-b sv-b--col sv-b--col2" style="--d:5"></span>
          <span class="sv-b sv-b--col sv-b--col3" style="--d:6"></span>
        </div>
      </div>
      <div class="sv-score-chip sv-glass">
        <span class="sv-gauge">
          <svg viewBox="0 0 64 64" width="30" height="30">
            <circle class="sv-gauge-track" cx="32" cy="32" r="26" />
            <circle class="sv-gauge-fill" cx="32" cy="32" r="26" pathLength="100" />
          </svg>
          <span class="sv-score"></span>
        </span>
        <span class="sv-score-label">{copy.score}</span>
      </div>
    </div>
  )}

  {kind === 'digital' && (
    <div class="sv-stage">
      <!-- The notebook the business runs on today... -->
      <div class="sv-paper">
        <span class="sv-paper-label">{copy.paper}</span>
        <i style="--w:84%"></i><i style="--w:62%"></i><i style="--w:74%"></i><i style="--w:50%"></i><i style="--w:68%"></i>
      </div>
      <!-- ...becomes a process that runs by itself -->
      <div class="sv-list sv-glass">
        <span class="sv-list-head">{copy.today}</span>
        {copy.tasks.map((task, i) => (
          <span class="sv-task" style={`--d:${i}`}>
            <span class="sv-check">
              <svg viewBox="0 0 24 24" width="11" height="11"><path d={check} pathLength="100" /></svg>
            </span>
            {task}
          </span>
        ))}
      </div>
    </div>
  )}

  {kind === 'store' && (
    <div class="sv-shop sv-glass">
      <span class="sv-product-img">
        <svg viewBox="0 0 24 24" width="34" height="34"><path d="M6 8h12l-1 12H7L6 8z" /><path d="M9 8V6.5a3 3 0 0 1 6 0V8" /></svg>
      </span>
      <span class="sv-product-row">
        <span class="sv-product-text">
          <strong>{copy.product}</strong>
          <span>{copy.price}</span>
        </span>
        <span class="sv-add">{copy.add}</span>
      </span>
      <div class="sv-sheet sv-glass">
        <span class="sv-paid-icon">
          <svg viewBox="0 0 24 24" width="14" height="14"><path d={check} pathLength="100" /></svg>
        </span>
        <span class="sv-product-text">
          <strong>{copy.paid}</strong>
          <span>{copy.price}</span>
        </span>
      </div>
    </div>
  )}

  {kind === 'software' && (
    <div class="sv-stage">
      <!-- Separate tools... -->
      <div class="sv-modules">
        {copy.modules.map((m, i) => (
          <span class="sv-module sv-glass" style={`--d:${i}`}>{m}</span>
        ))}
      </div>
      <!-- ...wired into one panel -->
      <svg class="sv-wires" viewBox="0 0 240 164" preserveAspectRatio="none">
        <path style="--d:0" d="M86 34 C 104 34, 104 60, 122 60" pathLength="100" />
        <path style="--d:1" d="M86 82 C 104 82, 104 82, 122 82" pathLength="100" />
        <path style="--d:2" d="M86 130 C 104 130, 104 104, 122 104" pathLength="100" />
      </svg>
      <div class="sv-panel sv-glass">
        <span class="sv-panel-head">
          <span>{copy.panel}</span>
          <strong class="sv-growth">{copy.growth}</strong>
        </span>
        <svg class="sv-chart" viewBox="0 0 200 80" preserveAspectRatio="none">
          <path class="sv-area" d="M0 62 C 22 60, 30 48, 50 50 S 82 58, 100 40 S 136 34, 150 26 S 182 14, 200 8 L 200 80 L 0 80 Z" />
          <path class="sv-line" d="M0 62 C 22 60, 30 48, 50 50 S 82 58, 100 40 S 136 34, 150 26 S 182 14, 200 8" pathLength="100" />
        </svg>
        <span class="sv-panel-rows"><i></i><i></i></span>
      </div>
    </div>
  )}

  {kind === 'ai' && (
    <div class="sv-chat">
      <span class="sv-bubble sv-bubble--me">{copy.ask}</span>
      <span class="sv-typing sv-glass"><i></i><i></i><i></i></span>
      <span class="sv-bubble sv-bubble--bot sv-glass">{copy.answer}</span>
    </div>
  )}
</div>

<style>
  .sv {
    --sv-ease-spring: cubic-bezier(0.34, 1.4, 0.64, 1);
    --sv-loop: 8s;
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-family: inherit;
    letter-spacing: -0.01em;
    color: var(--sv-fg);
    pointer-events: none;
    user-select: none;
  }

  /* Every scene is drawn at the size of the home cards; bigger slots scale it */
  .sv > * {
    transform: scale(var(--sv-scale, 1));
  }

  .sv--dark {
    --sv-fg: rgba(255, 255, 255, 0.94);
    --sv-fg-2: rgba(255, 255, 255, 0.55);
    --sv-fg-3: rgba(255, 255, 255, 0.14);
    --sv-wire: rgba(255, 255, 255, 0.32);
    --sv-glass: linear-gradient(180deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.05));
    --sv-rim: inset 0 1px 0.5px rgba(255, 255, 255, 0.25), inset 0 0 0 0.5px rgba(255, 255, 255, 0.12);
    --sv-shadow: 0 14px 32px rgba(0, 0, 0, 0.55);
    --sv-ok: #30d158;
    --sv-accent: #8fdcb2;
    --sv-solid: #26272b;
    --sv-me-bg: #f2f1ec;
    --sv-me-fg: #0a0a0a;
    --sv-page: rgba(255, 255, 255, 0.06);
  }

  .sv--light {
    --sv-fg: #0d0d0f;
    --sv-fg-2: rgba(0, 0, 0, 0.52);
    --sv-fg-3: rgba(0, 0, 0, 0.09);
    --sv-wire: rgba(0, 0, 0, 0.3);
    --sv-glass: linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.7));
    --sv-rim: inset 0 1px 0.5px #fff, inset 0 0 0 0.5px rgba(0, 0, 0, 0.08);
    --sv-shadow: 0 14px 34px rgba(0, 0, 0, 0.1), 0 2px 6px rgba(0, 0, 0, 0.04);
    --sv-ok: #1f8a3c;
    --sv-accent: #3f8c66;
    --sv-solid: #fff;
    --sv-me-bg: #111113;
    --sv-me-fg: #fff;
    --sv-page: rgba(0, 0, 0, 0.025);
  }

  .sv-glass {
    background: var(--sv-glass);
    box-shadow: var(--sv-rim), var(--sv-shadow);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    backdrop-filter: blur(14px) saturate(160%);
  }

  /* All the multi-part scenes share one 240x164 stage */
  .sv-stage {
    position: relative;
    width: 240px;
    height: 164px;
    flex: none;
  }

  /* ---------- Building blocks: dashed wireframe first, then the real thing ----------
     Each block is drawn as an outline (svWire) and filled a beat later
     (svFill), staggered by --d. The fill covers the outline exactly. */
  .sv-b {
    position: absolute;
    border-radius: 5px;
    border: 1px dashed var(--sv-wire);
    animation: svWire var(--sv-loop) ease-out infinite;
    animation-delay: calc(var(--d, 0) * 0.16s);
  }
  .sv-b::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: var(--sv-fill, var(--sv-fg-3));
    opacity: 0;
    animation: svFill var(--sv-loop) ease-out infinite;
    animation-delay: calc(var(--d, 0) * 0.16s);
  }
  @keyframes svWire {
    0%, 6% { opacity: 0; transform: scale(0.92); }
    12%, 88% { opacity: 1; transform: none; }
    95%, 100% { opacity: 0; transform: none; }
  }
  @keyframes svFill {
    0%, 34% { opacity: 0; }
    42%, 88% { opacity: 1; }
    95%, 100% { opacity: 0; }
  }

  /* ---------- Apps: write the code, assemble the app, ship it ---------- */
  .sv-code {
    position: absolute;
    left: 0;
    top: 14px;
    width: 98px;
    padding: 9px 10px 11px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .sv-code-head {
    font-size: 8px;
    font-weight: 600;
    color: var(--sv-fg-2);
    margin-bottom: 1px;
  }
  .sv-code i {
    display: block;
    width: var(--w);
    height: 5px;
    border-radius: 3px;
    background: var(--sv-fg-3);
    transform-origin: left;
    animation: svType var(--sv-loop) steps(6, end) infinite;
    animation-delay: calc(var(--d) * 0.28s);
  }
  .sv-code i.sv-code-accent { background: var(--sv-accent); opacity: 0.8; }
  @keyframes svType {
    0%, 2% { transform: scaleX(0); }
    14%, 90% { transform: none; }
    96%, 100% { transform: scaleX(0); }
  }

  .sv-device {
    position: absolute;
    left: 120px;
    top: 4px;
    width: 104px;
    height: 196px; /* runs off the bottom of the stage */
    padding: 4px;
    border-radius: 22px;
    background: #141518;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.14),
      0 18px 36px rgba(0, 0, 0, 0.3);
    -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent 84%);
    mask-image: linear-gradient(180deg, #000 70%, transparent 84%);
  }
  .sv-device-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 18px;
    background: #f4f5f2;
    --sv-wire: rgba(0, 0, 0, 0.28);
  }
  .sv-device-island {
    position: absolute;
    top: 6px;
    left: 50%;
    width: 28px;
    height: 7px;
    margin-left: -14px;
    border-radius: 5px;
    background: #000;
  }
  .sv-b--title { left: 9px; top: 22px; width: 52%; height: 7px; --sv-fill: #1d1f22; }
  .sv-b--hero {
    left: 9px; right: 9px; top: 36px; height: 40px; border-radius: 8px;
    --sv-fill: linear-gradient(140deg, #bfe9d1, #6cc596);
  }
  .sv-b--row { left: 9px; right: 9px; top: 84px; height: 15px; --sv-fill: #fff; }
  .sv-b--row2 { top: 104px; }
  .sv-b--btn { left: 9px; right: 30px; top: 126px; height: 15px; border-radius: 8px; --sv-fill: #1d1f22; }

  .sv-stores {
    position: absolute;
    left: 0;
    top: 104px;
    display: flex;
    gap: 6px;
  }
  .sv-store-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 10px 6px 8px;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 600;
    animation: svPop var(--sv-loop) var(--sv-ease-spring) infinite;
    animation-delay: calc(var(--d) * 0.18s);
  }
  .sv-store-pill svg path,
  .sv-check path,
  .sv-paid-icon path {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }
  .sv-store-pill svg path { stroke: var(--sv-ok); }
  @keyframes svPop {
    0%, 58% { opacity: 0; transform: translateY(8px) scale(0.85); }
    66%, 88% { opacity: 1; transform: none; }
    95%, 100% { opacity: 0; transform: none; }
  }

  /* ---------- Web: lay the page out, fill it, it scores 100 ---------- */
  @property --sv-n {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }
  .sv-browser {
    position: absolute;
    left: 0;
    top: 0;
    width: 228px;
    border-radius: 14px;
    overflow: hidden;
  }
  .sv-browser-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-bottom: 0.5px solid var(--sv-fg-3);
  }
  .sv-dots { display: flex; gap: 4px; }
  .sv-dots i { width: 6px; height: 6px; border-radius: 50%; background: var(--sv-fg-3); }
  .sv-url {
    flex: 1;
    padding: 3px 8px;
    border-radius: 7px;
    background: var(--sv-fg-3);
    font-size: 8px;
    color: var(--sv-fg-2);
    text-align: center;
  }
  .sv-page {
    position: relative;
    height: 118px;
    background: var(--sv-page);
  }
  .sv-b--nav { left: 12px; top: 10px; width: 46px; height: 6px; --sv-fill: var(--sv-fg-2); }
  .sv-b--h1 { left: 12px; top: 26px; width: 92px; height: 11px; --sv-fill: var(--sv-fg); }
  .sv-b--sub { left: 12px; top: 43px; width: 70px; height: 6px; --sv-fill: var(--sv-fg-2); }
  .sv-b--cta { left: 12px; top: 56px; width: 46px; height: 13px; border-radius: 7px; --sv-fill: var(--sv-accent); }
  .sv-b--img {
    right: 12px; top: 22px; width: 86px; height: 50px; border-radius: 8px;
    --sv-fill: linear-gradient(140deg, rgba(143, 220, 178, 0.6), rgba(63, 140, 102, 0.45));
  }
  .sv-b--col { top: 82px; width: 62px; height: 24px; border-radius: 7px; --sv-fill: var(--sv-fg-3); }
  .sv-b--col1 { left: 12px; }
  .sv-b--col2 { left: 83px; }
  .sv-b--col3 { left: 154px; }

  .sv-score-chip {
    position: absolute;
    right: -10px;
    bottom: -14px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 6px;
    border-radius: 999px;
    animation: svPop var(--sv-loop) var(--sv-ease-spring) infinite;
  }
  .sv-gauge { position: relative; width: 30px; height: 30px; flex: none; }
  .sv-gauge svg { transform: rotate(-90deg); }
  .sv-gauge circle { fill: none; stroke-width: 7; }
  .sv-gauge-track { stroke: var(--sv-fg-3); }
  .sv-gauge-fill {
    stroke: var(--sv-ok);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
    animation: svGauge var(--sv-loop) cubic-bezier(0.3, 0.7, 0.2, 1) infinite;
  }
  .sv-score {
    --sv-n: 100;
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 9px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--sv-ok);
    counter-reset: sv-n var(--sv-n);
    animation: svCount var(--sv-loop) cubic-bezier(0.3, 0.7, 0.2, 1) infinite;
  }
  .sv-score::after { content: counter(sv-n); }
  .sv-score-label { font-size: 9px; font-weight: 600; }
  @keyframes svGauge {
    0%, 62% { stroke-dashoffset: 100; }
    78%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes svCount {
    0%, 62% { --sv-n: 0; }
    78%, 100% { --sv-n: 100; }
  }

  /* ---------- Digitalisation: the notebook becomes a process ---------- */
  .sv-paper {
    position: absolute;
    left: 6px;
    top: 22px;
    width: 92px;
    height: 112px;
    padding: 10px 11px;
    border-radius: 4px;
    background: #fbf8ef;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16), inset 0 0 0 0.5px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 9px;
    transform: rotate(-6deg);
    animation: svPaper var(--sv-loop) cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }
  .sv-paper-label {
    font-size: 8px;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.45);
  }
  .sv-paper i {
    display: block;
    width: var(--w);
    height: 2px;
    border-radius: 2px;
    background: rgba(40, 60, 120, 0.45);
  }
  @keyframes svPaper {
    0%, 4% { opacity: 0; transform: rotate(-6deg) translateY(8px); }
    10%, 28% { opacity: 1; transform: rotate(-6deg); }
    40%, 100% { opacity: 0; transform: rotate(0deg) translateX(70px) scale(0.6); }
  }

  .sv-list {
    position: absolute;
    right: 0;
    top: 20px;
    width: 152px;
    padding: 11px 12px 5px;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    animation: svListIn var(--sv-loop) var(--sv-ease-spring) infinite;
  }
  .sv-list-head {
    font-size: 8.5px;
    font-weight: 600;
    color: var(--sv-fg-2);
    margin-bottom: 3px;
  }
  .sv-task {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 0;
    font-size: 10px;
    font-weight: 500;
    white-space: nowrap;
  }
  .sv-task + .sv-task { border-top: 0.5px solid var(--sv-fg-3); }
  .sv-check {
    flex: none;
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--sv-fg-3);
    animation: svCheck var(--sv-loop) var(--sv-ease-spring) infinite;
    animation-delay: calc(var(--d) * 0.45s);
  }
  .sv-check path {
    stroke: #fff;
    animation: svTick var(--sv-loop) ease-out infinite;
    animation-delay: calc(var(--d) * 0.45s);
  }
  @keyframes svListIn {
    0%, 30% { opacity: 0; transform: translateX(-16px) scale(0.94); }
    40%, 90% { opacity: 1; transform: none; }
    97%, 100% { opacity: 0; transform: none; }
  }
  @keyframes svCheck {
    0%, 46% { background-color: transparent; transform: scale(1); }
    50% { background-color: var(--sv-ok); transform: scale(1.18); }
    54%, 90% { background-color: var(--sv-ok); transform: scale(1); }
    97%, 100% { background-color: transparent; transform: scale(1); }
  }
  @keyframes svTick {
    0%, 48% { stroke-dashoffset: 100; }
    56%, 100% { stroke-dashoffset: 0; }
  }

  /* ---------- Custom software: separate tools wired into one panel ---------- */
  .sv-modules {
    position: absolute;
    left: 0;
    top: 22px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .sv-module {
    width: 86px;
    padding: 6px 10px;
    border-radius: 9px;
    font-size: 9px;
    font-weight: 600;
    animation: svModule var(--sv-loop) var(--sv-ease-spring) infinite;
